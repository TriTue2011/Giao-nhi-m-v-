+    def _tao(chung_chi):
+        cfg = {"crt": chung_chi["crt"], "key": chung_chi["key"], "da_nhan": []}
+        srv = MayChuTlsTran(("127.0.0.1", 0), _XuLyTlsTran)
+        srv.cfg = cfg
+        t = threading.Thread(target=srv.serve_forever, kwargs={"poll_interval": 0.05},
+                             daemon=True)
+        t.start()
+        created.append(srv)
+        return srv, cfg
+
+    yield _tao
+    for srv in created:
+        srv.shutdown()
+        srv.server_close()
