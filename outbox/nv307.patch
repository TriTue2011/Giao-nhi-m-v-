index 0000000..cf39293
--- /dev/null
+++ b/tests/test_nv307_tron_tin.py
@@ -0,0 +1,362 @@
+"""NV307 — phát nhạc và TTS trên CÙNG MỘT ĐƯỜNG: trộn tin báo vào luồng nhạc AirPlay trong tích hợp.
+
+Một phiên RAOP duy nhất: nhạc đang phát qua AirPlay thì tin báo được giải mã
+thành luồng PCM thứ hai (một tiến trình ffmpeg thêm) rồi CỘNG vào luồng PCM
+đang gửi — nhạc tự hạ 12 dB bằng phần mềm (KHÔNG đổi âm lượng loa), không
+tạm dừng, không đổi URI, không next bài. Hết tin, nhạc về mức cũ mượt
+(ramp 150 ms). Tin lỗi không làm đứt nhạc.
+
+Hai tầng test:
+- Tầng trộn (không cần HA): cộng mẫu có kẹp biên độ, ramp lên/xuống,
+  nhạc liên tục không mất khúc nào, tin lỗi không đứt nhạc, hàng đợi có trần.
+- Tầng thực thể (renderer DLNA giả + RAOP giả + nguồn giả khúc NHỎ để bộ
+  trộn kịp trộn tin ngay trong lúc test — nguồn NV287 trả một khúc khổng lồ
+  nên _phat phải phát hết khúc đó mới kéo khúc kế): tin trộn thì không mở
+  phiên RAOP thứ hai, không đụng DLNA, không FLUSH/TEARDOWN phiên nhạc;
+  công tắc TẮT thì hành vi cũ không đổi; nhạc DLNA vẫn đi NV287 như cũ.
+CHƯA thử trên loa thật."""
+
+import array
+import asyncio
+
+import pytest
+from pytest_homeassistant_custom_component.common import MockConfigEntry
+
+from custom_components.r1_speaker import media_player as r1_mp
+from custom_components.r1_speaker import tron_tin as tt_mod
+from custom_components.r1_speaker.const import DOMAIN
+from custom_components.r1_speaker.tron_tin import TronTin, tron_khung
+
+from .test_nv287_giu_nhac import (LOA, MUSIC, TTS, cho, cho_state, dmr,  # noqa: F401
+                                  raop, them)
+
+KHUNG = 352  # khung/gói RAOP
+
+
+def pcm(gia_tri, so_khung):
+    """PCM16 LE stereo: mọi mẫu cùng một giá trị (đo gain/biên độ cho dễ)."""
+    return array.array("h", [gia_tri] * (so_khung * 2)).tobytes()
+
+
+def mau_dau(chunk, khung=1):
+    """Giá trị mẫu (kênh trái) của ``khung`` khung đầu tiên trong một khúc PCM."""
+    a = array.array("h")
+    a.frombytes(chunk[:khung * 4])
+    return list(a[::2])
+
+
+# ── Tầng trộn: hàm thuần ─────────────────────────────────────────────────────
+
+def test_tron_khung_cong_co_kep_bien_do():
+    nhac = pcm(20000, 10)
+    tin = pcm(20000, 10)
+    ra = tron_khung(nhac, tin, 1.0)
+    assert mau_dau(ra, 10) == [32767] * 10            # 20000 + 20000 = 40000 → kẹp 0 dBFS
+    ra = tron_khung(nhac, tin, 0.5)
+    assert mau_dau(ra, 10) == [30000] * 10             # 20000 × 0,5 + 20000
+    a = array.array("h")
+    a.frombytes(ra)
+    assert max(a) <= 32767 and min(a) >= -32768        # không mẫu nào vượt 0 dBFS
+
+
+def test_tron_khung_tin_ngan_hon_thi_duoi_chi_nhac_da_ha():
+    nhac = pcm(10000, 10)
+    tin = pcm(8000, 4)
+    ra = tron_khung(nhac, tin, 0.25)
+    assert mau_dau(ra, 10) == [10500] * 4 + [2500] * 6  # 4 khung có tin, 6 khung sau chỉ nhạc đã hạ
+
+
+def test_tron_khung_khong_tin_tra_nguyen_nhac_da_ha():
+    nhac = pcm(10000, 10)
+    assert tron_khung(nhac, None, 0.25) == pcm(2500, 10)
+    assert tron_khung(nhac, b"", 1.0) == nhac
+
+
+def test_tron_khung_bo_byte_le_cuoi():
+    nhac = pcm(10000, 2) + b"\x01\x02"                  # thừa 2 byte (nửa khung)
+    ra = tron_khung(nhac, None, 1.0)
+    assert ra == pcm(10000, 2)
+
+
+# ── Tầng trộn: bộ trộn bất đồng bộ ───────────────────────────────────────────
+
+async def _chay(tron, nhac_chunks, tin_chunks=None):
+    """Kéo bộ trộn: trả danh sách khúc ra. ``tin_chunks`` None = không chen tin."""
+    async def nhac_gen():
+        for c in nhac_chunks:
+            yield c
+
+    gen = tron.nguon(lambda: nhac_gen())
+    ra = []
+    ev = None
+    if tin_chunks is not None:
+        async def tin_gen():
+            for c in tin_chunks:
+                yield c
+
+        ra.append(await gen.__anext__())               # khúc nhạc đầu (chưa có tin): vẫn tính vào luồng ra
+        ev = await tron.chen_tin(lambda: tin_gen())
+        await asyncio.sleep(0)                         # cho bơm tin chạy, nạp hàng đợi
+    async for chunk in gen:
+        ra.append(chunk)
+    return ra, ev
+
+
+async def test_tron_nhac_lien_tuc_khong_mat_khuc_khi_co_tin():
+    tron = TronTin()
+    nhac = [pcm(10000, 20000) for _ in range(6)]
+    tin = [pcm(8000, 100)]
+    ra, ev = await _chay(tron, nhac, tin)
+    assert len(ra) == 6                                # đúng 6 khúc vào = 6 khúc ra, không mất/không thêm
+    assert mau_dau(ra[0], 1) == [10000]                 # trước tin: nhạc nguyên mức
+    assert mau_dau(ra[1], 1) == [18000]                 # khúc có tin: 10000 × 1,0 + 8000 ở khung đầu
+    assert mau_dau(ra[-1], 1) == [10000]                # sau tin: nhạc về mức cũ
+    assert ev is not None and ev.is_set()               # tin xong, watcher được báo
+
+
+async def test_tron_ramp_xuong_len_muot_khong_nhay():
+    tron = TronTin()
+    nhac = [pcm(10000, 20000), pcm(10000, 20000), pcm(10000, 20000)]
+    tin = [pcm(0, 20000)]                               # tin im lặng: chỉ đo gain nhạc
+    ra, ev = await _chay(tron, nhac, tin)
+    assert mau_dau(ra[0], 1) == [10000]                 # khúc trước tin: nhạc nguyên mức
+    g1 = mau_dau(ra[1], 20000)
+    assert g1[0] == 10000                               # khung đầu tiên có tin vẫn mức đầy đủ
+    assert g1[tt_mod.RAMP_KHUNG] == 2512                # hết ramp 150 ms: đúng -12 dB (10000 × 0,2512)
+    assert all(g1[i] >= g1[i + 1] for i in range(tt_mod.RAMP_KHUNG))   # giảm đơn điệu, không nhảy
+    g2 = mau_dau(ra[2], 20000)
+    assert g2[0] == 2512 and g2[tt_mod.RAMP_KHUNG] == 10000  # ramp về mức cũ rồi đứng yên
+    assert ev is not None and ev.is_set()
+
+
+async def test_tron_vao_ra_duoi_300_ms_o_muc_tron():
+    """Vào/ra tin ≤ ~300 ms ở mức bộ trộn: tin có mặt ngay trong khúc nhạc kế
+    (không đợi hết khúc) + ramp 150 ms → tối đa một khúc ffmpeg (~128 ms) + ramp."""
+    assert (tt_mod.RAMP_KHUNG + 5632) / 44100 <= 0.3    # ramp 150 ms + khúc ffmpeg 22528 byte
+    tron = TronTin()
+    nhac = [pcm(10000, 100), pcm(10000, 100)]
+    tin = [pcm(8000, 100)]
+    ra, _ = await _chay(tron, nhac, tin)
+    assert mau_dau(ra[1], 1) == [10000 + 8000]           # khúc kế đã có tin ở mức đầy đủ ngay khung đầu
+
+
+async def test_tron_tin_loi_khong_dut_nhac():
+    tron = TronTin()
+
+    async def nhac_gen():
+        for _ in range(3):
+            yield pcm(10000, 20000)
+
+    gen = tron.nguon(lambda: nhac_gen())
+    await gen.__anext__()
+
+    async def tin_loi():
+        yield pcm(8000, 10)
+        raise RuntimeError("ffmpeg giả lỗi")
+
+    ev = await tron.chen_tin(lambda: tin_loi())
+    await asyncio.sleep(0)
+    ra = [await gen.__anext__(), await gen.__anext__()]
+    await gen.aclose()
+    assert mau_dau(ra[-1], 1) == [10000]                 # nhạc về mức cũ, không mất khúc
+    assert ev is not None and ev.is_set()               # tin lỗi vẫn báo xong, không kẹt
+
+
+async def test_tron_tin_moi_thay_tin_cu_khong_chong():
+    tron = TronTin()
+
+    async def nhac_gen():
+        for _ in range(6):
+            yield pcm(10000, 100)
+
+    gen = tron.nguon(lambda: nhac_gen())
+    await gen.__anext__()
+
+    async def tin_cu():
+        for _ in range(10):
+            yield pcm(8000, 100)
+
+    async def tin_moi():
+        for _ in range(10):
+            yield pcm(-8000, 100)
+
+    ev_cu = await tron.chen_tin(lambda: tin_cu())
+    await asyncio.sleep(0)
+    await gen.__anext__()
+    ev_moi = await tron.chen_tin(lambda: tin_moi())
+    await asyncio.sleep(0)
+    ra = await gen.__anext__()
+    await gen.aclose()
+    assert ev_cu.is_set()                               # tin cũ bị thay thì watcher cũ cũng được báo
+    assert mau_dau(ra, 1)[0] < 10000                     # khúc này trộn tin MỚI (âm), không phải tin cũ
+    assert ev_moi is not None
+
+
+async def test_tron_hang_doi_co_tran_khong_ro_bo_nho():
+    tron = TronTin()
+
+    async def tin_dai():
+        for _ in range(200):
+            yield pcm(8000, 100)
+
+    async def nhac_gen():
+        yield pcm(10000, 100)
+
+    gen = tron.nguon(lambda: nhac_gen())
+    await gen.__anext__()
+    await tron.chen_tin(lambda: tin_dai())
+    await asyncio.sleep(0)
+    await asyncio.sleep(0)
+    assert tron._hang_doi.qsize() <= tt_mod.HANG_DOI_TOI_DA
+    await gen.aclose()
+    assert tron._bom is None or tron._bom.done()        # bơm đã dọn, không rò tác vụ
+
+
+async def test_tron_chen_tin_khi_chua_co_luong_tra_none():
+    tron = TronTin()
+
+    async def tin_gen():
+        yield pcm(8000, 100)
+
+    assert await tron.chen_tin(lambda: tin_gen()) is None
+
+
+async def test_tron_byte_le_duoc_giu_sang_khuc_sau():
+    tron = TronTin()
+    nhac = [pcm(10000, 2) + b"\x07\x08", pcm(20000, 2)]
+    ra, _ = await _chay(tron, nhac)
+    assert ra[0] == pcm(10000, 2)
+    a = array.array("h")
+    a.frombytes(ra[1])
+    assert list(a) == [7 + 8 * 256, 20000, 20000, 20000]  # 2 byte lẻ + khúc sau thành đúng 2 khung
+
+
+# ── Tầng thực thể: nguồn giả khúc nhỏ ────────────────────────────────────────
+
+class NguonNho:
+    """Như Nguon của NV287 nhưng trả từng khúc nhỏ (8 gói/khúc ≈ 64 ms) để
+    bộ trộn kịp trộn tin ngay trong lúc test, thay vì chờ hết khúc nhạc dài."""
+
+    def __init__(self):
+        self.goi: list[tuple[str, float]] = []
+        self.so_goi: dict[str, int] = {}
+        self.loi: set[str] = set()
+
+    def __call__(self, url, bat_dau=0.0, ffmpeg=None):
+        self.goi.append((url, bat_dau))
+
+        async def gen():
+            if url in self.loi:
+                raise RuntimeError("ffmpeg giả lỗi")
+            con = self.so_goi.get(url, 400)
+            while con > 0:
+                n = min(con, 8)
+                con -= n
+                yield array.array("h", [1] * (KHUNG * 2 * n)).tobytes()
+
+        return gen
+
+
+@pytest.fixture
+def nguon_nho(monkeypatch):
+    n = NguonNho()
+    monkeypatch.setattr(r1_mp, "tao_nguon", n)
+    return n
+
+
+def _player(hass):
+    return hass.data["entity_components"]["media_player"].get_entity(LOA)
+
+
+def _ghi_trang_thai(hass):
+    ds = []
+
+    def nghe(ev):
+        st = ev.data.get("new_state")
+        if st is not None and ev.data.get("entity_id") == LOA:
+            ds.append((st.state, st.attributes.get("idle_reason")))
+
+    hass.bus.async_listen("state_changed", nghe)
+    return ds
+
+
+async def _nhac_airplay(hass, r1, raop, nguon_nho, **tuy_chon):
+    nguon_nho.so_goi[MUSIC] = 4000                      # nhạc dài: không tự hết trong lúc test
+    nguon_nho.so_goi[TTS] = 40
+    e = await them(hass, r1, raop, "airplay", **tuy_chon)
+    await hass.services.async_call("media_player", "play_media", {
+        "entity_id": LOA, "media_content_id": MUSIC, "media_content_type": "music"}, blocking=True)
+    await cho_state(hass, "playing")
+    assert _player(hass)._duong == "airplay"
+    return e
+
+
+async def _phat_tin(hass):
+    await hass.services.async_call("media_player", "play_media", {
+        "entity_id": LOA, "media_content_id": TTS, "media_content_type": "music", "announce": True},
+        blocking=True)
+
+
+async def test_nhac_airplay_tin_tron_mot_duong_khong_dung_phien(hass, r1, dmr, raop, nguon_nho):
+    await _nhac_airplay(hass, r1, raop, nguon_nho, tron_tin_airplay=True, tts_song_song_airplay=True)
+    ds = _ghi_trang_thai(hass)
+    phuong_thuc_truoc = list(raop.phuong_thuc())
+    await _phat_tin(hass)
+    p = _player(hass)
+    await cho(hass, lambda: p.coordinator.talk.announce_seq >= 1)
+    await hass.async_block_till_done()
+    assert [u for u, _ in nguon_nho.goi] == [MUSIC, TTS]  # tin chỉ giải mã một lần để trộn, nhạc không phát lại
+    assert raop.phuong_thuc() == phuong_thuc_truoc         # MỘT phiên RAOP: không RECORD mới, không FLUSH/TEARDOWN
+    assert "FLUSH" not in raop.phuong_thuc() and "TEARDOWN" not in raop.phuong_thuc()
+    assert dmr.called("SetAVTransportURI") == []           # tin KHÔNG đi DLNA (thắng đường ngược NV303)
+    assert hass.states.get(LOA).state == "playing" and hass.states.get(LOA).attributes["duong_phat"] == "airplay"
+    assert all(s == "playing" and r is None for s, r in ds), ds   # không idle, không idle_reason
+
+
+async def test_tron_tat_thi_tin_di_duong_nguoc_nhu_nv303(hass, r1, dmr, raop, nguon_nho):
+    await _nhac_airplay(hass, r1, raop, nguon_nho, tts_song_song_airplay=True)  # tron mặc định TẮT
+    await _phat_tin(hass)
+    await cho(hass, lambda: dmr.transport_state == "PLAYING")
+    assert [a["CurrentURI"] for a in dmr.called("SetAVTransportURI")] == [TTS]
+    assert [u for u, _ in nguon_nho.goi] == [MUSIC]       # tin đi DLNA nên không giải mã qua AirPlay
+
+
+async def test_tron_bat_nhac_dlna_van_di_nv287_khong_tron(hass, r1, dmr, raop, nguon_nho):
+    nguon_nho.so_goi[TTS] = 20
+    await them(hass, r1, raop, "dlna", tron_tin_airplay=True, tts_song_song_airplay=True)
+    await hass.services.async_call("media_player", "play_media", {
+        "entity_id": LOA, "media_content_id": MUSIC, "media_content_type": "music"}, blocking=True)
+    await cho_state(hass, "playing")
+    await _phat_tin(hass)
+    await cho(hass, lambda: "RECORD" in raop.phuong_thuc())
+    assert [a["CurrentURI"] for a in dmr.called("SetAVTransportURI")] == [MUSIC]   # NV287: tin AirPlay song song
+    assert _player(hass)._tron is None                     # nhạc DLNA thì không có bộ trộn nào
+
+
+async def test_tron_tin_loi_nhac_khong_dut_khong_phat_lai(hass, r1, dmr, raop, nguon_nho):
+    nguon_nho.loi = {TTS}
+    await _nhac_airplay(hass, r1, raop, nguon_nho, tron_tin_airplay=True)
+    phuong_thuc_truoc = list(raop.phuong_thuc())
+    await _phat_tin(hass)
+    p = _player(hass)
+    await cho(hass, lambda: p.coordinator.talk.announce_seq >= 1)
+    await hass.async_block_till_done()
+    assert [u for u, _ in nguon_nho.goi] == [MUSIC, TTS]   # tin lỗi chỉ thử một lần, nhạc KHÔNG phát lại
+    assert raop.phuong_thuc() == phuong_thuc_truoc
+    assert dmr.called("SetAVTransportURI") == []
+    assert hass.states.get(LOA).state == "playing"
+
+
+async def test_cong_tac_tron_mac_dinh_tat_va_ghi_tuy_chon(hass, r1, raop, nguon_nho):
+    from homeassistant.helpers import entity_registry as er
+    e = await them(hass, r1, raop, "airplay")
+    kq = [x.entity_id for x in er.async_get(hass).entities.values()
+          if x.platform == DOMAIN and x.domain == "switch" and x.translation_key == "tron_tin"]
+    assert len(kq) == 1
+    sw = kq[0]
