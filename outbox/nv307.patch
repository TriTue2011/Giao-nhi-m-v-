new file mode 100644
index 0000000..c912d1e
--- /dev/null
+++ b/custom_components/r1_speaker/tron_tin.py
@@ -0,0 +1,266 @@
+"""NV307 — trộn tin báo (TTS) vào luồng nhạc AirPlay, TRONG tích hợp.
+
+Bối cảnh: nhạc qua AirPlay do chính tích hợp gửi (``airplay.py``: ffmpeg giải
+mã trên máy HA → PCM16 LE 44,1 kHz stereo → RAOP), nên tích hợp có thể trộn
+ngay ở mức PCM trước khi gói RTP: một phiên RAOP duy nhất, không tạm dừng
+nhạc, không đổi URI, không next bài — khác hẳn NV287 (tin đi phiên RAOP
+riêng + hạ âm lượng loa) và NV303 (tin đi DLNA ngược đường).
+
+Cách trộn (cộng PCM trong Python, KHÔNG dùng ``amix``/``sidechaincompress``
+của ffmpeg — xem báo cáo NV307: chatgpt2api không có tương đương, và trộn
+trong Python mới chen tin vào ĐÚNG luồng nhạc đang chạy mà không mở lại
+phiên; ffmpeg thứ hai chỉ giải mã tin, không trộn):
+- Nhạc hạ ``HA_DB`` dB bằng phần mềm (không đổi âm lượng loa) trong lúc tin
+  nói, rồi về mức cũ — cả hai chiều đều ramp tuyến tính ``RAMP_KHUNG``
+  khung (~150 ms) để không nghe «cụp» khi vào/ra tin.
+- Tin cộng ở mức đầy đủ; tổng kẹp trong [-32768, 32767] nên biên độ tổng
+  không bao giờ vượt 0 dBFS.
+- Tin được bơm nền vào hàng đợi có trần (``HANG_DOI_TOI_DA`` khúc): bộ trộn
+  chỉ lấy những gì đã có sẵn, KHÔNG BAO GIỜ chờ tin mà làm khựng nhạc —
+  tin chậm/chưa tới thì khúc đó chỉ có nhạc (đang hạ), tin lỗi thì nhạc
+  tiếp tục ở mức cũ. Vào/ra tin vì vậy ≤ một khúc ffmpeg (~128 ms) + ramp
+  150 ms ≈ 278 ms ở mức bộ trộn (chưa tính thời gian tổng hợp TTS,
+  ffmpeg mở nguồn, và bộ đệm ~2 giây của loa — những thứ này cũng đúng
+  với mọi đường AirPlay khác).
+
+Hợp đồng nguồn: giống ``airplay.tao_nguon`` — factory không tham số trả về
+async iterator PCM16 LE 44,1 kHz stereo. Bộ trộn là một factory như vậy
+(``tron.nguon(nhac_factory)``) nên ``PhienAirPlay`` dùng thẳng mà không
+đổi nhịp gửi gói của nó."""
+
+from __future__ import annotations
+
+import array
+import asyncio
+import contextlib
+import logging
+from collections.abc import AsyncIterator, Callable
+
+_LOGGER = logging.getLogger(__name__)
+
+SAMPLE_RATE = 44100
+#: Nhạc hạ ngần này dB trong lúc tin nói: đủ để lời rõ mà nhạc vẫn nghe nền.
+#: 12 dB ≈ hệ số biên độ 0,2512 (chuẩn ducking phát thanh thường dùng 10–15 dB).
+HA_DB = 12.0
+HE_SO_NHAC = 10.0 ** (-HA_DB / 20.0)
+#: Ramp vào/ra tin: 150 ms. Ngắn hơn thì nghe «cụp»; dài hơn thì tin vào chậm.
+RAMP_KHUNG = int(0.15 * SAMPLE_RATE)
+#: Trần hàng đợi tin: 32 khúc ffmpeg (~4 giây tiếng) ≈ 720 KB — bơm bị chặn
+#: khi đầy nên tin dài không phình bộ nhớ; nhạc không bao giờ chờ hàng đợi.
+HANG_DOI_TOI_DA = 32
+
+
+def _kep(v: float) -> int:
+    """Một mẫu về [-32768, 32767] (0 dBFS): kẹp cứng, không tràn số."""
+    return max(-32768, min(32767, int(round(v))))
+
+
+def tron_khung(nhac: bytes, tin: bytes | None, he_so_nhac: float) -> bytes:
+    """Cộng MỘT khúc nhạc với MỘT khúc tin (cùng độ dài hoặc tin ngắn hơn):
+    nhạc × ``he_so_nhac`` + tin ở mức đầy đủ, kẹp 0 dBFS. Khúc tin ngắn hơn
+    thì phần đuôi chỉ còn nhạc đã hạ. Byte lẻ cuối khúc (nửa khung) bị bỏ —
+    bên gọi (``TronTin``) giữ lại cho khúc sau nên ở đó không mất."""
+    khung = len(nhac) // 4
+    if khung == 0:
+        return b""
+    m = array.array("h")
+    m.frombytes(nhac[:khung * 4])
+    out = array.array("h", m)
+    if tin:
+        t = array.array("h")
+        t.frombytes(tin[:min(len(tin), khung * 4) // 2 * 2])
+        n = min(len(t), len(m))
+        for i in range(n):
+            out[i] = _kep(m[i] * he_so_nhac + t[i])
+        for i in range(n, len(m)):
+            out[i] = _kep(m[i] * he_so_nhac)
+    elif he_so_nhac != 1.0:
+        for i in range(len(m)):
+            out[i] = _kep(m[i] * he_so_nhac)
+    return out.tobytes()
+
+
+class TronTin:
+    """Bộ trộn gắn vào MỘT phiên nhạc AirPlay. ``nguon(nhac_factory)`` là
+    nguồn PCM mà ``PhienAirPlay`` kéo; ``chen_tin(tin_factory)`` chen một
+    tin vào luồng đang chạy và trả sự kiện báo khi tin xong (kể cả khi tin
+    lỗi hoặc bị tin mới thay — watcher nào cũng được báo, không kẹt)."""
+
+    def __init__(self) -> None:
+        self._hang_doi: asyncio.Queue[bytes] = asyncio.Queue(maxsize=HANG_DOI_TOI_DA)
+        self._dem_tin = bytearray()          # tin đã bơm nhưng chưa trộn
+        self._du = b""                       # byte lẻ cuối khúc nhạc, giữ sang khúc sau
+        self._he_so = 1.0                    # gain nhạc hiện tại
+        self._dich = 1.0                     # gain nhạc đang ramp tới
+        self._ramp_con = 0                   # số khung còn lại của ramp hiện tại
+        self._bom: asyncio.Task | None = None
+        self._tin_het = False                # bơm đã hết (hết tin hoặc lỗi)
+        self._kich_hoat = False              # đang có tin (hoặc đang ramp về mức cũ)
+        self._su_kien: asyncio.Event | None = None
+        self._dang_chay = False
+
+    @property
+    def dang_chay(self) -> bool:
+        """Luồng nhạc đang được kéo (bộ trộn còn sống để chen tin vào)."""
+        return self._dang_chay
+
+    @property
+    def tin_dang_phat(self) -> bool:
+        """Đang có tin trong luồng (kể cả đang ramp về mức cũ sau tin)."""
+        return self._kich_hoat
+
+    # ── nguồn nhạc (PhienAirPlay kéo) ───────────────────────────────────────
+
+    async def nguon(self, nhac_factory: Callable[[], AsyncIterator[bytes]]) -> AsyncIterator[bytes]:
+        """Async generator: nhạc đi qua, tin (nếu có) được trộn vào từng khúc.
+        Kết thúc/huỷ → dọn bơm tin, báo sự kiện tin (nếu còn) rồi đóng nguồn nhạc."""
+        self._dang_chay = True
+        nhac = None
+        try:
+            nhac = nhac_factory()
+            async for chunk in nhac:
+                yield self._tron_chunk(chunk)
+        finally:
+            self._dang_chay = False
+            await self._don_bom()
+            self._ket_thuc_tin()
+            aclose = getattr(nhac, "aclose", None) if nhac is not None else None
+            if aclose is not None:
+                with contextlib.suppress(Exception):
+                    await aclose()
+
+    # ── chen / huỷ tin (media_player gọi) ────────────────────────────────────
+
+    async def chen_tin(self, tin_factory: Callable[[], AsyncIterator[bytes]]) -> asyncio.Event | None:
+        """Chen một tin vào luồng đang chạy. Tin cũ (nếu có) bị thay: watcher
+        cũ được báo xong ngay. Chưa có luồng nhạc thì trả None (bên gọi về
+        đường tin thường)."""
+        if not self._dang_chay:
+            return None
+        await self._don_bom()
+        self._ket_thuc_tin()                 # tin cũ (nếu có) coi như xong: watcher cũ không kẹt
+        self._dem_tin.clear()
+        self._tin_het = False
+        self._kich_hoat = True
+        self._ramp_moi(HE_SO_NHAC)           # bắt đầu hạ nhạc (ramp 150 ms, không nhảy mức)
+        self._su_kien = asyncio.Event()
+        self._bom = asyncio.get_running_loop().create_task(self._bom_tin(tin_factory), name="r1 tron tin")
+        return self._su_kien
+
+    async def huy_tin(self) -> None:
+        """Huỷ tin đang chạy (hết hạn watcher / dừng): nhạc ramp về mức cũ
+        ở các khúc kế, watcher được báo khi mức đã về."""
+        await self._don_bom()
+        self._tin_het = True
+
+    # ── bơm tin nền ──────────────────────────────────────────────────────────
+
+    async def _bom_tin(self, tin_factory: Callable[[], AsyncIterator[bytes]]) -> None:
+        """Bơm PCM tin vào hàng đợi có trần. Lỗi (ffmpeg hỏng, nguồn chết)
+        KHÔNG ném lên nhạc: chỉ ghi nhật ký rồi đánh dấu hết tin — nhạc
+        tiếp tục ở mức cũ, đúng yêu cầu «tin lỗi không làm đứt nhạc»."""
+        tin = tin_factory()
+        try:
+            async for chunk in tin:
+                if chunk:
+                    await self._hang_doi.put(chunk)
+        except asyncio.CancelledError:
+            raise
+        except Exception as exc:  # noqa: BLE001 — mọi lỗi của nguồn tin đều chỉ làm tin im, không phá nhạc
+            _LOGGER.warning("tron_tin: nguồn tin lỗi (%s): nhạc phát tiếp", type(exc).__name__)
+        finally:
+            aclose = getattr(tin, "aclose", None)
+            if aclose is not None:
+                with contextlib.suppress(Exception):
+                    await aclose()
+            self._tin_het = True
+
+    async def _don_bom(self) -> None:
+        bom, self._bom = self._bom, None
+        if bom is not None and not bom.done():
+            bom.cancel()
+            with contextlib.suppress(asyncio.CancelledError, Exception):
+                await bom
+        while not self._hang_doi.empty():
+            self._hang_doi.get_nowait()
+
+    def _ket_thuc_tin(self) -> None:
+        ev, self._su_kien = self._su_kien, None
+        if ev is not None and not ev.is_set():
+            ev.set()
+
+    # ── trộn ──────────────────────────────────────────────────────────────────
+
+    def _ramp_moi(self, dich: float) -> None:
+        """Bắt đầu ramp tới ``dich`` (đủ 150 ms kể từ mức hiện tại). Đang ramp
+        cùng chiều thì giữ nguyên nhịp; đổi chiều thì ramp lại từ đầu."""
+        if self._dich != dich or self._ramp_con == 0:
+            self._dich, self._ramp_con = dich, RAMP_KHUNG
+
+    def _tron_chunk(self, chunk: bytes) -> bytes:
+        """Trộn MỘT khúc nhạc. Không có tin và nhạc đang ở mức đầy đủ thì
+        trả nguyên khúc (không copy, không tính toán) — các phiên AirPlay
+        không dùng trộn vì vậy không tốn thêm gì đáng kể."""
+        if self._du:
+            chunk = self._du + chunk
+        tong_khung = len(chunk) // 4
+        self._du = chunk[tong_khung * 4:]
+        if tong_khung == 0:
+            return b""
+        data = chunk[:tong_khung * 4]
+        if not self._kich_hoat and self._he_so == 1.0:
+            return data
+        while not self._hang_doi.empty():
+            self._dem_tin += self._hang_doi.get_nowait()
+        tin_khung = len(self._dem_tin) // 4
+        m = array.array("h")
+        m.frombytes(data)
+        out = array.array("h", m)            # phần còn lại giữ nguyên nhạc
+        t = array.array("h")
+        t.frombytes(self._dem_tin[:tin_khung * 4])
+        i = 0                                # khung đang xử lý
+        # A — còn tin: ramp xuống (nếu chưa hạ hẳn) rồi trộn ở mức đã hạ.
+        while i < tong_khung and i < tin_khung:
+            if self._he_so > HE_SO_NHAC:
+                n = min(tin_khung - i, tong_khung - i, self._ramp_con or RAMP_KHUNG)
+                for j in range(n):
+                    g = self._he_so
+                    out[2 * (i + j)] = _kep(m[2 * (i + j)] * g + t[2 * (i + j)])
+                    out[2 * (i + j) + 1] = _kep(m[2 * (i + j) + 1] * g + t[2 * (i + j) + 1])
+                    self._buoc_ramp()
+                i += n
+            else:
+                n = min(tin_khung - i, tong_khung - i)
+                for j in range(n):
+                    out[2 * (i + j)] = _kep(m[2 * (i + j)] * HE_SO_NHAC + t[2 * (i + j)])
+                    out[2 * (i + j) + 1] = _kep(m[2 * (i + j) + 1] * HE_SO_NHAC + t[2 * (i + j) + 1])
+                i += n
+        da_tron = min(tin_khung, tong_khung)
+        del self._dem_tin[:da_tron * 4]
+        # B — tin đã HẾT thật (bơm xong, không còn byte nào) thì ramp nhạc về
+        # mức cũ ngay trong khúc này. Tin chỉ cạn tạm thời (bơm còn chạy) thì
+        # KHÔNG ramp lên — nhạc giữ mức đã hạ cho tới khi tin tới tiếp, tránh
+        # nhấp nhô mức khi ffmpeg tin chậm.
+        if self._tin_het and not self._dem_tin and self._he_so < 1.0:
+            self._ramp_moi(1.0)
+            n = min(tong_khung - i, self._ramp_con or RAMP_KHUNG)
+            for j in range(n):
+                g = self._he_so
+                out[2 * (i + j)] = _kep(m[2 * (i + j)] * g)
+                out[2 * (i + j) + 1] = _kep(m[2 * (i + j) + 1] * g)
+                self._buoc_ramp()
+            i += n
+        # C — phần còn lại: nhạc ở mức hiện tại (đã về 1,0 thì chính là data gốc).
+        if self._tin_het and not self._dem_tin and self._hang_doi.empty() and self._he_so == 1.0:
+            self._kich_hoat = False
+            self._ket_thuc_tin()
+        return out.tobytes()
+
+    def _buoc_ramp(self) -> None:
+        """Một khung ramp: gain tiến về đích theo số khung còn lại; hết ramp
+        thì gắn đúng đích (tránh sai số float tích luỹ)."""
+        if self._ramp_con > 0:
+            self._he_so += (self._dich - self._he_so) / self._ramp_con
+            self._ramp_con -= 1
+            if self._ramp_con == 0:
+                self._he_so = self._dich
