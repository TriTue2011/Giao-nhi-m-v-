+def test_ve_luong_het_hieu_luc_khi_cuoc_ket_thuc_va_range():
+    mod = _module_da_cai(cho_phep_ha_goi_di="bat")
+    engine = FakeEngine()
+    mod._gan_engine(engine)
+    mod._gan_tts(FakeSynth(pcm=b"\x07" * 4800))
+    c = _cuoc_active(mod, engine, mode="tts", tts_text="xin chao")
+    ma, _, nd = asyncio.run(mod.tich_hop(
+        "audio/stream-url", "POST", {}, {"call_id": c["call_id"]}, "http://localhost"))
+    assert ma == 200 and "/m/telegram-user/api/stream/" in nd["stream_url"]
+    ve = nd["stream_url"].split("/m/telegram-user/api/stream/")[1].split("?")[0].split("/")[0]
+    ma, headers, nd_bytes = asyncio.run(mod.luong(ve, None, "GET"))
+    assert ma == 200 and nd_bytes == b"\x07" * 4800
+    ma, headers, nd_bytes = asyncio.run(mod.luong(ve, "bytes=0-9", "GET"))
+    assert ma == 206 and headers["Content-Range"] == "bytes 0-9/4800"
+    assert nd_bytes == b"\x07" * 10
+    assert asyncio.run(mod.luong("ve-khong-co", None, "GET")) == (404, {}, b"")
+    asyncio.run(mod.tich_hop(
+        "hangup_call", "POST", {}, {"call_id": c["call_id"]}, "http://localhost"))
+    assert asyncio.run(mod.luong(ve, None, "GET")) == (404, {}, b"")
