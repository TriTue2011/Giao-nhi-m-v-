+def _giai_ma_bytes(gia_tri):
+    """Bytes trong JSON TDLib: base64 str → bytes; bytes giữ nguyên.
+
+    TDLib JSON mã hóa trường bytes thành base64 (probe T0-B: data "AAAA" =
+    3 byte 0). Glue phải decode ở biên TDLib, không đưa str vào NTgCalls
+    (binding NTgCalls nhận bytes, không nhận str).
+    """
+    if gia_tri is None:
+        return None
+    if isinstance(gia_tri, (bytes, bytearray)):
+        return bytes(gia_tri)
+    if isinstance(gia_tri, str):
+        try:
+            return base64.b64decode(gia_tri, validate=True)
+        except (ValueError, base64.binascii.Error):
+            return gia_tri.encode("utf-8")
+    return None
+
