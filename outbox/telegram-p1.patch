+def _tach_range(khoang, tong: int):
+    """Parse header Range «bytes=a-b» → (start, end, 206) hoặc (None, None, 200).
+    Range không thỏa → (None, None, 416)."""
+    if not khoang or not isinstance(khoang, str):
+        return None, None, 200
+    m = re.match(r"^\s*bytes=(\d*)-(\d*)\s*$", khoang)
+    if not m:
+        return None, None, 200
+    a, b = m.group(1), m.group(2)
+    if a == "" and b == "":
+        return None, None, 200
+    if a == "":
+        n = int(b)
+        if n <= 0:
+            return None, None, 416
+        bat_dau = max(0, tong - n)
+        return bat_dau, tong - 1, 206
+    bat_dau = int(a)
+    ket_thuc = int(b) if b != "" else tong - 1
+    if bat_dau >= tong or ket_thuc < bat_dau:
+        return None, None, 416
+    return bat_dau, min(ket_thuc, tong - 1), 206
+
