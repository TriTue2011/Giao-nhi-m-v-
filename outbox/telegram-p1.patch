+        client = self._clients.get(c["account"])
+        if client is None or c.get("tdlib_call_id") is None:
+            return 0
+        dem = 0
+        for data in c.pop("bao_hieu_cho_tdlib", []):
+            try:
+                await client.gui_bao_hieu(c["tdlib_call_id"], bytes(data))
+                dem += 1
+            except Exception:
+                pass
+        return dem
