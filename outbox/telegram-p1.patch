+def glue_call_ready(ready: dict, engine, user_id, is_outgoing: bool) -> dict:
+    """Chuyển callStateReady (TDLib) thành lệnh cho engine NTgCalls.
+
+    Map T0-B (td_api.tl:7672 → NTgCalls 3.0.6):
+      servers → connect_p2p (RTCServer specs, wrapper thật mới đổi sang
+        đối tượng RTCServer; engine fake nhận spec dict để test được)
+      protocol.library_versions → versions; udp_p2p + allow_p2p → p2p_allowed
+      encryption_key → skip_exchange (TDLib đã thỏa thuận khóa, không tự DH)
+      custom_parameters → connect_p2p(custom_parameters) (str JSON, giữ nguyên)
+      emojis → trả về để hiển thị fingerprint (engine.get_emojis_fingerprint
+        là lệnh riêng, không gọi ở đây để glue giữ thuần túy)
+    Trả dict tham số đã dùng (để test + log, không chứa khóa).
+    """
+    ready = ready or {}
+    protocol = ready.get("protocol") or {}
+    specs = []
+    for srv in ready.get("servers") or []:
+        if not isinstance(srv, dict):
+            continue
+        loai = srv.get("type") or {}
+        kieu = loai.get("@type", "")
+        if kieu == "callServerTypeWebrtc":
+            specs.append({
+                "id": srv.get("id"),
+                "ipv4": srv.get("ip_address") or "",
+                "ipv6": srv.get("ipv6_address") or "",
+                "port": srv.get("port"),
+                "username": loai.get("username"),
+                "password": loai.get("password"),
+                "turn": bool(loai.get("supports_turn")),
+                "stun": bool(loai.get("supports_stun")),
+                "tcp": False,
+                "peer_tag": None,
+            })
+        else:  # callServerTypeTelegramReflector (mặc định)
+            specs.append({
+                "id": srv.get("id"),
+                "ipv4": srv.get("ip_address") or "",
+                "ipv6": srv.get("ipv6_address") or "",
+                "port": srv.get("port"),
+                "username": None,
+                "password": None,
+                "turn": False,
+                "stun": False,
+                "tcp": bool(loai.get("is_tcp")),
+                "peer_tag": _giai_ma_bytes(loai.get("peer_tag")),
+            })
+    versions = list(protocol.get("library_versions") or [])
+    p2p_allowed = bool(ready.get("allow_p2p")) and bool(protocol.get("udp_p2p"))
+    custom = ready.get("custom_parameters")
+    if custom is not None and not isinstance(custom, str):
+        custom = json.dumps(custom, ensure_ascii=False)
+    khoa = _giai_ma_bytes(ready.get("encryption_key"))
+    if khoa:
+        engine.bo_qua_trao_doi_khoa(user_id, khoa, bool(is_outgoing))
+    engine.ket_noi_p2p(user_id, specs, versions, p2p_allowed, custom)
