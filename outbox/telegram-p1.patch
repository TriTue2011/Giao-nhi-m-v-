+# ── TTS: Edge TTS mặc định, interface inject được ─────────────────────────
+class EdgeTtsSynthesizer:
+    """TTS mặc định bằng Edge TTS (giọng vi-VN-*, xem cấu hình module).
+
+    edge_tts nạp LƯỜI qua importlib để module vẫn nạp được khi máy chưa cài
+    gói (xem D-P1-2); thiếu gói → LoiTelegram MEDIA_ENGINE_ERROR 502, không
+    sập module. Không gọi mạng ở test vì test luôn inject fake synthesizer.
+    Audio trả về là bytes do Edge TTS sinh (mp3); decode về PCM_ENGINE là
+    việc T1 (xem TODO đầu file).
+    """
+
+    async def tong_hop(self, text, voice, rate):
+        try:
+            edge_tts = importlib.import_module("edge_tts")
+        except ImportError:
+            raise LoiTelegram("MEDIA_ENGINE_ERROR", 502) from None
+        comm = edge_tts.Communicate(text, voice, rate=rate)
+        chunks = []
+        async for chunk in comm.stream():
+            if chunk.get("type") == "audio":
+                chunks.append(chunk["data"])
+        return b"".join(chunks)
