+            key=lambda c: (0 if c.get("uu_tien") == "alarm" else 1,
+                           c.get("cho_tu_luc", 0)),
+        )
+        for c in sap:
+            dang_chay = any(
+                x["account"] == c["account"]
+                and x["trang_thai"] in ("dialing", "active")
+                and x["call_id"] != c["call_id"]
+                for x in self._cuoc_goi.values()
+            )
+            if dang_chay:
+                continue
+            ep = c.get("audio_endpoint")
+            if ep and ep in self._endpoint_dang_dung:
+                continue
