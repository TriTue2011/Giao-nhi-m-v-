+def test_audio_upload_rap_khoi_tra_id_va_xoa_sau_cuoc():
+    mod = _module_da_cai(cho_phep_ha_goi_di="bat")
+    engine = FakeEngine()
+    mod._gan_engine(engine)
+    asyncio.run(_dang_nhap_xong(mod))
+    k1 = base64.b64encode(b"phan-mot-").decode("ascii")
+    k2 = base64.b64encode(b"phan-hai").decode("ascii")
+    ma, _, nd = asyncio.run(mod.tich_hop(
+        "audio/upload", "POST", {}, {"khoi_b64": k1}, "http://localhost"))
+    assert ma == 200 and nd["upload_id"]
+    up = nd["upload_id"]
+    ma, _, nd = asyncio.run(mod.tich_hop(
+        "audio/upload", "POST", {}, {"upload_id": up, "khoi_b64": k2, "done": True},
+        "http://localhost"))
