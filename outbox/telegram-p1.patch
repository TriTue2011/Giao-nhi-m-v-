+def test_audio_in_mat_khoi_chen_im_lang_va_dem():
+    mod = _module_da_cai(cho_phep_ha_goi_di="bat")
+    engine = FakeEngine()
+    mod._gan_engine(engine)
+    c = _cuoc_active(mod, engine)
+    a = base64.b64encode(b"\x11" * 960).decode("ascii")
+    b = base64.b64encode(b"\x22" * 960).decode("ascii")
+    cc = base64.b64encode(b"\x33" * 960).decode("ascii")
+    for seq, khoi in ((0, a), (1, b), (3, cc)):
+        ma, _, nd = asyncio.run(mod.tich_hop(
+            "audio/in", "POST", {}, {"call_id": c["call_id"], "seq": seq,
+                                     "pcm_b64": khoi, "sample_rate": 48000,
+                                     "channels": 1}, "http://localhost"))
+        assert ma == 200
+    rec = mod._cuoc_goi[c["call_id"]]
+    assert rec["khoi_mat"] == 1 and rec["khoi_nhan"] == 3
+    # A + B + im lặng (dài bằng 1 khối) + C
+    assert bytes(rec["mic_pcm"]) == b"\x11" * 960 + b"\x22" * 960 + b"\x00" * 960 + b"\x33" * 960
+    # khối trùng: không đưa thêm vào luồng
+    truoc = len(rec["mic_pcm"])
+    ma, _, nd = asyncio.run(mod.tich_hop(
+        "audio/in", "POST", {}, {"call_id": c["call_id"], "seq": 1,
+                                 "pcm_b64": b, "sample_rate": 48000,
+                                 "channels": 1}, "http://localhost"))
+    assert ma == 200 and nd["trung"] is True
+    assert len(rec["mic_pcm"]) == truoc
+    # khối > 400 KB thân → 400
+    ma, _, nd = asyncio.run(mod.tich_hop(
+        "audio/in", "POST", {}, {"call_id": c["call_id"], "seq": 4,
+                                 "pcm_b64": "A" * 400_001, "sample_rate": 48000,
+                                 "channels": 1}, "http://localhost"))
+    assert ma == 400
