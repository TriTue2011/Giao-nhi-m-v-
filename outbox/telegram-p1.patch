+# ── Client TDLib thật (tdjson, binding nhận BYTES) ────────────────────────
+class KhachTdlib:
+    """Client TDLib qua tdjson 1.8.69 (phương án B).
+
+    Mọi request JSON đều encode sang bytes trước khi td_send (binding nhận
+    bytes, không nhận str — caveat T0-B). Trường bytes trong JSON TDLib là
+    base64 (xem _giai_ma_bytes/_ma_hoa_bytes). Vòng nhận dùng td_receive
+    trong thread (tránh chặn event loop); T1 phải kiểm chứng luồng này với
+    tài khoản phụ thật trước khi coi là chạy được.
+    """
+
+    def __init__(self, api_id, api_hash, thu_muc_files, khoa_hex):
+        self.api_id = int(api_id)
+        self.api_hash = api_hash
+        self.thu_muc_files = str(thu_muc_files)
+        self.khoa_hex = khoa_hex
+        self._client_id = None
+        self._tdjson = None
+
+    def _gui(self, req: dict):
+        # td_send nhận bytes: JSON-encode toàn bộ request.
+        self._tdjson.td_send(
+            self._client_id, json.dumps(req, ensure_ascii=False).encode("utf-8")
+        )
+
+    async def _cho_kieu(self, kieu_mong, timeout=30.0):
+        """Chờ update/request trả về có @type nằm trong kieu_mong."""
+        het = time.monotonic() + timeout
+        while time.monotonic() < het:
+            tho = await asyncio.to_thread(self._tdjson.td_receive, 0.5)
+            if not tho:
+                continue
+            try:
+                obj = json.loads(tho.decode("utf-8"))
+            except (ValueError, UnicodeDecodeError):
+                continue
+            if obj.get("@type") in kieu_mong:
+                return obj
+            if obj.get("@type") == "error":
+                raise LoiTelegram(
+                    str(obj.get("message", "TD_ERROR")), obj.get("code", 400)
+                )
+        raise LoiTelegram("TD_TIMEOUT", 502)
+
+    async def khoi_tao(self):
+        self._tdjson = _nap_tdjson()
+        self._client_id = self._tdjson.td_create_client_id()
+        await self._cho_kieu({"updateAuthorizationState"}, timeout=10.0)
+        self._gui({
+            "@type": "setTdlibParameters",
+            "parameters": {
+                "use_test_dc": False,
+                "database_directory": self.thu_muc_files,
+                "files_directory": self.thu_muc_files,
+                "use_file_database": True,
+                "use_chat_info_database": True,
+                "use_message_database": True,
+                "use_secret_chats": False,
+                "api_id": self.api_id,
+                "api_hash": self.api_hash,
+                "system_language_code": "vi",
+                "device_model": "web2api",
+                "system_version": "Linux",
+                "application_version": PHIEN_BAN,
+                "enable_storage_optimizer": True,
+                "ignore_background_updates": False,
+            },
+        })
+        if len(self.khoa_hex) == 64:
+            self._gui({
+                "@type": "setDatabaseEncryptionKey",
+                "encryption_key": _ma_hoa_bytes(bytes.fromhex(self.khoa_hex)),
+            })
+
+    async def _trang_thai_hien_tai(self, timeout=30.0):
+        obj = await self._cho_kieu({"updateAuthorizationState"}, timeout=timeout)
+        state = (obj.get("authorization_state") or {}).get("@type", "")
+        if state == "authorizationStateWaitPhoneNumber":
+            return "cho_so"
+        if state == "authorizationStateWaitCode":
+            return "cho_otp"
+        if state == "authorizationStateWaitPassword":
+            return "can_2fa"
+        if state == "authorizationStateWaitOtherDeviceConfirmation":
+            return "cho_qr"
+        if state == "authorizationStateReady":
+            return "da_dang_nhap"
+        return state
+
+    async def dat_so(self, phone):
+        self._gui({
+            "@type": "setPhoneNumber",
+            "phone_number": phone,
+            "settings": {"allow_flash_call": False, "allow_sms_receiver": False},
+        })
+        return await self._trang_thai_hien_tai()
+
+    async def kiem_tra_ma(self, code):
+        # code KHÔNG bao giờ vào log: chỉ truyền thẳng cho TDLib.
+        self._gui({"@type": "checkAuthenticationCode", "code": code})
+        try:
+            return await self._trang_thai_hien_tai()
+        except LoiTelegram as e:
+            if "PHONE_CODE_INVALID" in e.code or "CODE_INVALID" in e.code:
+                raise LoiTelegram("MA_SAI", 400) from None
+            if e.http_status == 429:
+                raise LoiTelegram("FLOOD_WAIT", 429, 60) from None
+            raise
+
+    async def kiem_tra_mat_khau(self, password):
+        self._gui({"@type": "checkAuthenticationPassword", "password": password})
+        try:
+            return await self._trang_thai_hien_tai()
+        except LoiTelegram as e:
+            if "PASSWORD_HASH_INVALID" in e.code:
+                raise LoiTelegram("MAT_KHAU_SAI", 400) from None
+            raise
+
+    async def lay_qr_link(self):
+        self._gui({"@type": "requestQrCodeAuthentication", "other_user_ids": []})
+        obj = await self._cho_kieu({"updateAuthorizationState"}, timeout=30.0)
+        state = obj.get("authorization_state") or {}
+        return state.get("link", "")
+
+    async def kiem_tra_qr(self):
+        return await self._trang_thai_hien_tai(timeout=10.0)
+
+    async def lay_thong_tin(self):
+        self._gui({"@type": "getMe"})
+        obj = await self._cho_kieu({"user"}, timeout=15.0)
+        ten = " ".join(
+            p for p in (obj.get("first_name", ""), obj.get("last_name", ""))
+            if p
+        )
+        return {"display_name": ten or obj.get("username", ""), "user_id": obj.get("id")}
+
+    async def tao_cuoc_goi(self, peer):
+        # Cần user_id đã phân giải từ peer (searchPublicChat/createPrivateChat
+        # qua vòng nhận update) — chưa triển khai ở P1/P2 offline; T1 kiểm
+        # chứng với tài khoản phụ. Test dùng fake client có cùng chữ ký.
+        raise NotImplementedError(
+            "tao_cuoc_goi thật cần phân giải peer → user_id, chờ T1."
+        )
+
+    async def huy_cuoc_goi(self, tdlib_call_id):
+        self._gui({"@type": "discardCall", "call_id": int(tdlib_call_id),
+                   "is_disconnected": False, "duration": 0, "is_video": False,
+                   "connection_id": 0})
+
+    async def gui_bao_hieu(self, tdlib_call_id, data_bytes):
+        """TDLib sendCallSignalingData: data là bytes (JSON base64 ở biên)."""
+        self._gui({
+            "@type": "sendCallSignalingData",
+            "call_id": int(tdlib_call_id),
+            "data": _ma_hoa_bytes(data_bytes),
+        })
+
+    async def gui_tin_nhan(self, peer, text):
+        raise NotImplementedError(
+            "gui_tin_nhan thật cần phân giải peer → chat_id, chờ T1."
+        )
+
+    async def gui_media(self, peer, data_bytes, filename, caption):
+        raise NotImplementedError("gui_media thật chờ T1 (như gui_tin_nhan).")
+
+    async def gui_voice(self, peer, data_bytes):
+        raise NotImplementedError("gui_voice thật chờ T1 (như gui_tin_nhan).")
+
+    async def dong(self):
+        if self._tdjson is not None and self._client_id is not None:
+            try:
+                self._gui({"@type": "close"})
+            except Exception:
+                pass
+        self._tdjson = None
+        self._client_id = None
