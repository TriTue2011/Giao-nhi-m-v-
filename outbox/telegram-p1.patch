+def test_webhook_retry_3_lan_va_header_token(monkeypatch):
+    mod = _module_da_cai(ha_webhook_url="http://ha-gia.invalid/webhook",
+                         ha_webhook_token=TOKEN_WH_GIA)
+    mod._webhook_backoff = [0, 0]
+    goi = []
+
+    class Resp:
+        status = 200
+
+        def __enter__(self):
+            return self
+
+        def __exit__(self, *a):
+            return False
+
+    def urlopen_gia(req, timeout=5):
+        goi.append(req)
+        if len(goi) < 3:
+            raise ConnectionError("gia-lap-hong")
+        return Resp()
+
+    monkeypatch.setattr("urllib.request.urlopen", urlopen_gia)
+    su_kien = mod._ghi_su_kien("message_new", "tk-gia", {"van_ban": "x"})
+    assert asyncio.run(mod._day_webhook(su_kien)) is True
+    assert len(goi) == 3
+    # urllib chuẩn hóa tên header về dạng capitalize khi đọc lại
+    assert goi[0].get_header("X-gateway-token") == TOKEN_WH_GIA
+    assert json.loads(goi[0].data.decode("utf-8"))["id"] == su_kien["id"]
+
