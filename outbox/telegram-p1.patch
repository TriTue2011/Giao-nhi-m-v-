+    tts_id = nd["tts_audio_id"]
+    tep = mod._tts_files[tts_id]["tep"]
+    assert tep.read_bytes() == b"phan-mot-phan-hai"
+    assert oct(tep.stat().st_mode & 0o777) == "0o600"
+    # khối > 300 KB → 400
+    ma, _, nd = asyncio.run(mod.tich_hop(
+        "audio/upload", "POST", {}, {"khoi_b64": "A" * 300_001}, "http://localhost"))
+    assert ma == 400
+    # gọi bằng tts_audio_id → ready đưa bytes file vào engine → cúp máy xóa file
+    _, _, c = _goi(mod, peer="p-gia", mode="tts", tts_audio_id=tts_id)
+    asyncio.run(mod._xu_ly_call_ready(c["call_id"], _fixture_ready()))
+    assert engine.pcm_out and engine.pcm_out[0][1] == b"phan-mot-phan-hai"
+    asyncio.run(mod.tich_hop(
+        "hangup_call", "POST", {}, {"call_id": c["call_id"]}, "http://localhost"))
+    assert tts_id not in mod._tts_files and not tep.exists()
