+    ma, _, nd = asyncio.run(mod.goi_tu_tab({"peer": "p-gia", "mode": "live"}))
+    assert ma == 200 and nd["status"] == "dialing"
+    asyncio.run(mod.tich_hop("hangup_call", "POST", {}, {"call_id": nd["call_id"]}, "http://localhost"))
+    # flood-wait từ Telegram: retry_after lấy từ fake, không bịa
+    fake.flood_gui_tin = True
+    ma, _, nd = asyncio.run(mod.tich_hop(
+        "send_message", "POST", {}, {"peer": "p", "message": "m"}, "http://localhost"))
+    assert ma == 429 and nd["error"]["code"] == "FLOOD_WAIT"
