+    async def _thang_hang_cuoc_goi(self):
+        """Thăng hạng lượt chờ đầu tiên đủ điều kiện → dialing.
+
+        Thứ tự: alarm trước, rồi FIFO theo thời gian chờ. Lượt được thăng hạng
