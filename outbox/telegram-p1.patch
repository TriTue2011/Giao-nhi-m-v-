+# ── Engine NTgCalls thật (wrapper mỏng, chữ ký đã xác minh ở T0) ──────────
+class NtGcallsThuc:
+    """Wrapper mỏng quanh ntgcalls.NTgCalls 3.0.6.
+
+    Chữ ký dùng ở đây đã xác minh bằng help() trên wheel thật:
+    connect_p2p(user_id, servers, versions, p2p_allowed, custom_parameters),
+    skip_exchange(user_id, encryption_key, is_outgoing),
+    send_signaling_data(chat_id, msg_key: bytes),
+    on_signaling_data(callback(chat_id, bytes)),
+    get_emojis_fingerprint(chat_id), set_stream_sources(chat_id, mode, media).
+    PCM TTS đưa vào bằng nguồn FILE (MediaSource.FILE); mic live qua EXTERNAL
+    vẫn chờ T1 (xem TODO đầu file).
+    """
+
+    def __init__(self):
+        self._ntg = None
+        self._mod = None
+
+    def _dam_bao(self):
+        if self._ntg is None:
+            self._mod = _nap_ntgcalls()
+            self._ntg = self._mod.NTgCalls()
+        return self._ntg
+
+    def _doi_servers(self, specs):
+        rtc = []
+        for s in specs:
+            rtc.append(self._mod.RTCServer(
+                int(s.get("id") or 0), s.get("ipv4") or "", s.get("ipv6") or "",
+                int(s.get("port") or 0), s.get("username"), s.get("password"),
+                bool(s.get("turn")), bool(s.get("stun")), bool(s.get("tcp")),
+                s.get("peer_tag"),
+            ))
+        return rtc
+
+    def ket_noi_p2p(self, user_id, specs, versions, p2p_allowed, custom):
+        ntg = self._dam_bao()
+        return ntg.connect_p2p(int(user_id), self._doi_servers(specs),
+                               list(versions), bool(p2p_allowed), custom)
+
+    def bo_qua_trao_doi_khoa(self, user_id, key_bytes, is_outgoing):
+        return self._dam_bao().skip_exchange(int(user_id), bytes(key_bytes),
+                                             bool(is_outgoing))
+
+    def gui_bao_hieu(self, user_id, data_bytes):
+        return self._dam_bao().send_signaling_data(int(user_id), bytes(data_bytes))
+
+    def dang_ky_nhan_bao_hieu(self, callback):
+        return self._dam_bao().on_signaling_data(callback)
+
+    def lay_dau_van_tay_emojis(self, user_id):
+        return self._dam_bao().get_emojis_fingerprint(int(user_id))
+
+    def nap_pcm_out(self, user_id, pcm_bytes, tep_tam):
+        """Đưa PCM TTS vào cuộc gọi bằng nguồn FILE (T1 kiểm chứng live)."""
+        ntg = self._dam_bao()
+        Path(tep_tam).write_bytes(bytes(pcm_bytes))
+        media = self._mod.MediaDescription(
+            self._mod.AudioDescription(
+                self._mod.MediaSource.FILE, PCM_ENGINE["sample_rate"],
+                PCM_ENGINE["channels"], str(tep_tam), False),
+            None, None, None)
+        return ntg.set_stream_sources(int(user_id), self._mod.StreamMode.PLAYBACK,
+                                      media)
+
+    def nap_pcm_mic(self, user_id, pcm_bytes):
+        raise NotImplementedError(
+            "Mic live qua nguồn EXTERNAL chờ T1 chốt cơ chế frame; "
+            "test dùng engine fake."
+        )
+
+    def dung(self, user_id):
+        if self._ntg is not None:
+            return self._ntg.stop(int(user_id))
+        return None
