+    assert ma == 200 and nd["events"] == [] and nd["cursor"] == cursor
+    # cúp máy đẩy event mới nhưng webhook hỏng → vẫn spool, không treo
+    _, _, c = _goi(mod, peer="p-gia", mode="live")
+    asyncio.run(mod.tich_hop(
+        "hangup_call", "POST", {}, {"call_id": c["call_id"]}, "http://localhost"))
+    ma, _, nd = asyncio.run(mod.tich_hop(
+        "events", "GET", {"since": str(cursor)}, None, "http://localhost"))
+    assert len(nd["events"]) == 1 and nd["events"][0]["type"] == "call_ended"
