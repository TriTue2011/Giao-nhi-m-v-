+                                      sess["zpw_enk"])
+        sig.ringring(thread_id, call_id)
+        STATE.calls.record_diag(
+            call_id, {"incoming_ringring_sent": True})
+        _log_call("ringring call_id=%s ok=True" % call_id)
+    except Exception as e:  # noqa: BLE001 - best-effort
