+# ── Route: lưu tài khoản chế độ google không cần mật khẩu ────────────────
+
+def test_route_luu_tai_khoan_google_khong_can_mat_khau(tmp_path, monkeypatch):
+    from fastapi.testclient import TestClient
+
+    from app.main import app
