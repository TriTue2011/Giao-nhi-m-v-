+            return False, "cookie moi hong sau khi thay (gia)", True
+        return _kiem_cookie_gia(cookies)
+
+    monkeypatch.setattr(mm.Module, "_kiem_cookie",
+                        staticmethod(_kiem_co_dem))
+    _gan_ho_so(mod, COOKIE_HET_HAN)
