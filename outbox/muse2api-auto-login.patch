+def test_t2_can_nguoi_roi_hoan_captcha_1800_giay(mod):
+    _gan_ho_so(mod, COOKIE_HET_HAN)
+    mod.nap({"cookies": [COOKIE_HET_HAN]})
+    khoa = mod._khoa_tu_cookies(COOKIE_HET_HAN)
