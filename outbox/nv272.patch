 modules/gemini-web/module.py                  |  8 ++-
 modules/grok-web/module.py                    |  8 ++-
 test/test_web2api_gemini-web.py               |  5 +-
 test/test_web2api_grok-web.py                 |  3 +-
 ...st_web2api_nv272_khoi_dong_khong_cookie.py | 65 +++++++++++++++++++
 6 files changed, 94 insertions(+), 7 deletions(-)
