diff --git a/tests/test_nv302_the.py b/tests/test_nv302_the.py
new file mode 100644
index 0000000..34dd3d2
--- /dev/null
+++ b/tests/test_nv302_the.py
@@ -0,0 +1,140 @@
+"""NV302 — thẻ «Cài đặt»: mục «Phát nhạc & tin báo» trong tab Âm thanh, tab mới
+«Khởi động lại», và điều khiển mới gọi đúng dịch vụ HA qua thực thể.
+
+Chạy mô hình bằng Node trên trạng thái thật của tích hợp (khuôn như
+``test_the_cai_dat.py``); không cần Chrome thật.
+"""
+
+import json
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+from homeassistant.helpers import entity_registry as er
+
+from .test_bo_dam import _them
+
+CARD = Path(__file__).parent.parent / "custom_components" / "r1_speaker" / "www" / "r1-settings-card.js"
+need_node = pytest.mark.skipif(shutil.which("node") is None, reason="cần Node để chạy mô hình thẻ")
+
+LICH_KHOA = ("switch.r1_lich_khoi_dong_lai", "switch.r1_tu_phuc_hoi_khi_treo",
+              "switch.r1_lich_thu_2", "switch.r1_lich_thu_3", "switch.r1_lich_thu_4",
+              "switch.r1_lich_thu_5", "switch.r1_lich_thu_6", "switch.r1_lich_thu_7",
+              "switch.r1_lich_chu_nhat", "time.r1_lich_gio", "binary_sensor.r1_loa_phan_hoi",
+              "sensor.r1_lan_khoi_dong_lai_cuoi", "button.r1_khoi_dong_lai")
+
+
+def _hass_gia(hass, bo=None):
+    reg = er.async_get(hass)
+    ents, states = {}, {}
+    for e in reg.entities.values():
+        if e.platform != "r1_speaker":
+            continue
+        ents[e.entity_id] = {"entity_id": e.entity_id, "platform": e.platform,
+                             "translation_key": e.translation_key, "device_id": e.device_id}
+        st = hass.states.get(e.entity_id)
+        states[e.entity_id] = {"state": st.state, "attributes": dict(st.attributes)}
+    for eid in (bo or ()):
+        ents.pop(eid, None)
+        states.pop(eid, None)
+    return {"entities": ents, "states": states, "language": "vi"}
+
+
+def _node(expr, **payload):
+    script = ("const c=require(process.argv[1]);let s='';process.stdin.on('data',d=>s+=d).on('end',"
+              "()=>{const i=JSON.parse(s);console.log(JSON.stringify((" + expr + ")))})")
+    out = subprocess.run(["node", "-e", script, str(CARD)], input=json.dumps(payload),
+                         capture_output=True, text=True, timeout=20)
+    assert out.returncode == 0, out.stderr
+    return json.loads(out.stdout)
+
+
+def _mo_hinh(gia):
+    return _node("c.buildModel(i.hass,i.config)", hass=gia, config={})
+
+
+def _html(model, tab):
+    ui = {"open": True, "tab": tab, "thu": {"zone": "day", "effect": None, "params": {}, "secs": 8}}
+    return _node("c.renderHtml(i.m,i.ui,c.TEXT[i.l],i.l)", m=model, ui=ui, l="vi")
+
+
+def _goi(model, hanh_dong):
+    return _node("c.makeCall(i.m,i.a)", m=model, a=hanh_dong)
+
+
+@need_node
+async def test_mo_hinh_co_du_phat_va_khoi_dong(hass, r1):
+    await _them(hass, r1)
+    m = _mo_hinh(_hass_gia(hass))
+    assert _node("c.TABS") == ["audio", "light", "conn", "khoi_dong"]
+    assert m["phat"]["duong_phat"]["present"] is True and m["phat"]["duong_phat"]["value"] == "dlna"
+    assert m["phat"]["song_song"]["present"] is True and m["phat"]["song_song"]["on"] is False
+    assert m["phat"]["ha_nac"]["value"] == 5 and m["phat"]["airplay_port"]["value"] == 5012
+    assert m["khoi_dong"]["lich"]["present"] is True and m["khoi_dong"]["lich"]["on"] is False
+    assert m["khoi_dong"]["gio"]["value"] == "03:00:00"
+    assert len(m["khoi_dong"]["ngay"]) == 7
+    assert all(w["on"] is True for w in m["khoi_dong"]["ngay"])     # mặc định mọi ngày
+    assert m["khoi_dong"]["reboot"]["present"] is True
+    assert m["khoi_dong"]["phan_hoi"]["present"] is True
+
+
+@need_node
+async def test_goi_dich_vu_dung_qua_thuc_the(hass, r1):
+    await _them(hass, r1)
+    m = _mo_hinh(_hass_gia(hass))
+    assert _goi(m, {"type": "duong_phat", "value": "airplay"}) == [
+        "select", "select_option", {"entity_id": "select.r1_duong_phat", "option": "airplay"}]
+    assert _goi(m, {"type": "sw", "entity": "switch.r1_tts_song_song", "on": True}) == [
+        "switch", "turn_on", {"entity_id": "switch.r1_tts_song_song"}]
+    assert _goi(m, {"type": "sw", "entity": "switch.r1_lich_thu_2", "on": False}) == [
+        "switch", "turn_off", {"entity_id": "switch.r1_lich_thu_2"}]
+    assert _goi(m, {"type": "num", "entity": "number.r1_so_nac_ha_nhac", "value": 8}) == [
+        "number", "set_value", {"entity_id": "number.r1_so_nac_ha_nhac", "value": 8}]
+    assert _goi(m, {"type": "gio", "value": "04:30"}) == [
+        "time", "set_value", {"entity_id": "time.r1_lich_gio", "time": "04:30:00"}]
+    assert _goi(m, {"type": "reboot"}) == [
+        "button", "press", {"entity_id": "button.r1_khoi_dong_lai"}]
+
+
+@need_node
+async def test_html_co_muc_phat_va_tab_khoi_dong(hass, r1):
+    await _them(hass, r1)
+    m = _mo_hinh(_hass_gia(hass))
+    am_thanh = _html(m, "audio")
+    assert "Phát nhạc &amp; tin báo" in am_thanh or "Phát nhạc & tin báo" in am_thanh
+    assert "data-duong-phat" in am_thanh and "data-num" in am_thanh
+    assert "Tin báo song song AirPlay" in am_thanh
+    khoi = _html(m, "khoi_dong")
+    assert 'data-panel="khoi_dong"' in khoi
+    assert "data-gio" in khoi and "data-reboot" in khoi
+    assert khoi.count('data-sw="switch.r1_lich_thu_') == 6
+    assert 'data-sw="switch.r1_lich_chu_nhat"' in khoi          # 6 ô T2–T7 + 1 ô CN = 7 ngày
+    assert "Lần khởi động lại cuối" in khoi and "Loa phản hồi" in khoi
+
+
+@need_node
+async def test_thieu_thuc_the_lich_thi_vo_hieu_khong_vo(hass, r1):
+    """Phòng thủ theo thiết kế NV302: gộp trước NV288 thì điều khiển lịch bị vô hiệu
+    (không vỡ), còn mục phát nhạc vẫn dùng được."""
+    await _them(hass, r1)
+    m = _mo_hinh(_hass_gia(hass, bo=LICH_KHOA))
+    assert m["khoi_dong"]["lich"]["present"] is False
+    assert m["phat"]["duong_phat"]["present"] is True
+    khoi = _html(m, "khoi_dong")
+    assert "cần gộp NV288 trước" in khoi
+    assert "data-gio" not in khoi and "data-reboot" not in khoi     # không gọi dịch vụ ma
+    assert _goi(m, {"type": "reboot"}) is None
+    assert _goi(m, {"type": "duong_phat", "value": "airplay"})[0] == "select"
+
+
+@need_node
+async def test_html_thoat_du_lieu_ngoai_o_tab_khoi_dong(hass, r1):
+    await _them(hass, r1)
+    gia = _hass_gia(hass)
+    gia["states"]["sensor.r1_lan_khoi_dong_lai_cuoi"] = {
+        "state": "<script>alert(1)</script>", "attributes": {"ly_do": "<b>x</b>"}}
+    m = _mo_hinh(gia)
+    khoi = _html(m, "khoi_dong")
+    assert "<script>" not in khoi and "&lt;script&gt;" in khoi
+    assert "<b>x</b>" not in khoi
diff --git a/tests/test_nv302_thuc_the.py b/tests/test_nv302_thuc_the.py
new file mode 100644
index 0000000..c492d8f
--- /dev/null
+++ b/tests/test_nv302_thuc_the.py
@@ -0,0 +1,64 @@
+"""NV302 — thực thể phát nhạc & tin báo: tồn tại, đổi qua thực thể cập nhật tuỳ
+chọn và ngược lại (một nguồn duy nhất với hộp tuỳ chọn). Dùng ``_them`` + loa giả.
+"""
+
+from tests.test_bo_dam import _them
+
+
+async def _goi(hass, mien, dich_vu, thuc_the, **them):
+    await hass.services.async_call(mien, dich_vu, {"entity_id": thuc_the, **them}, blocking=True)
+    await hass.async_block_till_done()
+
+
+def _tuy_chon(hass, e):
+    return hass.config_entries.async_get_entry(e.entry_id).options
+
+
+async def test_duong_phat_doi_qua_thuc_the(hass, r1):
+    e = await _them(hass, r1)
+    assert hass.states.get("select.r1_duong_phat").state == "dlna"
+    await _goi(hass, "select", "select_option", "select.r1_duong_phat", option="airplay")
+    assert _tuy_chon(hass, e)["duong_phat"] == "airplay"
+    assert hass.states.get("select.r1_duong_phat").state == "airplay"
+    await _goi(hass, "select", "select_option", "select.r1_duong_phat", option="dlna")
+    assert "duong_phat" not in _tuy_chon(hass, e)          # về mặc định thì khoá bị gỡ
+
+
+async def test_cong_tac_phat_nhac_ghi_tuy_chon(hass, r1):
+    e = await _them(hass, r1)
+    await _goi(hass, "switch", "turn_on", "switch.r1_tts_song_song")
+    assert _tuy_chon(hass, e)["tts_song_song_airplay"] is True
+    await _goi(hass, "switch", "turn_on", "switch.r1_ha_nhac_xuong")
+    assert _tuy_chon(hass, e)["ha_nhac_xuong"] is True
+    await _goi(hass, "switch", "turn_off", "switch.r1_tts_song_song")
+    assert "tts_song_song_airplay" not in _tuy_chon(hass, e)
+    await _goi(hass, "switch", "turn_off", "switch.r1_ha_nhac_xuong")
+    assert "ha_nhac_xuong" not in _tuy_chon(hass, e)
+
+
+async def test_so_phat_nhac_ghi_tuy_chon(hass, r1):
+    e = await _them(hass, r1)
+    assert hass.states.get("number.r1_so_nac_ha_nhac").state == "5"
+    await _goi(hass, "number", "set_value", "number.r1_so_nac_ha_nhac", value=8)
+    assert _tuy_chon(hass, e)["ha_nhac_nac"] == 8
+    await _goi(hass, "number", "set_value", "number.r1_so_nac_ha_nhac", value=5)
+    assert "ha_nhac_nac" not in _tuy_chon(hass, e)
+    assert hass.states.get("number.r1_cong_airplay").state == "5012"
+    await _goi(hass, "number", "set_value", "number.r1_cong_airplay", value=5013)
+    assert _tuy_chon(hass, e)["airplay_port"] == 5013
+    await _goi(hass, "number", "set_value", "number.r1_cong_airplay", value=5012)
+    assert "airplay_port" not in _tuy_chon(hass, e)
+
+
+async def test_doi_tuy_chon_truc_tiep_thi_thuc_the_thay_theo(hass, r1):
+    # Đường thật khi tuỳ chọn đổi ngoài thực thể: options flow nạp lại mục (thực thể
+    # đọc tuỳ chọn trực tiếp nên sau khi nạp lại thì state theo tuỳ chọn mới).
+    e = await _them(hass, r1)
+    hass.config_entries.async_update_entry(e, options={"duong_phat": "airplay_truoc",
+                                                       "tts_song_song_airplay": True,
+                                                       "ha_nhac_nac": 9})
+    await hass.config_entries.async_reload(e.entry_id)
+    await hass.async_block_till_done()
+    assert hass.states.get("select.r1_duong_phat").state == "airplay_truoc"
+    assert hass.states.get("switch.r1_tts_song_song").state == "on"
+    assert hass.states.get("number.r1_so_nac_ha_nhac").state == "9"
diff --git a/tests/test_the_cai_dat.py b/tests/test_the_cai_dat.py
index b2efb52..1b145b9 100644
--- a/tests/test_the_cai_dat.py
+++ b/tests/test_the_cai_dat.py
@@ -126,7 +126,8 @@ async def test_muc_cai_dat_an_mac_dinh_va_chi_hien_khi_bam(hass, r1):
     assert ui["open"] is True
     mo = _html(m, ui)
     assert 'aria-expanded="true"' in mo and 'data-panel="audio"' in mo
-    assert [t for t in ("audio", "light", "conn") if f'data-tab="{t}"' in mo] == ["audio", "light", "conn"]
+    # NV302 thêm tab thứ 4 «Khởi động lại» (lịch NV288 + nút bấm lại).
+    assert [t for t in ("audio", "light", "conn", "khoi_dong") if f'data-tab="{t}"' in mo] == ["audio", "light", "conn", "khoi_dong"]
     assert mo.count("data-eq=") == 5 and "data-vol" in mo and "data-mic-gain" in mo and "data-mute" in mo
     assert _node("c.reduceUi(i.ui,{type:'toggle'})", ui=ui) == CAI_DAT_AN   # bấm lần nữa: ẩn
     # chọn nhóm: chỉ hiện nhóm đó; tab lạ bị bỏ qua
