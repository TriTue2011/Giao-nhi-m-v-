+async def test_ducking_chieu_dlna_tra_dung_muc_cu(hass, r1, dmr, raop, nguon):
+    """Ducking áp cả chiều DLNA: nhạc AirPlay nhỏ đi 5 nấc trong lúc tin
+    DLNA nói, tin xong trả đúng mức cũ (đường âm lượng thật qua mic_server)."""
+    await nhac_airplay_dang_phat(hass, r1, raop, nguon,
+                                 tts_song_song_airplay=True, ha_nhac_xuong=True, ha_nhac_nac=5)
+    p = player(hass)
+    mic = p.coordinator.mic_server
+    mic.am_luong = (10, 15)
+    dat: list[int] = []
+
+    async def gui(muc):
+        dat.append(muc)
+        mic.am_luong = (muc, 15)
+        p.async_write_ha_state()
+
+    mic.gui_am_luong = gui
+    p.async_write_ha_state()
+    await phat(hass, TTS, announce=True)
+    await cho(hass, lambda: TTS in [a["CurrentURI"] for a in dmr.called("SetAVTransportURI")]
+              and dmr.transport_state == "PLAYING")
+    dmr.transport_state = "STOPPED"
+    await cho(hass, lambda: p.coordinator.talk.announce_seq >= 1)
+    await hass.async_block_till_done()
+    assert dat == [5, 10]
+    assert "Pause" not in [n for n, _ in dmr.actions]           # nhạc không bị tạm dừng
+    await hass.services.async_call("media_player", "media_stop", {"entity_id": LOA}, blocking=True)
+
