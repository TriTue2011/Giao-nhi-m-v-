+        url = media_id
+        if media_source.is_media_source_id(media_id):
+            url = (await media_source.async_resolve_media(self.hass, media_id, self.entity_id)).url
+        url = async_process_play_media_url(self.hass, url)
+        await self._dung_tin_dlna()                    # tin mới thay tin cũ: không bao giờ hai tin DLNA cùng nói
+        tieu_de = str((kwargs.get("extra") or {}).get("title") or "Home Assistant")
+        data = self.coordinator.data
+        try:
+            if data is None or not data.dlna_open:
+                await self.coordinator.async_command(
+                    lambda: self.coordinator.client.set_dlna_open(True), dlna_open=True)
+            await self._dmr.async_san_sang(DLNA_READY_TIMEOUT)
+            await self._dmr.async_phat(url, tieu_de)
+        except Exception as exc:  # noqa: BLE001 — mở tin hỏng thì về đường thường, không phá tin
+            _LOGGER.debug("%s: không mở được tin DLNA song song: %s", self.entity_id, type(exc).__name__)
+            await self._dung_renderer_im_lang()
+            return False
+        # Chờ renderer thật sự phát (tin đã bắt đầu), hỏi thẳng _dmr.
+        han = time.monotonic() + const.ANNOUNCE_START_WAIT
+        while True:
+            try:
+                tt = await self._dmr.async_doc()
+            except R1DmrError:
+                tt = None                              # hỏi hỏng thoáng qua: chờ tiếp tới hết hạn
+            if tt is not None and tt.state in ("playing", "buffering"):
+                return True
+            if tt is not None and tt.loi:
+                break
+            if time.monotonic() >= han:
+                break
+            await asyncio.sleep(0.05)
+        _LOGGER.warning("%s: tin DLNA song song không bắt đầu được sau %.0f giây, về đường tin thường",
