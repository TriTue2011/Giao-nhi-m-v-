diff --git a/tests/test_nv303_tin_dlna.py b/tests/test_nv303_tin_dlna.py
new file mode 100644
index 0000000..f84f8e2
--- /dev/null
+++ b/tests/test_nv303_tin_dlna.py
@@ -0,0 +1,261 @@
+"""NV303 — tin báo (TTS) đi ĐƯỜNG NGƯỢC với nhạc: nhạc AirPlay ⇒ tin qua DLNA.
+
+Nối tiếp NV287 (tin song song AirPlay khi nhạc ở DLNA). NV303 thêm chiều ngược
+lại: nhạc đang ở AirPlay mà công tắc bật thì tin đi DLNA, KHÔNG tạm dừng/dừng
+phiên AirPlay, KHÔNG đụng ``_duong``/``_uri``/trạng thái của thực thể (trạng thái
+đó vẫn là nhạc AirPlay). Tin xong được theo dõi bằng chính trạng thái DLNA
+(hỏi thẳng ``_dmr``, không qua ``_doc``/``_ap_dung`` — hai chỗ đó bị cổng
+AirPlay chặn, và ghi vào sẽ đè trạng thái nhạc thật). Lỗi hoặc không bắt đầu
+được thì về đường thường (tạm dừng nhạc, phát tin, khôi phục). Ducking áp cả
+hai chiều, trả đúng mức cũ kể cả khi tin lỗi.
+
+LƯU Ý môi trường: như test NV287, sandbox chặn UDP send nên ``raop.audio``
+không đầy — chứng minh bằng bắt tay RTSP + URI DLNA + ``announce_seq``.
+"""
+
+import asyncio
+from unittest import mock
+
+import pytest
+from pytest_homeassistant_custom_component.common import MockConfigEntry
+
+from custom_components.r1_speaker import const, giu_nhac
+from custom_components.r1_speaker import dmr as dmr_mod
+from custom_components.r1_speaker import media_player as r1_mp
+from custom_components.r1_speaker.const import DOMAIN
+from custom_components.r1_speaker.dmr import TrangThaiDmr
+
+from .fake_dmr import FakeDMR
+from .fake_raop import FakeRaop
+
+MUSIC = "http://nhac.example/bai.mp3"
+TTS = "http://ha.example/api/tts_proxy/x.mp3"
+LOA = "media_player.r1_loa"
+
+
+@pytest.fixture(autouse=True)
+def _nhanh():
+    with mock.patch.object(giu_nhac, "POLL", 0.01), \
+            mock.patch.object(const, "PAUSE_CONFIRM_S", 0.3), \
+            mock.patch.object(const, "RESTORE_WAIT", 0.3), \
+            mock.patch.object(r1_mp, "CHAM_NHAC", 0.05), \
+            mock.patch.object(r1_mp, "CHAM_TIN", 0.05):
+        yield
+
+
+@pytest.fixture
+async def dmr(r1):
+    d = FakeDMR(lambda: any(m.get("open") is True for m in r1.commands("Set_DLNA_Open")))
+    await d.start()
+
+    async def ssdp(host, **kw):
+        return d.location if d.enabled() else None
+
+    with mock.patch.object(dmr_mod, "tim_mo_ta", new=ssdp):
+        yield d
+    await d.stop()
+
+
+@pytest.fixture
+async def raop():
+    f = FakeRaop(do_tre=2205)
+    await f.start()
+    yield f
+    await f.stop()
+
+
+class Nguon:
+    """Thay ``tao_nguon``: ghi (url, bắt đầu), trả bộ phát giả hữu hạn."""
+
+    def __init__(self):
+        self.goi: list[tuple[str, float]] = []
+        self.so_goi = {}
+
+    def __call__(self, url, bat_dau=0.0, ffmpeg=None):
+        self.goi.append((url, bat_dau))
+
+        async def gen():
+            import array
+            from custom_components.r1_speaker import airplay as ap_mod
+            yield array.array("h", [1] * (ap_mod.KHUNG_MOI_GOI * 2 * self.so_goi.get(url, 400))).tobytes()
+        return gen
+
+
+@pytest.fixture
+def nguon():
+    n = Nguon()
+    with mock.patch.object(r1_mp, "tao_nguon", new=n):
+        yield n
+
+
+async def them(hass, r1, raop, che_do, **tuy_chon):
+    r1.state["dlna_open"] = False
+    r1.state["airplay_open"] = True
+    e = MockConfigEntry(domain=DOMAIN, data={"host": "127.0.0.1", "port": r1.port},
+                        unique_id=f"127.0.0.1:{r1.port}",
+                        options={"duong_phat": che_do, "airplay_port": raop.port, **tuy_chon})
+    e.add_to_hass(hass)
+    assert await hass.config_entries.async_setup(e.entry_id)
+    await hass.async_block_till_done()
+    return e
+
+
+async def phat(hass, url, **extra):
+    await hass.services.async_call("media_player", "play_media", {
+        "entity_id": LOA, "media_content_id": url, "media_content_type": "music", **extra},
+        blocking=True)
+
+
+async def cho(hass, dieu_kien, han=10.0):
+    async with asyncio.timeout(han):
+        while not dieu_kien():
+            await asyncio.sleep(0.02)
+
+
+async def cho_state(hass, mong_doi, han=10.0):
+    await cho(hass, lambda: hass.states.get(LOA) is not None
+              and hass.states.get(LOA).state == mong_doi, han)
+
+
+def thuoc_tinh(hass):
+    return hass.states.get(LOA).attributes
+
+
+def player(hass):
+    return hass.data["entity_components"]["media_player"].get_entity(LOA)
+
+
+async def nhac_airplay_dang_phat(hass, r1, raop, nguon, **tuy_chon):
+    """Nhạc AirPlay đang chạy (nguồn dài để không hết giữa test)."""
+    nguon.so_goi[MUSIC] = 4000
+    await them(hass, r1, raop, "airplay", **tuy_chon)
+    await phat(hass, MUSIC)
+    await cho_state(hass, "playing")
+    assert thuoc_tinh(hass)["duong_phat"] == "airplay"
+    assert thuoc_tinh(hass)["media_content_id"] == MUSIC
+
+
+# ── chiều ngược: nhạc AirPlay ⇒ tin DLNA ────────────────────────────────────
+
+async def test_nhac_airplay_tin_qua_dlna_khong_dung_phien_airplay(hass, r1, dmr, raop, nguon):
+    """Tin đi DLNA trong khi nhạc AirPlay vẫn phát: AirPlay không nhận
+    Pause/Stop/FLUSH, không phát lại nhạc, trạng thái thực thể vẫn là nhạc
+    AirPlay suốt lúc tin nói; tin xong giữ nhạc nhả hết, không idle lạ."""
+    await nhac_airplay_dang_phat(hass, r1, raop, nguon, tts_song_song_airplay=True)
+    await phat(hass, TTS, announce=True)
+    await cho(hass, lambda: TTS in [a["CurrentURI"] for a in dmr.called("SetAVTransportURI")]
+              and dmr.transport_state == "PLAYING")
+    # Giữa lúc tin DLNA nói: nhạc AirPlay vẫn là «bài đang phát», không bị đụng.
+    assert thuoc_tinh(hass)["media_content_id"] == MUSIC
+    assert thuoc_tinh(hass)["duong_phat"] == "airplay"
+    assert [u for u, _ in nguon.goi] == [MUSIC]               # tin không qua RAOP, nhạc không phát lại
+    assert "FLUSH" not in raop.phuong_thuc() and "TEARDOWN" not in raop.phuong_thuc()
+    # Hỏi lại trạng thái (chu kỳ coordinator) cũng không được đè trạng thái
+    # nhạc AirPlay bằng trạng thái DLNA của tin.
+    await player(hass).async_lam_moi()
+    await asyncio.sleep(0.2)
+    assert hass.states.get(LOA).state == "playing"
+    assert thuoc_tinh(hass)["media_content_id"] == MUSIC
+    dmr.transport_state = "STOPPED"                            # tin DLNA hết (loa giả đặt tay)
+    await cho(hass, lambda: player(hass).coordinator.talk.announce_seq >= 1)
+    await hass.async_block_till_done()
+    assert player(hass).coordinator.talk.music.holds == 0
+    assert hass.states.get(LOA).state == "playing"              # nhạc AirPlay vẫn phát tiếp
+    assert thuoc_tinh(hass)["media_content_id"] == MUSIC
+    await hass.services.async_call("media_player", "media_stop", {"entity_id": LOA}, blocking=True)
+
