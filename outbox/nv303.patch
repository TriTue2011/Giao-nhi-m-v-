+            await asyncio.wait({tac})
+            await self._dung_renderer_im_lang()
+
+    async def _dung_renderer_im_lang(self) -> None:
+        """Dừng renderer DLNA, nuốt mọi lỗi: dọn sau khi tin DLNA mở hỏng
+        giữa chừng để đường tin thường không bị tin dở dang đè tiếng."""
+        try:
+            await self._dmr.async_dung()
+        except Exception as exc:  # noqa: BLE001 — dọn dẹp sau lỗi: renderer chết thì không còn gì để dừng
+            _LOGGER.debug("%s: dọn renderer DLNA sau tin hỏng: %s", self.entity_id, type(exc).__name__)
+
     #: Thứ tự thử các đường theo tuỳ chọn ``duong_phat``.
     _THU_TU = {"dlna": ("dlna",), "dlna_truoc": ("dlna", "airplay"), "airplay_truoc": ("airplay", "dlna"), "airplay": ("airplay",)}
     _TEN_DUONG = {"dlna": "DLNA", "airplay": "AirPlay"}
 
