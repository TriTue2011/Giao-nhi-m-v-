+async def test_tin_dlna_loi_thi_ve_duong_thuong(hass, r1, dmr, raop, nguon):
+    """Renderer từ chối lệnh DLNA thì tin về đường thường: tạm dừng nhạc
+    AirPlay, tin qua AirPlay, khôi phục nhạc (đúng thứ tự MUSIC, TTS, MUSIC)."""
+    nguon.so_goi[TTS] = 20
+    await nhac_airplay_dang_phat(hass, r1, raop, nguon, tts_song_song_airplay=True)
+    dmr.tu_choi.add("SetAVTransportURI")
+    await phat(hass, TTS, announce=True)
+    await cho(hass, lambda: [u for u, _ in nguon.goi].count(MUSIC) >= 2)
+    assert [u for u, _ in nguon.goi][:3] == [MUSIC, TTS, MUSIC]
+    await hass.services.async_call("media_player", "media_stop", {"entity_id": LOA}, blocking=True)
+
