+async def test_idle_cua_tin_dlna_khong_thanh_finished(hass, r1, dmr, raop, nguon):
+    """Vòng lặp cần tránh (NV303 mục 3): renderer về idle lúc tin DLNA dứt
+    không được khai ``finished`` — bộ điều khiển đọc finished là sang bài kế.
+    Trong lúc tin DLNA còn đang chạy, idle của renderer phải là ``dang_giu``."""
+    await nhac_airplay_dang_phat(hass, r1, raop, nguon, tts_song_song_airplay=True)
+    await phat(hass, TTS, announce=True)
+    await cho(hass, lambda: TTS in [a["CurrentURI"] for a in dmr.called("SetAVTransportURI")]
+              and dmr.transport_state == "PLAYING")
+    p = player(hass)
+    assert p._tin_dlna_dang_chay
+    p._ap_dung(TrangThaiDmr(state="idle"))                     # renderer báo idle giữa lúc tin chạy
+    assert p._ly_do == "dang_giu"
+    await hass.services.async_call("media_player", "media_stop", {"entity_id": LOA}, blocking=True)
