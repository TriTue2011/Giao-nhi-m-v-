+        talk = self.coordinator.talk
+        try:
+            try:
+                async with asyncio.timeout(const.ANNOUNCE_MAX):
+                    while True:
+                        try:
+                            tt = await self._dmr.async_doc()
+                        except R1DmrError as exc:
+                            _LOGGER.warning("tin DLNA song song trên %s: không hỏi được renderer (%s) — coi như tin đã hết",
+                                            self.entity_id, type(exc).__name__)
+                            break
+                        if tt.state not in ("playing", "buffering"):
+                            break
+                        await asyncio.sleep(0.05)
+            except TimeoutError:
+                _LOGGER.warning("tin DLNA song song trên %s chưa xong sau %.0f giây — dừng renderer",
+                                self.entity_id, const.ANNOUNCE_MAX)
+                await self._dung_renderer_im_lang()
+        finally:
+            if self._tin_dlna_tac is asyncio.current_task():   # đừng xoá tác vụ của tin mới hơn
+                self._tin_dlna_tac = None
+            talk.announce_done()
+            await giu.release()
+
+    async def _dung_tin_dlna(self) -> None:
+        """Dừng tin DLNA song song (nếu có) — dùng khi người dùng Stop, khi
