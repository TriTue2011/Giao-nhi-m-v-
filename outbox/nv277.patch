+"""Test lõi cho đường riêng của module /m/<id>/api/... (NV277).
+
+Lõi tự xác thực + giới hạn LAN, module chỉ là đối tượng giả có
+tich_hop/luong. Không Internet, không module thật, không kho thật:
+kho bí mật được monkeypatch, nguồn LAN được bật bằng cờ test loopback.
+
+Kiểm (theo nghiệm thu NV277):
+- Không khoá → 401; khoá sai → 401; khoá của module KHÁC → 403;
+  khoá đúng → 200 từ đúng module (không lộ dữ liệu module khác);
+- Module không chạy / không khai duong_module → 404;
+- Thân POST quá trần / JSON hỏng → 400;
+- Đổi id module trong đường dẫn không chạm dữ liệu module khác
+  (IDOR: khoá youtube gọi /m/other/... → 403, không phải dữ liệu other);
+- Luồng: vé ký đúng → 200/206, Range lặp lại vẫn chạy; vé giả →
+  404 THÂN RỖNG (không nêu lý do); vé hết hạn → 404; HEAD cùng vé
+  chỉ trả header, không đẩy byte.
+"""
+
+from __future__ import annotations
+
+import time
+from types import SimpleNamespace
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+from app import duong_module
+
+KHOA_YT = "khoa-gia-youtube-nv277-aaaaaaaaaaaaaaaaaaaa"
+KHOA_KHAC = "khoa-gia-khac-nv277-bbbbbbbbbbbbbbbbbbbb"
+
+
+class ModGia:
+    def __init__(self, nhan):
+        self.nhan = nhan
+
+    async def tich_hop(self, duong, phuong_thuc, query, than):
+        return 200, {}, {"nhan": self.nhan, "duong": duong,
+                         "phuong_thuc": phuong_thuc, "success": True}
+
+    async def luong(self, ve, khoang, phuong_thuc):
+        du_lieu = b"0123456789abcdef" * 4
+        if khoang == "bytes=10-19":
+            return 206, {"Content-Range": f"bytes 10-19/{len(du_lieu)}",
+                         "Content-Length": "10", "Accept-Ranges": "bytes"}, du_lieu[10:20]
+        return 200, {"Content-Length": str(len(du_lieu)), "Accept-Ranges": "bytes"}, du_lieu
+
+
+def _app(monkeypatch, tmp_path):
+    monkeypatch.setenv("WEB2API_DATA", str(tmp_path))
+    monkeypatch.setenv("WEB2API_TEST_CHO_PHEP_LOOPBACK", "1")
+    monkeypatch.setattr(duong_module.kho_mod, "doc_bi_mat",
+                        lambda ten: {"youtube": {"khoa_tich_hop": KHOA_YT},
+                                     "other": {"khoa_tich_hop": KHOA_KHAC}}.get(ten, {}))
+    app = FastAPI()
+    app.include_router(duong_module.router)
+    so = SimpleNamespace(
+        catalog={
+            "youtube": SimpleNamespace(manifest={
+                "duong_module": {"truong_bi_mat": "khoa_tich_hop", "lan_chi": True}}),
+            "other": SimpleNamespace(manifest={
+                "duong_module": {"truong_bi_mat": "khoa_tich_hop", "lan_chi": True}}),
+            "khong-duong": SimpleNamespace(manifest={}),
+        },
+        dang_chay={
+            "youtube": ModGia("youtube"),
+            "other": ModGia("other"),
+            "khong-duong": ModGia("khong-duong"),
+        },
+    )
+    app.state.so = so
+    return TestClient(app, raise_server_exceptions=False)
+
+
+def test_khong_khoa_va_sai_khoa_401(monkeypatch, tmp_path):
+    c = _app(monkeypatch, tmp_path)
+    assert c.get("/m/youtube/api/integration/health").status_code == 401
+    r = c.get("/m/youtube/api/integration/health",
+              headers={"Authorization": "Bearer sai"})
+    assert r.status_code == 401 and r.json() == {"error": "invalid_auth"}
+
+
+def test_khoa_module_khac_403_va_khoa_dung_200(monkeypatch, tmp_path):
+    c = _app(monkeypatch, tmp_path)
+    r = c.get("/m/youtube/api/integration/health",
+              headers={"Authorization": f"Bearer {KHOA_KHAC}"})
+    assert r.status_code == 403
+    r = c.get("/m/youtube/api/integration/health",
+              headers={"Authorization": f"Bearer {KHOA_YT}"})
+    assert r.status_code == 200 and r.json()["nhan"] == "youtube"
+    assert r.headers["Cache-Control"] == "no-store"
+
+
+def test_idor_doi_id_khong_cham_du_lieu_khac(monkeypatch, tmp_path):
+    c = _app(monkeypatch, tmp_path)
+    # Khoá youtube gọi đường của other → 403, không thấy dữ liệu other.
+    r = c.get("/m/other/api/integration/health",
+              headers={"Authorization": f"Bearer {KHOA_YT}"})
+    assert r.status_code == 403
+    # Khoá other gọi đúng đường other → thấy dữ liệu other.
+    r = c.get("/m/other/api/integration/health",
+              headers={"Authorization": f"Bearer {KHOA_KHAC}"})
+    assert r.status_code == 200 and r.json()["nhan"] == "other"
+
+
+def test_module_khong_chay_hoac_khong_khai_duong_404(monkeypatch, tmp_path):
+    c = _app(monkeypatch, tmp_path)
+    r = c.get("/m/khong-co/api/integration/health",
+              headers={"Authorization": f"Bearer {KHOA_YT}"})
+    assert r.status_code == 404
+    r = c.get("/m/khong-duong/api/integration/health",
+              headers={"Authorization": f"Bearer {KHOA_YT}"})
+    assert r.status_code == 404
+
+
+def test_than_post_qua_tran_va_json_hong_400(monkeypatch, tmp_path):
+    c = _app(monkeypatch, tmp_path)
+    h = {"Authorization": f"Bearer {KHOA_YT}"}
+    r = c.post("/m/youtube/api/integration/playlists", content=b"x" * 400_001,
+               headers=h)
+    assert r.status_code == 400
+    r = c.post("/m/youtube/api/integration/playlists", content=b"{hong",
+               headers=h)
+    assert r.status_code == 400
+
+
+def test_luong_ve_dung_range_lap_lai_ve_gia_het_han(monkeypatch, tmp_path):
+    c = _app(monkeypatch, tmp_path)
+    url = duong_module.tao_duong_luong("youtube", "ve-1")
+    r = c.get(url)
+    assert r.status_code == 200 and len(r.content) == 64
+    r1 = c.get(url, headers={"Range": "bytes=10-19"})
+    r2 = c.get(url, headers={"Range": "bytes=10-19"})
+    assert r1.status_code == 206 and r2.status_code == 206
+    assert r1.content == r2.content == bytes(b"0123456789abcdef" * 4)[10:20]
+    # Vé giả (thêm ký tự vào cuối query) → 404 thân rỗng, không nêu lý do.
+    r = c.get(url + "x")
+    assert r.status_code == 404 and r.content == b""
+    # Vé hết hạn (ký 1 giây rồi đợi qua biên giây — url_ky chỉ hết hạn
+    # khi now > _het_han, nên đợi 2,2 giây cho chắc) → 404.
+    url_ngan = duong_module.tao_duong_luong("youtube", "ve-2", het_han_giay=1)
+    time.sleep(2.2)
+    r = c.get(url_ngan)
+    assert r.status_code == 404 and r.content == b""
+    # HEAD cùng vé: chỉ header, không byte.
+    r = c.head(url)
+    assert r.status_code == 200 and r.content == b""
+    assert r.headers["Content-Length"] == "64"
+
+
+def test_luong_lan_chi_chan_nguon_ngoai(monkeypatch, tmp_path):
+    # Không bật cờ loopback: peer TestClient không phân tích được → chặn.
+    monkeypatch.setenv("WEB2API_DATA", str(tmp_path))
+    monkeypatch.delenv("WEB2API_TEST_CHO_PHEP_LOOPBACK", raising=False)
+    monkeypatch.setattr(duong_module.kho_mod, "doc_bi_mat",
+                        lambda ten: {"youtube": {"khoa_tich_hop": KHOA_YT}}.get(ten, {}))
+    app = FastAPI()
+    app.include_router(duong_module.router)
+    app.state.so = SimpleNamespace(
+        catalog={"youtube": SimpleNamespace(manifest={
+            "duong_module": {"truong_bi_mat": "khoa_tich_hop"}})},
+        dang_chay={"youtube": ModGia("youtube")})
+    c = TestClient(app, raise_server_exceptions=False)
+    url = duong_module.tao_duong_luong("youtube", "ve-1")
+    r = c.get(url)
+    assert r.status_code == 404
