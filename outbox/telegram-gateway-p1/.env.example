# Telegram Gateway — biến môi trường (CHỈ TÊN BIẾN, KHÔNG GIÁ TRỊ THẬT)
# Copy thành .env trên server, điền giá trị thật, chmod 0600.
# Tuyệt đối KHÔNG copy file .env từ máy khác sang.

# Token REST của gateway — SINH MỚI trên server bằng: openssl rand -hex 32
GATEWAY_TOKEN=

# API credentials của app Telegram do chính chủ máy tạo ở my.telegram.org
# (nhập một lần qua web UI nội bộ của gateway; không bắt buộc ghi ở đây)
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

# Webhook HA nhận event (để trống thì HA chỉ poll /api/events)
HA_WEBHOOK_URL=
HA_WEBHOOK_TOKEN=

DATA_DIR=/data
REST_PORT=3333
LOG_LEVEL=INFO

# Giá trị mặc định gọi (mượn từ telegram_voip, chỉnh sau kiểm thử thật)
RING_TIMEOUT=45
RING_ATTEMPTS=2
RING_INTERVAL=15
MAX_CALL_SECONDS=180
QUEUE_TIMEOUT=120
QUEUE_DEPTH=10

# TTS vào cuộc gọi (P1)
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=+0%

# Giới hạn REST (request/phút/token)
RATE_LIMIT_PER_MINUTE=120

# Khung P0: 1 = mock (mọi tác vụ cần tài khoản thật trả mock/501).
# P1 bật engine thật thì đặt 0.
GATEWAY_MOCK=1
