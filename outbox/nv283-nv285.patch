+    return ("that_bai", _ma_loi_ket_qua_an_toan(ma_loi, ma_trang_thai), False)
+
+
+def ghi_ket_qua_dang_nhap_tu_ket_qua(id_, kq) -> dict | None:
+    """HÀM BỌC CHUNG (NV283 §2a): mọi đường đăng nhập ghi qua đây, đúng
