+
+
+def test_trinh_duyet_none_la_ma_rieng_khong_phai_can_nguoi(mod):
+    mod._luu_mat_khau("tk-gia-3", EMAIL_GIA, BiMatTam(MAT_KHAU_GIA))
+    kq = chay(mod.khoi_phuc_tu_dong("tk-gia-3", EMAIL_GIA))
