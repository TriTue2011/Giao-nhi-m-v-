+    td = _trinh_duyet(["thanh_cong"], {"sso": SSO_GIA_OK, "x-userid": UID_GIA})
+    mod.dang_ky_trinh_duyet(lambda: td)
+    kq = chay(mod.khoi_phuc_tu_dong("tk-gia-2", EMAIL_GIA))
