+    td = _trinh_duyet(["thanh_cong"], {"sso": SSO_GIA_OK, "x-userid": UID_GIA})
+    kq = chay(mod.khoi_phuc_tu_dong("tk-gia-1", EMAIL_GIA, trinh_duyet=td))
+    assert kq.thanh_cong and kq.tang in ("T2", "T3")
