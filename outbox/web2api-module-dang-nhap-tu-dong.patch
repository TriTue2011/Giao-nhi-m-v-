+_MA_CAPTCHA = {"captcha", "thu_thach_truoc_khi_dien", "need_captcha"}
+
+
+def _khoa_t2() -> asyncio.Lock:
+    global _KHOA_T2
+    if _KHOA_T2 is None:
+        _KHOA_T2 = asyncio.Lock()
+    return _KHOA_T2
+
+
+def dat_lai_trang_thai_t2() -> None:
+    """Dùng cho test: xoá khóa serial, cửa sổ hoãn captcha, mốc T2."""
