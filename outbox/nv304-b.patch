+  p.setAttribute('d', 'M8 5.5v13l11-6.5z');
+  p.setAttribute('fill', 'currentColor');
+  s.append(p);
+  return s;
+}
+function svgHangDoi() {
+  return svgDuong(svgDuong(svgKhoi(), 'M4 6h12M4 12h12M4 18h8'), 'M18 15v6M15 18h6');
+}
