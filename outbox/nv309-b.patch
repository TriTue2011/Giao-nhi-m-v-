+++ b/dich-vu/may-dang-nhap/test_nv309_b.py
@@ -0,0 +1,151 @@
+# test_nv309_b.py — NV309-b (SAI S2): hồ sơ Grok need_manual vào diện chờ người.
+#
+# SAI S2 là mâu thuẫn nội tại, không phải «khác c2a nên sai»: _chay của
+# grok_web_login CỐ Ý GIỮ cửa sổ ở trạng thái need_manual (chủ máy sắp vào
+# noVNC tích ô), nhưng xong_dang_nhap gỡ cờ đang-đăng-nhập nên vòng quét
+# nhánh thường đóng cửa sổ sau 300 giây nhàn rỗi theo last_used — đúng lúc
+# chủ máy vào noVNC muộn hơn 5 phút thì cửa sổ đã mất, thông điệp «Cửa sổ vẫn
+# đang mở» thành sai.
+#
+# Sửa: need_manual vào diện chờ người của vòng quét (600 giây + tính
+# last_view, như diện chờ người đã có); thông điệp mang theo hạn 10 phút để
+# không còn nói sai. Test khẳng định hành vi đúng, không khẳng định «giống c2a».
+# Bộ điều khiển GIẢ — không trình duyệt thật.
+from __future__ import annotations
+
+import asyncio
+import sys
+import time
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import _gia_goi  # noqa: F401
+
+from src import browser_pool as bp
+from src import grok_web_login as gwl
+from src.browser_pool import BrowserPool
+
+
+class _DemMoDong:
+    def __init__(self):
+        self.dang_mo = 0
+        self.tong_mo = 0
+        self.tong_dong = 0
+
+
+class _CtxGia:
+    def __init__(self, dem):
+        self._dem = dem
+        self.pages = []
+        self.dong = False
+        dem.dang_mo += 1
+        dem.tong_mo += 1
+
+    async def close(self):
+        if not self.dong:
+            self.dong = True
+            self._dem.dang_mo -= 1
+            self._dem.tong_dong += 1
+
+    async def cookies(self):
+        return []
+
+    def on(self, *a, **k):
+        pass
+
+
+@pytest.fixture
+def bo_dem():
+    return _DemMoDong()
+
+
+@pytest.fixture
+def pool(monkeypatch, bo_dem):
+    p = BrowserPool()
+
+    async def khong_lam_gi():
+        return None
+
+    async def mo_gia(profile, headless):
+        return _CtxGia(bo_dem), None
+
+    monkeypatch.setattr(p, "start", khong_lam_gi)
+    monkeypatch.setattr(p, "_open_context", mo_gia)
+    monkeypatch.setattr(bp, "CHO_CHO_TRONG_GIAY", 0.2)
+    return p
+
+
+def _chay(coro):
+    return asyncio.run(coro)
+
+
+def test_need_manual_nhan_301_giay_co_nguoi_xem_thi_khong_dong(pool, bo_dem):
+    """ĐỎ trước: need_manual nhàn 301 giây theo last_used nhưng vừa có người
+    xem (last_view mới) thì vòng quét KHÔNG được đóng — diện chờ người tính
+    cả last_view, hạn 600 giây."""
+    async def kich_ban():
+        await pool.get(profile="hs-a", headless=False)
+        pool.danh_dau_cho_nguoi("hs-a")
+        bay_gio = time.time()
+        pool._contexts["hs-a"].last_used = bay_gio - 301
+        pool._contexts["hs-a"].last_view = bay_gio
+        assert await pool._quet_nhan_roi(bay_gio) == []
+        assert bo_dem.dang_mo == 1
+    _chay(kich_ban())
+
+
+def test_need_manual_qua_600_giay_khong_hoat_dong_thi_dong_va_bo_co(pool, bo_dem):
+    """Quá 600 giây không hoạt động (cả last_used lẫn last_view đều cũ) thì
+    đóng và bỏ cờ — chờ người có hạn, không giữ vô thời hạn (tràn RAM)."""
+    async def kich_ban():
+        await pool.get(profile="hs-a", headless=False)
+        pool.danh_dau_cho_nguoi("hs-a")
+        bay_gio = time.time()
+        pool._contexts["hs-a"].last_used = bay_gio - 601
+        pool._contexts["hs-a"].last_view = bay_gio - 601
+        assert await pool._quet_nhan_roi(bay_gio) == ["hs-a"]
+        assert bo_dem.dang_mo == 0 and not pool.dang_cho_nguoi("hs-a")
+    _chay(kich_ban())
+
+
+def test_need_manual_xem_man_hinh_gia_han_qua_600_giay_last_used(pool, bo_dem):
+    """last_view mới gia hạn: last_used cũ quá 600 giây nhưng vừa xem thì giữ."""
+    async def kich_ban():
+        await pool.get(profile="hs-a", headless=False)
+        pool.danh_dau_cho_nguoi("hs-a")
+        bay_gio = time.time()
+        pool._contexts["hs-a"].last_used = bay_gio - 700
+        pool._contexts["hs-a"].last_view = bay_gio
+        assert await pool._quet_nhan_roi(bay_gio) == []
+        assert bo_dem.dang_mo == 1
+    _chay(kich_ban())
+
+
+def test_chay_need_manual_danh_dau_cho_nguoi_va_thong_diep_mang_han(monkeypatch, pool):
+    """_chay kết thúc ở need_manual → pool mang cờ chờ người (không còn rơi
+    về nhánh thường 300 giây), và thông điệp mang hạn 10 phút thay vì nói
+    «vẫn đang mở» vô hạn."""
+    async def get_gia2(profile, headless=False, force_recreate=False, **kw):
+        async def nop(*a, **k):
+            return None
+        return SimpleNamespace(pages=[SimpleNamespace(
+            bring_to_front=nop, goto=nop)])
+
+    monkeypatch.setattr(pool, "get", get_gia2)
+    monkeypatch.setattr(gwl, "pool", pool)
+
+    async def nhin_chan(page):
+        return {"chan": True}
+
+    monkeypatch.setattr(gwl, "_nhin_trang", nhin_chan)
+    session = gwl.GrokWebLoginSession(profile="hs-a", email="")
+
+    async def kich_ban():
+        await gwl._chay(session, "")
+    _chay(kich_ban())
+    assert session.state == "need_manual"
+    assert pool.dang_cho_nguoi("hs-a")
+    assert "10 phút" in session.message
