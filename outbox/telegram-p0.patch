+class KhoPhien:
+    """Phiên TDLib trên đĩa cho module (P0: cấu trúc + khóa + sổ mock).
+
+    Bố cục dưới <gốc>/tdlib/<id-tài-khoản>/:
+      khoa           — khóa mã hóa local TDLib, 32 byte hex, 0600
+      files/         — thư mục files của TDLib, 0700 (P0 để trống)
+      tai_khoan.json — sổ tài khoản mock, 0600 (P1 thay bằng trạng thái thật)
+    P0 chưa tạo client TDLib thật nên chưa có dữ liệu phiên thật trong files/.
+    """
+
+    def __init__(self, goc):
+        self.goc = Path(goc)
+        self.thu_muc_tdlib = self.goc / "tdlib"
+
+    @staticmethod
+    def _thu_muc(tep: Path) -> Path:
+        tep.mkdir(parents=True, exist_ok=True)
+        os.chmod(tep, 0o700)
+        return tep
+
+    def _thu_muc_tk(self, tk_id: str) -> Path:
+        if not _MA_TK.match(tk_id or ""):
+            raise ValueError(f"id tài khoản không hợp lệ: {tk_id}")
+        return self._thu_muc(self.thu_muc_tdlib / tk_id)
+
+    def tao_khoa(self, tk_id: str) -> str:
+        """Tạo (lần đầu) hoặc đọc lại khóa mã hóa local của tài khoản."""
+        thu_muc = self._thu_muc_tk(tk_id)
+        tep = thu_muc / "khoa"
+        if tep.exists():
+            return tep.read_text(encoding="utf-8").strip()
+        khoa = secrets.token_hex(32)
+        _ghi_nguyen_tu(tep, khoa.encode("utf-8"))
+        return khoa
+
+    def duong_files(self, tk_id: str) -> Path:
+        """Thư mục files của TDLib cho tài khoản (P1 truyền vào tdjson)."""
+        return self._thu_muc(self._thu_muc_tk(tk_id) / "files")
+
+    def them_tai_khoan(self, ten: str, peer: str) -> dict:
+        """Thêm tài khoản MOCK (P0): tạo thư mục + khóa + sổ. P1 thay bằng
+        luồng đăng nhập OTP/2FA/QR thật ở tab module."""
+        tk_id = "tk-" + uuid.uuid4().hex[:12]
+        thu_muc = self._thu_muc_tk(tk_id)
+        self.tao_khoa(tk_id)
+        self.duong_files(tk_id)
+        ban_ghi = {
+            "id": tk_id,
+            "ten": ten,
+            "peer": peer,
+            "trang_thai": "mock",
+            "da_dang_nhap": False,
+            "tao_luc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+        }
+        _ghi_nguyen_tu(
+            thu_muc / "tai_khoan.json",
+            json.dumps(ban_ghi, ensure_ascii=False, indent=2).encode("utf-8"),
+        )
+        return ban_ghi
+
+    def danh_sach(self) -> list:
+        """Mọi tài khoản còn sổ trên đĩa (bền qua restart lõi)."""
+        if not self.thu_muc_tdlib.is_dir():
+            return []
+        ds = []
+        for tep in sorted(self.thu_muc_tdlib.glob("*/tai_khoan.json")):
+            try:
+                ban_ghi = json.loads(tep.read_text(encoding="utf-8"))
+            except (ValueError, OSError):
+                continue
+            if isinstance(ban_ghi, dict) and isinstance(ban_ghi.get("id"), str):
+                ds.append(ban_ghi)
+        ds.sort(key=lambda b: b.get("tao_luc", ""))
+        return ds
+
+    def lay(self, tk_id: str):
+        try:
+            thu_muc = self._thu_muc_tk(tk_id)
+        except ValueError:
+            return None
+        tep = thu_muc / "tai_khoan.json"
+        try:
+            ban_ghi = json.loads(tep.read_text(encoding="utf-8"))
+        except (ValueError, OSError):
+            return None
+        return ban_ghi if isinstance(ban_ghi, dict) else None
+
+    def xoa(self, tk_id: str) -> bool:
+        """Xóa tài khoản + phiên (chỉ trong tab module, không bao giờ qua /m)."""
+        try:
+            thu_muc = self._thu_muc_tk(tk_id)
+        except ValueError:
+            return False
+        if not thu_muc.is_dir():
+            return False
+        shutil.rmtree(thu_muc)
+        return True
+
+
+class Module:
+    """Module telegram-user (P0 khung + mock)."""
+
+    def __init__(self, manifest):
+        self.manifest = manifest if isinstance(manifest, dict) else {}
+        self.kho = None  # lõi gán sau khi tạo (kho riêng của module) — P0 chưa dùng
+        self._api_id = ""
+        self._api_hash = ""
+        self._dich = {}
+        self._so = dict(_MAC_DINH_SO)
+        self._tts_voice = "vi-VN-HoaiMyNeural"
+        self._tts_rate = "+0%"
+        self._webhook_url = ""
+        self._webhook_token = ""
+        self._audio_endpoint = "ha"
+        self._cho_phep_ha_goi_di = False
+        self._tu_dong_nghe_may = False
+        self._da_nap = False
+        self._da_dung = False
+        self._hop_thu_di = []  # tin mock đã «gửi» (ghi nhận dispatch, không gửi thật)
+        self._hop_thu_den = []  # tin mock chờ hoi_vong kéo
+        self._su_kien = []  # spool event mock (id đơn điệu tăng, tối đa 10000)
+        self._su_kien_tiep = 1
+
+    def _phien(self) -> KhoPhien:
+        goc = Path(os.environ.get("WEB2API_DATA", "/data")) / "telegram-user"
+        return KhoPhien(goc)
+
+    # ── vòng đời ──────────────────────────────────────────────────────
+    def nap(self, cau_hinh: dict) -> None:
+        """Nạp cấu hình ĐÃ KIỂM (lúc khởi động/cài xong) — không gọi mạng."""
+        cau_hinh = cau_hinh or {}
+        api_id = cau_hinh.get("api_id")
+        self._api_id = str(api_id).strip() if api_id is not None else ""
+        api_hash = cau_hinh.get("api_hash")
+        self._api_hash = str(api_hash).strip() if api_hash is not None else ""
+        _LOC.them(self._api_id)
+        _LOC.them(self._api_hash)
+        token_wh = cau_hinh.get("ha_webhook_token")
+        self._webhook_token = str(token_wh).strip() if token_wh is not None else ""
+        _LOC.them(self._webhook_token)
+        self._webhook_url = str(cau_hinh.get("ha_webhook_url") or "").strip()
+        try:
+            self._dich = {d["id"]: d for d in _kiem_dich(cau_hinh.get("dich"))}
+        except ValueError as e:
+            log.warning("telegram-user: cấu hình đích sai (%s)", e)
+            self._dich = {}
+        for khoa, mac_dinh in _MAC_DINH_SO.items():
+            self._so[khoa] = _doc_so(cau_hinh.get(khoa), mac_dinh)
+        self._tts_voice = (
+            str(cau_hinh.get("tts_voice") or "vi-VN-HoaiMyNeural").strip()
+            or "vi-VN-HoaiMyNeural"
+        )
+        rate = str(cau_hinh.get("tts_rate") or "+0%").strip()
+        self._tts_rate = rate if _MA_TTS_RATE.match(rate) else "+0%"
+        ep = str(cau_hinh.get("audio_endpoint_mac_dinh") or "ha").strip()
+        self._audio_endpoint = ep if ep in _AUDIO_ENDPOINT else "ha"
+        self._cho_phep_ha_goi_di = (
+            str(cau_hinh.get("cho_phep_ha_goi_di") or "tat").strip() == "bat"
+        )
+        self._tu_dong_nghe_may = (
+            str(cau_hinh.get("tu_dong_nghe_may") or "tat").strip() == "bat"
+        )
+        self._da_nap = True
+        self._da_dung = False
+
+    async def cai(self, cau_hinh: dict) -> dict:
+        """Kiểm định dạng cấu hình rồi mới lưu (P0: chỉ kiểm định dạng, KHÔNG
+        kiểm DCs qua mạng, KHÔNG đăng nhập — kiểm DCs đi cùng client thật ở P1).
+        Trả khuôn như telegram-bot: {ok, ket_qua_tung_khoa, loi, cau_hinh_luu}.
+        """
+        cau_hinh = cau_hinh or {}
+
+        def _loi(msg):
+            return {"ok": False, "ket_qua_tung_khoa": [], "loi": msg, "cau_hinh_luu": {}}
+
+        api_id = cau_hinh.get("api_id")
+        api_id_s = str(api_id).strip() if api_id is not None else ""
+        if not api_id_s.isdigit():
+            return _loi("API ID phải là số (lấy ở my.telegram.org).")
+        api_hash = cau_hinh.get("api_hash")
+        api_hash_s = str(api_hash).strip() if api_hash is not None else ""
+        if not _MA_HEX32.match(api_hash_s):
+            return _loi("API hash phải là 32 ký tự hex.")
+        try:
+            dich = _kiem_dich(cau_hinh.get("dich"))
+        except ValueError as e:
+            return _loi(str(e))
+        try:
+            for khoa in _GIOI_HAN_SO:
+                if cau_hinh.get(khoa) is not None:
+                    _kiem_so(cau_hinh.get(khoa), khoa)
+        except ValueError as e:
+            return _loi(str(e))
+        if cau_hinh.get("tts_voice") is not None and not str(
+            cau_hinh.get("tts_voice")
+        ).strip():
+            return _loi("Giọng TTS không được rỗng.")
+        if cau_hinh.get("tts_rate") is not None and not _MA_TTS_RATE.match(
+            str(cau_hinh.get("tts_rate")).strip()
+        ):
+            return _loi("Tốc độ TTS phải dạng +0%, -10%, +15%.")
+        url = cau_hinh.get("ha_webhook_url")
+        if url is not None and str(url).strip():
+            url_s = str(url).strip()
+            if not (url_s.startswith("http://") or url_s.startswith("https://")):
+                return _loi("Webhook HA phải bắt đầu bằng http:// hoặc https://.")
+        ep = cau_hinh.get("audio_endpoint_mac_dinh")
+        if ep is not None and str(ep).strip() not in _AUDIO_ENDPOINT:
+            return _loi("Mic/loa mặc định phải là ha, r1, usb hoặc file.")
+        for khoa in ("cho_phep_ha_goi_di", "tu_dong_nghe_may"):
+            if cau_hinh.get(khoa) is not None and str(cau_hinh.get(khoa)).strip() not in (
+                "bat",
+                "tat",
+            ):
+                return _loi(f"Công tắc «{khoa}» chỉ nhận «bat» hoặc «tat».")
+        da_chuan = {
+            "api_id": api_id_s,
+            "api_hash": api_hash_s,
+            "dich": dich,
+        }
+        for khoa in (
+            list(_GIOI_HAN_SO)
+            + ["tts_voice", "tts_rate", "ha_webhook_url", "ha_webhook_token",
+               "audio_endpoint_mac_dinh", "cho_phep_ha_goi_di", "tu_dong_nghe_may"]
+        ):
+            if cau_hinh.get(khoa) is not None:
+                da_chuan[khoa] = cau_hinh.get(khoa)
+        self.nap(da_chuan)
+        return {
+            "ok": True,
+            "ket_qua_tung_khoa": [
+                {"khoa": "api_id", "ok": True},
+                {"khoa": "api_hash", "ok": True},
+            ],
+            "loi": None,
+            "cau_hinh_luu": da_chuan,
+        }
+
+    async def suc_khoe(self) -> dict:
+        """Sức khỏe theo khuôn chung của lõi. KHÔNG gọi mạng."""
+        da_cau_hinh = bool(self._api_id and self._api_hash)
+        return {
+            "ok": da_cau_hinh,
+            "so_tai_khoan": len(self._phien().danh_sach()),
+            "so_dich": len(self._dich),
+            "che_do": "p0-mock",
+        }
+
+    async def dung(self) -> None:
+        """Dừng module. KHÔNG xóa phiên trên đĩa (restart lõi không mất session)."""
+        self._da_dung = True
+        log.info("telegram-user: đã dừng (phiên trên đĩa giữ nguyên)")
