+++ b/test/test_web2api_telegram_user_p0.py
@@ -0,0 +1,291 @@
+"""Test P0 cho module telegram-user MỚI (khung + mock, chưa gọi/đăng nhập thật).
+
+- manifest hợp chuẩn lõi (kiem_manifest), đủ phương thức theo hợp đồng
+  (kiem_chuan_module), quét AST (scripts/kiem_module.py chạy riêng).
+- cai() chỉ kiểm định dạng, không mạng, không credential thật (mọi chuỗi bí
+  mật trong test đều GIẢ rõ ràng).
+- tich_hop dispatch, kenh_ra/gui_tin mock, hoi_vong mock, phiên TDLib trên đĩa
+  bền qua «restart» (tạo lại Module + nap trên cùng WEB2API_DATA).
+- Không Internet, không tài khoản Telegram thật, không gửi tin/gọi thật.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import importlib.util
+import json
+import logging
+import sys
+import time
+import types
+from pathlib import Path
+
+import pytest
+
+from app.kham_pha import kiem_chuan_module, kiem_manifest
+
+GOC = Path(__file__).resolve().parents[1]
+THU_MUC = GOC / "modules" / "telegram-user"
+TEN_GOI = "telegram_user_p0_mod_test"
+
+API_ID_GIA = "123456"
+API_HASH_GIA = "a" * 32
+TOKEN_WH_GIA = "wh-gia-telegram-user-token-cho-test-0000"
+DICH_GIA = [
+    {"id": "nha", "ten": "Nhà", "peer": "nguoi_dung_gia"},
+    {"id": "khach", "ten": "Phòng khách", "peer": "+840000000000"},
+]
+
+
+@pytest.fixture(autouse=True)
+def _web2api_data(tmp_path, monkeypatch):
+    """Mọi test dùng WEB2API_DATA riêng — không bao giờ chạm /data thật."""
+    monkeypatch.setenv("WEB2API_DATA", str(tmp_path))
+    yield tmp_path
+
+
+def _tai_goi():
+    for ten in [t for t in list(sys.modules) if t == TEN_GOI or t.startswith(TEN_GOI + ".")]:
+        del sys.modules[ten]
+    goi = types.ModuleType(TEN_GOI)
+    goi.__path__ = [str(THU_MUC)]
+    sys.modules[TEN_GOI] = goi
+    spec = importlib.util.spec_from_file_location(f"{TEN_GOI}.module", THU_MUC / "module.py")
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules[f"{TEN_GOI}.module"] = mod
+    spec.loader.exec_module(mod)
+    return mod
+
+
+mod_module = _tai_goi()
+Module = mod_module.Module
+MANIFEST = json.loads((THU_MUC / "manifest.json").read_text(encoding="utf-8"))
+
+
+def _cau_hinh_hop_le(**them):
+    cfg = {"api_id": API_ID_GIA, "api_hash": API_HASH_GIA, "dich": DICH_GIA}
+    cfg.update(them)
+    return cfg
+
+
+def _module_da_cai(**them):
+    mod = Module(MANIFEST)
+    kq = asyncio.run(mod.cai(_cau_hinh_hop_le(**them)))
+    assert kq["ok"] is True
+    return mod
+
+
+def test_manifest_hop_chuan():
+    assert kiem_manifest(json.loads(json.dumps(MANIFEST))) is None
+    assert kiem_chuan_module(MANIFEST["cung_cap"], Module) == {}
+    assert MANIFEST["id"] == "telegram-user"
+    assert MANIFEST["tien_to"] == "telegram_user"
+    assert MANIFEST["hang"] == "A"
+    assert set(MANIFEST["cung_cap"]) == {"kenh_ra", "hoi_vong", "duong_module"}
+    assert MANIFEST["hoi_vong"] == {"chu_ky_giay": 5}
+    assert MANIFEST["duong_module"] == {}
+    assert MANIFEST["yeu_cau_goi"] == ["tdjson", "ntgcalls"]
+    assert MANIFEST["tab_web"] == {"nhan": "Telegram (tài khoản)", "trang": "web/index.html"}
+    assert (THU_MUC / "web" / "index.html").is_file()
+
+
+def test_nap_mac_dinh_va_suc_khoe_chua_cau_hinh():
+    mod = Module(MANIFEST)
+    mod.nap({})
+    sk = asyncio.run(mod.suc_khoe())
+    assert sk["ok"] is False
+    assert sk["so_tai_khoan"] == 0
+    assert sk["so_dich"] == 0
+    assert sk["che_do"] == "p0-mock"
+    assert mod.kenh_ra() == []
+
+
+def test_cai_thieu_va_sai():
+    mod = Module(MANIFEST)
+    assert asyncio.run(mod.cai({}))["ok"] is False
+    assert asyncio.run(mod.cai({"api_id": API_ID_GIA}))["ok"] is False
+    assert asyncio.run(mod.cai({"api_id": "abc", "api_hash": API_HASH_GIA}))["ok"] is False
+    assert asyncio.run(mod.cai({"api_id": API_ID_GIA, "api_hash": "ngan"}))["ok"] is False
+    assert asyncio.run(mod.cai({"api_id": API_ID_GIA, "api_hash": API_HASH_GIA, "dich": "{hong"}))["ok"] is False
+    assert asyncio.run(mod.cai({"api_id": API_ID_GIA, "api_hash": API_HASH_GIA, "dich": [{"id": "x"}]}))["ok"] is False
+    assert asyncio.run(mod.cai({"api_id": API_ID_GIA, "api_hash": API_HASH_GIA, "ring_timeout": "1"}))["ok"] is False
+    assert asyncio.run(mod.cai({"api_id": API_ID_GIA, "api_hash": API_HASH_GIA, "ha_webhook_url": "ftp://x"}))["ok"] is False
+    assert asyncio.run(mod.cai({"api_id": API_ID_GIA, "api_hash": API_HASH_GIA, "audio_endpoint_mac_dinh": "la"}))["ok"] is False
+    assert asyncio.run(mod.cai({"api_id": API_ID_GIA, "api_hash": API_HASH_GIA, "cho_phep_ha_goi_di": "co"}))["ok"] is False
+    # cai() thất bại không để lại cấu hình nửa vời
+    assert asyncio.run(mod.suc_khoe())["ok"] is False
+
+
+def test_cai_hop_le_va_kenh_ra_khong_lo_bi_mat():
+    mod = Module(MANIFEST)
+    kq = asyncio.run(mod.cai(_cau_hinh_hop_le()))
+    assert kq["ok"] is True
+    assert kq["loi"] is None
+    assert kq["ket_qua_tung_khoa"] == [
+        {"khoa": "api_id", "ok": True},
+        {"khoa": "api_hash", "ok": True},
+    ]
+    # ket_qua_tung_khoa chỉ có tên trường, không giá trị bí mật
+    assert API_HASH_GIA not in json.dumps(kq["ket_qua_tung_khoa"])
+    assert asyncio.run(mod.suc_khoe())["ok"] is True
+    assert mod.kenh_ra() == [
+        {"id": "nha", "ten": "Nhà"},
+        {"id": "khach", "ten": "Phòng khách"},
+    ]
+    # kenh_ra không chứa peer thô
+    assert "nguoi_dung_gia" not in json.dumps(mod.kenh_ra())
+
+
+def test_gui_tin_mock():
+    mod = Module(MANIFEST)
+    assert asyncio.run(mod.gui_tin({"kenh_id": "nha"}, {"van_ban": "xin chao"})) == {
+        "ok": False,
+        "ma": "chua_cau_hinh",
+    }
+    mod = _module_da_cai()
+    assert asyncio.run(mod.gui_tin({}, {"van_ban": "x"})) == {"ok": False, "ma": "thieu_kenh_id"}
+    assert asyncio.run(mod.gui_tin({"kenh_id": "la"}, {"van_ban": "x"})) == {"ok": False, "ma": "kenh_khong_co"}
+    assert asyncio.run(mod.gui_tin({"kenh_id": "nha"}, {"van_ban": "  "})) == {"ok": False, "ma": "noi_dung_rong"}
+    assert asyncio.run(mod.gui_tin({"kenh_id": "nha"}, {"van_ban": "x" * (17 * 1024)})) == {
+        "ok": False,
+        "ma": "noi_dung_qua_dai",
+    }
+    assert asyncio.run(mod.gui_tin({"kenh_id": "nha"}, {"van_ban": "t", "_tep": {}})) == {
+        "ok": False,
+        "ma": "tep_chua_ho_tro",
+    }
+    kq = asyncio.run(mod.gui_tin({"kenh_id": "nha"}, {"van_ban": "tin mock"}))
+    assert kq["ok"] is True and isinstance(kq["tin_id"], str)
+    assert len(mod._hop_thu_di) == 1
+    assert mod._hop_thu_di[0]["peer"] == "nguoi_dung_gia"
+
+
+def test_tich_hop_health_accounts_khong_lo_bi_mat():
+    mod = _module_da_cai()
+    ma, _, nd = asyncio.run(mod.tich_hop("health", "GET", {}, None, "http://localhost"))
+    assert ma == 200
+    assert nd["status"] == "ok"
+    assert nd["version"] == "0.1.0"
+    assert nd["accounts_total"] == 0 and nd["accounts_online"] == 0
+    ma, _, nd = asyncio.run(mod.tich_hop("accounts", "GET", {}, None, "http://localhost"))
+    assert ma == 200 and nd == {"tai_khoan": []}
+    mod._them_tai_khoan_mock("Tài khoản mock", "nguoi_dung_gia")
+    ma, _, nd = asyncio.run(mod.tich_hop("accounts", "GET", {}, None, "http://localhost"))
+    assert ma == 200 and len(nd["tai_khoan"]) == 1
+    tk = nd["tai_khoan"][0]
+    assert tk["display_name"] == "Tài khoản mock"
+    assert tk["status"] == "mock"
+    # phản hồi không chứa bí mật
+    assert API_HASH_GIA not in json.dumps(nd)
+    assert API_ID_GIA not in json.dumps(nd)
+
+
+def test_tich_hop_send_message_va_events():
+    mod = _module_da_cai()
+    ma, _, nd = asyncio.run(
+        mod.tich_hop("send_message", "POST", {}, {"peer": "p", "message": "m"}, "http://localhost")
+    )
+    assert ma == 503 and nd["error"]["code"] == "ACCOUNT_OFFLINE"
+    tk = mod._them_tai_khoan_mock("Tài khoản mock", "nguoi_dung_gia")
+    ma, _, nd = asyncio.run(
+        mod.tich_hop("send_message", "POST", {}, {"peer": "p", "message": "m"}, "http://localhost")
+    )
+    assert ma == 200 and nd["ok"] is True and nd["account"] == tk["id"]
+    ma, _, nd = asyncio.run(
+        mod.tich_hop("send_message", "POST", {}, {"message": "m"}, "http://localhost")
+    )
+    assert ma == 400 and nd["error"]["code"] == "PEER_THIEU"
+    ma, _, nd = asyncio.run(
+        mod.tich_hop("send_message", "POST", {}, {"peer": "p"}, "http://localhost")
+    )
+    assert ma == 400 and nd["error"]["code"] == "MESSAGE_THIEU"
+    ma, _, nd = asyncio.run(
+        mod.tich_hop("send_message", "POST", {}, {"peer": "p", "message": "m", "account": "tk-khong-co"}, "http://localhost")
+    )
+    assert ma == 404 and nd["error"]["code"] == "ACCOUNT_KHONG_CO"
+    # events: poll fallback theo cursor
+    mod._them_su_kien_mock("message_new", tk["id"], {"van_ban": "mot"})
+    mod._them_su_kien_mock("message_new", tk["id"], {"van_ban": "hai"})
+    ma, _, nd = asyncio.run(mod.tich_hop("events", "GET", {}, None, "http://localhost"))
+    assert ma == 200 and len(nd["events"]) == 2 and nd["cursor"] == 2
+    ma, _, nd = asyncio.run(mod.tich_hop("events", "GET", {"since": "1"}, None, "http://localhost"))
+    assert ma == 200 and len(nd["events"]) == 1 and nd["events"][0]["id"] == 2
+    ma, _, nd = asyncio.run(mod.tich_hop("events", "GET", {"since": "abc"}, None, "http://localhost"))
+    assert ma == 400 and nd["error"]["code"] == "SINCE_SAI"
+
+
+def test_tich_hop_404_405_501_va_luong_stub():
+    mod = _module_da_cai()
+    ma, _, nd = asyncio.run(mod.tich_hop("khong-co", "GET", {}, None, "http://localhost"))
+    assert ma == 404 and nd["error"]["code"] == "DUONG_KHONG_CO"
+    ma, _, nd = asyncio.run(mod.tich_hop("health", "POST", {}, {}, "http://localhost"))
+    assert ma == 405
+    ma, _, nd = asyncio.run(mod.tich_hop("send_message", "POST", {}, "khong-phai-dict", "http://localhost"))
+    assert ma == 400 and nd["error"]["code"] == "THAN_SAI_KHUON"
+    ma, _, nd = asyncio.run(mod.tich_hop("call", "POST", {}, {"peer": "p"}, "http://localhost"))
+    assert ma == 501 and nd["error"]["giai_doan"] == "P1"
+    ma, _, nd = asyncio.run(mod.tich_hop("answer_call", "POST", {}, {"call_id": "c"}, "http://localhost"))
+    assert ma == 501 and nd["error"]["giai_doan"] == "P3"
+    ma, _, nd = asyncio.run(mod.tich_hop("audio/in", "POST", {}, {"call_id": "c"}, "http://localhost"))
+    assert ma == 501 and nd["error"]["giai_doan"] == "P2"
+    ma, _, nd = asyncio.run(mod.tich_hop("history", "GET", {}, None, "http://localhost"))
+    assert ma == 501 and nd["error"]["giai_doan"] == "P4"
+    assert asyncio.run(mod.luong("ve-gia", None, "GET")) == (404, {}, b"")
+
+
+def test_hoi_vong_drain_va_khuon():
+    mod = _module_da_cai()
+    mod._them_tin_mock("nguoi-a", "nhom-x", "tin mot")
+    mod._them_tin_mock("nguoi-b", "nhom-x", "tin hai")
+    mod._hop_thu_den.append({"id_tin": "thieu", "nguoi_gui": "c"})  # sai khuôn → bỏ
+    ds = asyncio.run(mod.hoi_vong())
+    assert len(ds) == 2
+    for tin in ds:
+        assert set(tin) == {"id_tin", "nguoi_gui", "noi_gui", "van_ban"}
+    assert asyncio.run(mod.hoi_vong()) == []
+
+
+def test_phien_ben_qua_restart_va_quyen_tep():
+    mod1 = _module_da_cai()
+    tk = mod1._them_tai_khoan_mock("Tài khoản mock", "nguoi_dung_gia")
+    kho1 = mod1._phien().tao_khoa(tk["id"])
+    tep_khoa = Path(mod1._phien().goc) / "tdlib" / tk["id"] / "khoa"
+    thu_muc_tk = Path(mod1._phien().goc) / "tdlib" / tk["id"]
+    assert oct(tep_khoa.stat().st_mode & 0o777) == "0o600"
+    assert oct(thu_muc_tk.stat().st_mode & 0o777) == "0o700"
+    assert oct((thu_muc_tk / "files").stat().st_mode & 0o777) == "0o700"
+    asyncio.run(mod1.dung())  # dừng KHÔNG xóa phiên
+    mod2 = _module_da_cai()
+    ds = mod2._phien().danh_sach()
+    assert len(ds) == 1 and ds[0]["id"] == tk["id"]
+    assert mod2._phien().tao_khoa(tk["id"]) == kho1  # khóa không đổi qua restart
+    ma, _, nd = asyncio.run(mod2.tich_hop("accounts", "GET", {}, None, "http://localhost"))
+    assert len(nd["tai_khoan"]) == 1
+
+
+def test_su_kien_duoi_5_giay():
+    mod = _module_da_cai()
+    tk = mod._them_tai_khoan_mock("Tài khoản mock", "nguoi_dung_gia")
+    mod._them_su_kien_mock("message_new", tk["id"], {"van_ban": "gap"})
+    bat_dau = time.monotonic()
+    ma, _, nd = asyncio.run(mod.tich_hop("events", "GET", {}, None, "http://localhost"))
+    assert time.monotonic() - bat_dau < 5.0
+    assert ma == 200 and len(nd["events"]) == 1
+
+
+def test_goi_pin_tdjson_ntgcalls():
+    import importlib.metadata
+
+    assert importlib.metadata.version("tdjson") == "1.8.69"
+    assert importlib.metadata.version("ntgcalls") == "3.0.6"
+    assert mod_module._nap_tdjson().__name__ == "tdjson"
+    assert mod_module._nap_ntgcalls().__name__ == "ntgcalls"
+
+
+def test_log_khong_lo_bi_mat(caplog):
+    mod = _module_da_cai()
+    logger = logging.getLogger("telegram-user")
+    with caplog.at_level(logging.WARNING, logger="telegram-user"):
