@@ -0,0 +1,710 @@
+"""Module telegram-user — P0 khung + mock (theo thiết kế sửa đổi telegram-w2a-module).
+
+P0 CHƯA làm: đăng nhập thật (OTP/2FA/QR), gửi tin thật, gọi thật, webhook
+đẩy event thật, luồng audio thật. Mọi đường gọi/nhận/audio trả 501 với giai
+đoạn tương ứng; gửi tin qua /m và /api/gui chỉ ghi vào hộp thư mock trong bộ
+nhớ để kiểm dispatch; tài khoản mock chỉ để kiểm phiên bền qua restart.
+
+Phiên TDLib (mục 7.5 thiết kế): thư mục files + khóa mã hóa local cho mỗi tài
+khoản, dưới <WEB2API_DATA>/telegram-user/tdlib/<id>/ — cùng quy ước gốc dữ
+liệu của lõi (kho.py: WEB2API_DATA, mặc định /data). Đây là lựa chọn của P0,
+cần chốt với lõi lúc triển khai (thiết kế ghi rõ đường dẫn này chưa xác minh).
+
+Bí mật (api_id, api_hash, token webhook, khóa phiên) không bao giờ vào log,
+phản hồi hay nhật ký: bộ lọc _LocBiMat che giá trị đã biết, và mã tránh log
+bí mật ngay từ đầu. Tài khoản qua /m chỉ trả trường công khai (id, phone,
+display_name, status) — không api_id/api_hash/khóa.
+
+Gói tdjson/ntgcalls chỉ nạp lười trong _nap_tdjson/_nap_ntgcalls (P1 mới dùng
+để tạo client thật); P0 chỉ kiểm import được. Cả hai đều khai trong
+yeu_cau_goi nên lõi từ chối nạp sạch (LoiNap «thiếu gói») trên máy chưa cài
+wheel — đó là hợp đồng của lõi, không phải lỗi module.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import os
+import re
+import secrets
+import shutil
+import time
+import uuid
+from pathlib import Path
+
+PHIEN_BAN = "0.1.0"
+_MA_TK = re.compile(r"^[a-z0-9][a-z0-9_-]{1,40}$")
+_MA_HEX32 = re.compile(r"^[0-9a-fA-F]{32}$")
+_MA_TTS_RATE = re.compile(r"^[+-]\d+%$")
+_MAC_DINH_SO = {
+    "ring_timeout": 45,
+    "ring_attempts": 2,
+    "ring_interval": 15,
+    "max_call_seconds": 180,
+    "queue_timeout": 120,
+    "queue_depth": 10,
+}
+_GIOI_HAN_SO = {
+    "ring_timeout": (5, 300),
+    "ring_attempts": (1, 5),
+    "ring_interval": (5, 120),
+    "max_call_seconds": (30, 3600),
+    "queue_timeout": (10, 600),
+    "queue_depth": (1, 50),
+}
+_AUDIO_ENDPOINT = {"ha", "r1", "usb", "file"}
+_GIOI_HAN_SU_KIEN = 10000
+_GIOI_HAN_NOI_DUNG = 16 * 1024  # khớp trần lõi cho /api/gui
+_TUYEN_501 = {
+    "call": ("POST", "P1"),
+    "answer_call": ("POST", "P3"),
+    "hangup_call": ("POST", "P1"),
+    "calls": ("GET", "P1"),
+    "history": ("GET", "P4"),
+    "contacts": ("GET", "P4"),
+    "groups": ("GET", "P4"),
+    "send_media": ("POST", "P4"),
+    "send_voice": ("POST", "P4"),
+    "audio/in": ("POST", "P2"),
+    "audio/stream-url": ("POST", "P2"),
+    "audio/upload": ("POST", "P2"),
+}
+
+
+class _LocBiMat(logging.Filter):
+    """Che giá trị bí mật đã biết khỏi bản ghi log (phòng thủ sâu)."""
+
+    def __init__(self):
+        super().__init__()
+        self._gia_tri = set()
+
+    def them(self, gia_tri):
+        if isinstance(gia_tri, str) and len(gia_tri) >= 4:
+            self._gia_tri.add(gia_tri)
+
+    def filter(self, record):
+        try:
+            msg = record.getMessage()
+        except Exception:
+            return True
+        for gia_tri in self._gia_tri:
+            if gia_tri in msg:
+                msg = msg.replace(gia_tri, "••••")
+        record.msg = msg
+        record.args = ()
+        return True
+
+
+_LOC = _LocBiMat()
+log = logging.getLogger("telegram-user")
+log.addFilter(_LOC)
+
+
+def _nap_tdjson():
+    """Nạp tdjson (báo hiệu TDLib, phương án B). P1 dùng để tạo client thật;
+    P0 chỉ kiểm import được. Gói khai trong yeu_cau_goi."""
+    import tdjson
+
+    return tdjson
+
+
+def _nap_ntgcalls():
+    """Nạp ntgcalls (media cho gọi 1-1). P1 dùng cho gọi thật; P0 chỉ kiểm
+    import được. Gói khai trong yeu_cau_goi."""
+    import ntgcalls
+
+    return ntgcalls
+
+
+def _kiem_dich(gia_tri):
+    """Thẩm định danh sách đích gửi nhanh. Trả danh sách chuẩn hóa
+    [{id, ten, peer}]; sai khuôn → ValueError với thông điệp rõ ràng."""
+    if gia_tri is None or gia_tri == "":
+        return []
+    if isinstance(gia_tri, str):
+        try:
+            gia_tri = json.loads(gia_tri)
+        except ValueError:
+            raise ValueError("Trường «dich» phải là JSON hợp lệ.") from None
+    if not isinstance(gia_tri, list):
+        raise ValueError("Trường «dich» phải là danh sách.")
+    ds = []
+    thay = set()
+    for muc in gia_tri:
+        if not isinstance(muc, dict):
+            raise ValueError("Mỗi đích trong «dich» phải là đối tượng.")
+        id_muc = muc.get("id")
+        if not isinstance(id_muc, str) or not id_muc.strip():
+            raise ValueError("Mỗi đích cần «id» khác rỗng.")
+        if id_muc in thay:
+            raise ValueError(f"Trùng id đích: {id_muc}.")
+        peer = muc.get("peer")
+        if isinstance(peer, int):
+            peer = str(peer)
+        if not isinstance(peer, str) or not peer.strip():
+            raise ValueError(f"Đích {id_muc} cần «peer» khác rỗng.")
+        thay.add(id_muc)
+        ds.append({"id": id_muc, "ten": muc.get("ten") or id_muc, "peer": peer.strip()})
+    return ds
+
+
+def _doc_so(gia_tri, mac_dinh):
+    """Đọc số cho nap() (lỏng: sai → mặc định, không sập module)."""
+    try:
+        return int(str(gia_tri).strip())
+    except (TypeError, ValueError):
+        return mac_dinh
+
+
+def _kiem_so(gia_tri, khoa):
+    """Kiểm số chặt cho cai(): phải là số nguyên trong khoảng cho phép."""
+    try:
+        so = int(str(gia_tri).strip())
+    except (TypeError, ValueError):
+        raise ValueError(f"Trường «{khoa}» phải là số nguyên.") from None
+    nho, lon = _GIOI_HAN_SO[khoa]
+    if not nho <= so <= lon:
+        raise ValueError(f"Trường «{khoa}» phải trong khoảng {nho}–{lon}.")
+    return so
+
+
+def _ghi_nguyen_tu(tep: Path, du_lieu: bytes, quyen: int = 0o600) -> None:
+    """Ghi nguyên tử (tệp tạm + đổi tên), quyền 0600 mặc định."""
+    tep.parent.mkdir(parents=True, exist_ok=True)
+    tam = tep.with_name(tep.name + ".tam")
+    tam.write_bytes(du_lieu)
+    os.chmod(tam, quyen)
+    os.replace(tam, tep)
+
+
+def _ban_ghi_cong_khai(ban_ghi: dict) -> dict:
+    """Dạng công khai của một tài khoản cho đường /m (không bí mật).
+
+    P0 mock: trường «phone» mang giá trị peer đã khai (tên người dùng/số/id)
+    theo đúng hình dạng thiết kế; tài khoản TDLib thật ở P1 mới có số thật.
+    """
+    return {
+        "id": ban_ghi.get("id"),
+        "phone": ban_ghi.get("peer"),
+        "display_name": ban_ghi.get("ten"),
+        "status": ban_ghi.get("trang_thai"),
+    }
