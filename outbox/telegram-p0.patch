+    # ── kenh_ra (/api/gui) ─────────────────────────────────────────────
+    def kenh_ra(self) -> list:
+        """Danh sách đích — KHÔNG chứa bí mật, KHÔNG chứa peer thô."""
+        return [{"id": d["id"], "ten": d["ten"]} for d in self._dich.values()]
+
+    async def gui_tin(self, dich: dict, noi_dung: dict) -> dict:
+        """Gửi văn bản tới đích đã khai (P0: ghi hộp thư mock, không gửi thật).
+        Trả {"ok": bool thật, "ma"?: mã ngắn} theo khuôn lõi bắt buộc."""
+        if not self._api_id or not self._api_hash or not self._dich:
+            return {"ok": False, "ma": "chua_cau_hinh"}
+        dich = dich or {}
+        kenh_id = dich.get("kenh_id")
+        kenh_id = kenh_id.strip() if isinstance(kenh_id, str) else ""
+        if not kenh_id:
+            return {"ok": False, "ma": "thieu_kenh_id"}
+        muc = self._dich.get(kenh_id)
+        if muc is None:
+            return {"ok": False, "ma": "kenh_khong_co"}
+        noi_dung = noi_dung or {}
+        if noi_dung.get("_tep") is not None:
+            return {"ok": False, "ma": "tep_chua_ho_tro"}
+        van_ban = noi_dung.get("van_ban")
+        if not isinstance(van_ban, str) or not van_ban.strip():
+            return {"ok": False, "ma": "noi_dung_rong"}
+        if len(van_ban.encode("utf-8")) > _GIOI_HAN_NOI_DUNG:
+            return {"ok": False, "ma": "noi_dung_qua_dai"}
+        tin_id = uuid.uuid4().hex
+        self._hop_thu_di.append(
+            {
+                "tin_id": tin_id,
+                "kenh_id": kenh_id,
+                "peer": muc["peer"],
+                "van_ban": van_ban,
+                "luc": time.time(),
+            }
+        )
+        log.info("telegram-user: [mock] ghi tin %s tới đích %s", tin_id[:8], kenh_id)
+        return {"ok": True, "tin_id": tin_id}
+
+    # ── hoi_vong (tin vào) ─────────────────────────────────────────────
+    async def hoi_vong(self) -> list:
+        """Kéo tin vào theo chuẩn lõi (P0: xả hộp thư mock do test nạp).
+        Tin trả về đủ 4 trường bắt buộc: id_tin, nguoi_gui, noi_gui, van_ban.
+        Lõi gọi kèm timeout = min(max(chu_ky_giay*2, 30), 60); lỗi không lan
+        module khác (lõi tự lùi chu kỳ)."""
+        ds = self._hop_thu_den
+        self._hop_thu_den = []
+        hop_le = []
+        for tin in ds:
+            if not isinstance(tin, dict):
+                continue
+            if not all(
+                isinstance(tin.get(k), str) and tin.get(k)
+                for k in ("id_tin", "nguoi_gui", "noi_gui", "van_ban")
+            ):
+                log.warning("telegram-user: bỏ tin mock sai khuôn")
+                continue
+            hop_le.append(
+                {
+                    "id_tin": tin["id_tin"],
+                    "nguoi_gui": tin["nguoi_gui"],
+                    "noi_gui": tin["noi_gui"],
+                    "van_ban": tin["van_ban"],
+                }
+            )
+        return hop_le
+
+    # ── duong_module (/m) ──────────────────────────────────────────────
+    async def tich_hop(self, duong, phuong_thuc, query, than, goc):
+        """Dispatch đường /m/telegram-user/api/<duong>.
+
+        Lõi đã làm trước khi tới đây: xác thực khoá khách (phạm vi
+        tich_hop@telegram-user), LAN-only, thân POST ≤ 400.000 byte và phải là
+        dict JSON. Module chỉ còn dispatch + kiểm tham số. Giới hạn tốc độ
+        120 req/phút/khoá trong thiết kế KHÔNG thực thi được ở tầng module vì
+        lõi không truyền danh tính khoá vào tich_hop (xem báo cáo P0, D-P0-1);
+        đường /api/gui vẫn chịu trần 20 tin/phút/khoá của lõi.
+        """
+        duong = (duong or "").strip().strip("/")
+        phuong_thuc = (phuong_thuc or "GET").upper()
+        bang = {
+            "health": {"GET": self._duong_health},
+            "accounts": {"GET": self._duong_accounts},
+            "send_message": {"POST": self._duong_send_message},
+            "events": {"GET": self._duong_events},
+        }
+        if duong in _TUYEN_501:
+            phuong_thuc_cho, giai_doan = _TUYEN_501[duong]
+            if phuong_thuc != phuong_thuc_cho:
+                return 405, {}, {
+                    "error": {
+                        "code": "PHUONG_THUC_KHONG_HO_TRO",
+                        "message": f"Đường {duong} chỉ nhận {phuong_thuc_cho}.",
+                    }
+                }
+            return 501, {}, {
+                "error": {
+                    "code": "CHUA_CO",
+                    "message": f"Đường này thuộc giai đoạn {giai_doan}, chưa có ở P0.",
+                    "giai_doan": giai_doan,
+                }
+            }
+        if duong not in bang:
+            return 404, {}, {
+                "error": {
+                    "code": "DUONG_KHONG_CO",
+                    "message": f"Không có đường {duong}.",
+                }
+            }
+        if phuong_thuc not in bang[duong]:
+            return 405, {}, {
+                "error": {
+                    "code": "PHUONG_THUC_KHONG_HO_TRO",
+                    "message": f"Đường {duong} không nhận {phuong_thuc}.",
+                }
+            }
+        if phuong_thuc == "POST" and not isinstance(than, dict):
+            return 400, {}, {
+                "error": {
+                    "code": "THAN_SAI_KHUON",
+                    "message": "Thân POST phải là đối tượng JSON.",
+                }
+            }
+        return await bang[duong][phuong_thuc](query or {}, than or {})
+
+    async def _duong_health(self, query, than):
+        tai_khoan = self._phien().danh_sach()
+        return 200, {}, {
+            "status": "ok" if (self._api_id and self._api_hash) else "chua_cau_hinh",
+            "version": self.manifest.get("phien_ban", PHIEN_BAN),
+            "accounts_total": len(tai_khoan),
+            "accounts_online": sum(
+                1 for t in tai_khoan if t.get("da_dang_nhap")
+            ),
+        }
+
+    async def _duong_accounts(self, query, than):
+        """CHỈ ĐỌC. Không có đường thêm tài khoản/mã/2FA qua HA — đăng nhập
+        chỉ ở tab module (luật thiết kế)."""
+        return 200, {}, {
+            "tai_khoan": [
+                _ban_ghi_cong_khai(t) for t in self._phien().danh_sach()
+            ]
+        }
+
+    async def _duong_send_message(self, query, than):
+        """Thân {account?, peer, message, quote_message_id?, ttl?} (thiết kế
+        4.2). P0: ghi hộp thư mock, không gửi thật."""
+        peer = than.get("peer")
+        if not isinstance(peer, str) or not peer.strip():
+            return 400, {}, {
+                "error": {
+                    "code": "PEER_THIEU",
+                    "message": "Thân cần «peer» khác rỗng.",
+                }
+            }
+        message = than.get("message")
+        if not isinstance(message, str) or not message.strip():
+            return 400, {}, {
+                "error": {
+                    "code": "MESSAGE_THIEU",
+                    "message": "Thân cần «message» khác rỗng.",
+                }
+            }
+        if len(message.encode("utf-8")) > _GIOI_HAN_NOI_DUNG:
+            return 400, {}, {
+                "error": {
+                    "code": "MESSAGE_QUA_DAI",
+                    "message": "Nội dung vượt 16 KiB.",
+                }
+            }
+        tai_khoan = self._phien().danh_sach()
+        account = than.get("account")
+        if account is not None:
+            if self._phien().lay(str(account)) is None:
+                return 404, {}, {
+                    "error": {
+                        "code": "ACCOUNT_KHONG_CO",
+                        "message": "Không có tài khoản này.",
+                    }
+                }
+            account_id = str(account)
+        elif tai_khoan:
+            account_id = tai_khoan[0]["id"]
+        else:
+            return 503, {}, {
+                "error": {
+                    "code": "ACCOUNT_OFFLINE",
+                    "message": "Chưa có tài khoản nào.",
+                }
+            }
+        tin_id = uuid.uuid4().hex
+        self._hop_thu_di.append(
+            {
+                "tin_id": tin_id,
+                "kenh_id": None,
+                "account": account_id,
+                "peer": peer.strip(),
+                "van_ban": message,
+                "luc": time.time(),
+            }
+        )
+        log.info("telegram-user: [mock] ghi tin %s tới peer qua /m", tin_id[:8])
+        return 200, {}, {
+            "ok": True,
+            "tin_id": tin_id,
+            "account": account_id,
+            "peer": peer.strip(),
+        }
+
+    async def _duong_events(self, query, than):
+        """Poll fallback: {events, cursor}. since lọc id > since (đơn điệu)."""
+        since_raw = query.get("since") if isinstance(query, dict) else None
+        if isinstance(since_raw, list):
+            since_raw = since_raw[0] if since_raw else None
+        try:
+            since = int(str(since_raw).strip()) if since_raw is not None else 0
+        except (TypeError, ValueError):
+            return 400, {}, {
+                "error": {
+                    "code": "SINCE_SAI",
+                    "message": "Tham số «since» phải là số nguyên.",
+                }
+            }
+        su_kien = [e for e in self._su_kien if e["id"] > since]
+        cursor = self._su_kien[-1]["id"] if self._su_kien else 0
+        return 200, {}, {"events": su_kien, "cursor": cursor}
+
+    async def luong(self, ve, khoang, phuong_thuc):
+        """Stub luồng (P2 mới có audio thật): mọi vé đều 404."""
+        return 404, {}, b""
+
+    # ── móc mock cho P0 (test + tab demo; P1 thay bằng TDLib thật) ─────
+    def _them_tai_khoan_mock(self, ten: str, peer: str) -> dict:
+        """Thêm tài khoản mock qua tab (P0). Trả bản ghi công khai."""
+        ban_ghi = self._phien().them_tai_khoan(ten, peer)
+        khoa = self._phien().tao_khoa(ban_ghi["id"])
+        _LOC.them(khoa)
+        return _ban_ghi_cong_khai(ban_ghi)
+
+    def _them_tin_mock(self, nguoi_gui: str, noi_gui: str, van_ban: str) -> dict:
+        tin = {
+            "id_tin": uuid.uuid4().hex,
+            "nguoi_gui": nguoi_gui,
+            "noi_gui": noi_gui,
+            "van_ban": van_ban,
+        }
+        self._hop_thu_den.append(tin)
+        return tin
+
+    def _them_su_kien_mock(self, loai: str, tai_khoan: str, du_lieu: dict) -> dict:
+        su_kien = {
+            "id": self._su_kien_tiep,
+            "type": loai,
+            "account": tai_khoan,
+            "timestamp": int(time.time()),
+            "data": du_lieu if isinstance(du_lieu, dict) else {},
+        }
+        self._su_kien_tiep += 1
+        self._su_kien.append(su_kien)
+        if len(self._su_kien) > _GIOI_HAN_SU_KIEN:
+            del self._su_kien[: len(self._su_kien) - _GIOI_HAN_SU_KIEN]
+        return su_kien
