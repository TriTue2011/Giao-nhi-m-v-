+
+
+@api_router.put("/mat-khau-vnc")
+async def api_dat_mat_khau_vnc(request: Request):
+    """NV305: đặt mật khẩu xem trình duyệt. Chỉ quản trị, bắt buộc step-up (phiên web phải xác nhận lại;
