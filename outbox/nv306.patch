diff --git a/apk/nguon/src/vn/r1/bodam/KhoiDongLai.java b/apk/nguon/src/vn/r1/bodam/KhoiDongLai.java
new file mode 100644
index 0000000..77a0250
--- /dev/null
+++ b/apk/nguon/src/vn/r1/bodam/KhoiDongLai.java
@@ -0,0 +1,155 @@
+package vn.r1.bodam;
+
+import android.util.Log;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.InetSocketAddress;
+import java.net.Socket;
+import java.util.Random;
+
+/**
+ * Khoi dong lai loa qua APK (NV306): HA gui {"type":"khoi_dong_lai"} qua ket noi mic,
+ * APK chuyen tiep toi dich vu shell cuc bo cua loa qua websocket localhost:8080 — KHONG
+ * dung ADB mang, khong tu mo ADB.
+ *
+ * APK KHONG the tu reboot truc tiep: quyen REBOOT chi he thong co (xem docs/HOP-DONG-PHIA-LOA.md:
+ * "reboot" va "setprop sys.powerctl reboot" bi bo qua lang le ngay ca duoi uid system). Co che dung
+ * duoc duy nhat da chung minh: dich vu shell o cong 8080 (uid system) thuc hien lenh cua app AI box
+ * "stop adbd&&start adbd&&adb reboot" — cung khung "shell" ma HA gui truc tiep o client.py
+ * (reboot_shell, da kiem tren loa that 28/10/2026). APK o day chi la nguoi chuyen tiep tu ket noi
+ * mic sang localhost:8080; chan HA->APK la TCP mic, chan APK->8080 la loopback — khong chan nao
+ * la ADB mang (cong 5555).
+ *
+ * Phan thuan (tao khoa, handshake, khung, chuyenTiep) chi dung java.* de test duoc tren JVM;
+ * chi batDau() dung android.util.Log (chi chay tren loa that, test thuan khong goi no).
+ */
+public final class KhoiDongLai {
+    private KhoiDongLai() { }
+
+    /** Khung HA gui xuong (dinh dang CO DINH, json.dumps tach gon nhu cac lenh khac). */
+    public static final String LENH = "{\"type\":\"khoi_dong_lai\"}";
+
+    /** Cung lenh voi client.py REBOOT_SHELL: giu dong bo khi doi mot trong hai cho. */
+    public static final String SHELL = "stop adbd&&start adbd&&adb reboot";
+
+    /** Cong dich vu shell cua loa (cung cong HA dung o client.py). */
+    public static final int CONG = 8080;
+
+    /** Timeout ket noi/doc phan hoi handshake (ms). */
+    public static final int TIMEOUT_MS = 5000;
+
+    private static final String BANG_B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+    /** Dung khung lenh khoi dong lai (chi dung mot dang duy nhat, sai dang bi bo qua). */
+    public static boolean laLenh(String khung) {
+        return LENH.equals(khung);
+    }
+
+    /** Khung "shell" gui toi dich vu 8080 — giong het khung HA gui o client.py (phang, khong kem "data"). */
+    public static String taoKhungShell() {
+        return "{\"type\":\"shell\",\"type_id\":\"ha\",\"shell\":\"" + SHELL + "\"}";
+    }
+
+    /** Ma Base64 thu cong: android.jar API 22 khong co java.util.Base64. */
+    public static String maBase64(byte[] duLieu) {
+        StringBuilder b = new StringBuilder();
+        for (int i = 0; i < duLieu.length; i += 3) {
+            int a = duLieu[i] & 0xFF;
+            int c = i + 1 < duLieu.length ? duLieu[i + 1] & 0xFF : 0;
+            int d = i + 2 < duLieu.length ? duLieu[i + 2] & 0xFF : 0;
+            b.append(BANG_B64.charAt(a >> 2));
+            b.append(BANG_B64.charAt(((a & 0x03) << 4) | (c >> 4)));
+            b.append(i + 1 < duLieu.length ? BANG_B64.charAt(((c & 0x0F) << 2) | (d >> 6)) : '=');
+            b.append(i + 2 < duLieu.length ? BANG_B64.charAt(d & 0x3F) : '=');
+        }
+        return b.toString();
+    }
+
+    /** Yeu cau handshake WebSocket (RFC 6455) toi dich vu 8080. */
+    public static String taoYeuCau(String host, int cong, String khoa) {
+        return "GET / HTTP/1.1\r\n"
+                + "Host: " + host + ":" + cong + "\r\n"
+                + "Upgrade: websocket\r\n"
+                + "Connection: Upgrade\r\n"
+                + "Sec-WebSocket-Key: " + khoa + "\r\n"
+                + "Sec-WebSocket-Version: 13\r\n"
+                + "\r\n";
+    }
+
+    /** Khung van ban WebSocket tu client (BAT BUOC co mask): 0x81 + do dai + mask + payload da mask. */
+    public static byte[] taoKhung(String payload, byte[] mask) throws IOException {
+        byte[] p = payload.getBytes("UTF-8");
+        if (p.length >= 126) throw new IOException("payload qua dai cho khung don: " + p.length);
+        ByteArrayOutputStream b = new ByteArrayOutputStream();
+        b.write(0x81);
+        b.write(0x80 | p.length);
+        b.write(mask, 0, 4);
+        for (int i = 0; i < p.length; i++) b.write(p[i] ^ mask[i % 4]);
+        return b.toByteArray();
+    }
+
+    /**
+     * Chuyen tiep lenh khoi dong lai toi dich vu shell cuc bo. null = da gui xong;
+     * con lai = ly do (de luong goi ghi log, khong nem loi ra ngoai).
+     */
+    public static String chuyenTiep(String host, int cong) {
+        Socket s = new Socket();
+        try {
+            s.connect(new InetSocketAddress(host, cong), TIMEOUT_MS);
+            s.setSoTimeout(TIMEOUT_MS);
+            OutputStream ra = s.getOutputStream();
+            byte[] ngau = new byte[16];
+            new Random().nextBytes(ngau);
+            String yeuCau = taoYeuCau(host, cong, maBase64(ngau));
+            ra.write(yeuCau.getBytes("UTF-8"));
+            ra.flush();
+            String traLoi = docToiDauDoiDongHang(s.getInputStream());
+            if (traLoi == null || !traLoi.contains("101")) return "dich vu 8080 khong tra 101: " + traLoi;
+            byte[] mask = new byte[4];
+            new Random().nextBytes(mask);
+            ra.write(taoKhung(taoKhungShell(), mask));
+            ra.flush();
+            return null;
+        } catch (Throwable t) {
+            return t.toString();
+        } finally {
+            try { s.close(); } catch (IOException boQua) { }
+        }
+    }
+
+    /** Doc phan hoi handshake toi "\r\n\r\n" (toi da 4096 byte); null neu het du lieu truoc. */
+    static String docToiDauDoiDongHang(InputStream vao) throws IOException {
+        ByteArrayOutputStream b = new ByteArrayOutputStream();
+        int t1 = -1, t2 = -1, t3 = -1;
+        while (true) {
+            int x = vao.read();
+            if (x < 0) return null;
+            b.write(x);
+            if (t1 == '\r' && t2 == '\n' && t3 == '\r' && x == '\n') break;
+            t1 = t2;
+            t2 = t3;
+            t3 = x;
+            if (b.size() > 4096) return b.toString("UTF-8");
+        }
+        return b.toString("UTF-8");
+    }
+
+    /**
+     * Chay chuyen tiep tren luong nen (khong chan luong doc mic): loa khoi dong lai thi ket noi tu dut.
+     * Loi chi ghi logcat (HA khong nhan xac nhan rieng; HA ghi «ok» nghia la «da gui lenh toi APK»).
+     * Log chi chay tren loa that — test thuan khong goi batDau() nen khong cham stub android.jar.
+     */
+    public static void batDau() {
+        Thread t = new Thread(new Runnable() {
+            @Override public void run() {
+                String loi = chuyenTiep("127.0.0.1", CONG);
+                if (loi != null) Log.w("R1KhoiDongLai", "chuyen tiep toi shell cuc bo that bai: " + loi);
+            }
+        }, "r1-khoi-dong-lai");
+        t.setDaemon(true);
+        t.start();
+    }
+}
