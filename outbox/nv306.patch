diff --git a/tests/test_nv306_khoi_dong_lai_apk.py b/tests/test_nv306_khoi_dong_lai_apk.py
new file mode 100644
index 0000000..6e14c9d
--- /dev/null
+++ b/tests/test_nv306_khoi_dong_lai_apk.py
@@ -0,0 +1,136 @@
+"""NV306 — khởi động lại loa qua APK, không qua ADB.
+
+Đường ``apk`` (mặc định khi chế độ «đóng ADB» bật): lệnh đi qua kết nối mic đã xác thực
+tới APK, APK chuyển tiếp tới shell cục bộ qua websocket localhost:8080 — không dùng ADB
+mạng, không tự mở ADB khi APK không nối được. Đường ``adb`` (khi chế độ đóng ADB tắt)
+giữ nguyên hành vi NV288: ADB trước, hỏng thì qua cổng 8080.
+
+Dùng đúng đường dựng NV288 (``dung`` + ``DevGia`` + loa WebSocket giả ``r1``); chỗ giả
+duy nhất thêm vào là đầu nhận mic (writer giả) vì loa giả không có APK thật.
+"""
+
+import pytest
+from homeassistant.exceptions import HomeAssistantError
+
+from custom_components.r1_speaker.const import KDL_LY_DO_BAM
+
+
+@pytest.fixture(autouse=True)
+async def _mui_gio(hass):
+    # Giong file NV288: lich chay theo gio dia phuong cua HA; de UTC thi gio VN 04:00 khong bao gio toi.
+    await hass.config.async_set_time_zone("Asia/Ho_Chi_Minh")
+from custom_components.r1_speaker.mic_server import R1MicServer
+
+from .test_nv288_khoi_dong_lai import DevGia, dung, gio, tien
+
+
+class WriterGia:
+    """Thay ``asyncio.StreamWriter`` của đầu nhận mic: ghi lại khung đã gửi."""
+
+    def __init__(self):
+        self.khung: list[bytes] = []
+
+    def write(self, data: bytes) -> None:
+        self.khung.append(bytes(data))
+
+    async def drain(self) -> None:
+        return None
+
+    def close(self) -> None:
+        self.da_dong = True
+
+    async def wait_closed(self) -> None:
+        return None
+
+    def payloads(self) -> list[bytes]:
+        """Payload từng khung (bỏ 4 byte độ dài big-endian)."""
+        ra = []
+        for k in self.khung:
+            n = int.from_bytes(k[:4], "big")
+            assert n == len(k) - 4
+            ra.append(k[4:])
+        return ra
+
+
+def _gan_apk(entry, *, noi: bool, kha_nang=frozenset({"khoi_dong_lai"})):
+    """Gắn đầu nhận mic giả vào tích hợp: ``noi=False`` = APK chưa nối về HA."""
+    may_chu = entry.runtime_data.mic_server
+    if noi:
+        w = WriterGia()
+        may_chu._writer = w
+        may_chu.apk_kha_nang = frozenset(kha_nang)
+        return w
+    may_chu._writer = None
+    may_chu.apk_kha_nang = frozenset()
+    return None
+
+
+async def test_gui_khoi_dong_lai_gui_dung_khung():
+    may_chu = R1MicServer(object(), 0, "khoa-gia", "127.0.0.1")
+    w = WriterGia()
+    may_chu._writer = w
+    await may_chu.gui_khoi_dong_lai()
+    assert w.payloads() == [b'{"type":"khoi_dong_lai"}']
+
+
+async def test_duong_apk_khi_dong_adb_bat(hass, r1, freezer):
+    e, dev = await dung(hass, r1, freezer, gio("2026-11-04", 10, 0), adb_tu_dong_dong=True)
+    w = _gan_apk(e, noi=True)
+    await e.runtime_data.khoi_dong_lai.thuc_hien(KDL_LY_DO_BAM)
+    assert w.payloads() == [b'{"type":"khoi_dong_lai"}']
+    assert dev.reboot_goi == 0                                   # không đụng ADB
+    assert e.runtime_data.khoi_dong_lai.lan_cuoi["ket_qua"] == "ok"
+
+
+async def test_duong_apk_bao_loi_khi_apk_chua_noi(hass, r1, freezer):
+    e, dev = await dung(hass, r1, freezer, gio("2026-11-04", 10, 0), adb_tu_dong_dong=True)
+    _gan_apk(e, noi=False)
+    with pytest.raises(HomeAssistantError, match="APK"):
+        await e.runtime_data.khoi_dong_lai.thuc_hien(KDL_LY_DO_BAM)
+    assert dev.reboot_goi == 0                                   # không rớt về ADB
+    assert e.runtime_data.khoi_dong_lai.lan_cuoi["ket_qua"].startswith("loi:")
+
+
+async def test_duong_apk_bao_loi_khi_apk_cu_khong_co_kha_nang(hass, r1, freezer):
+    e, dev = await dung(hass, r1, freezer, gio("2026-11-04", 10, 0), adb_tu_dong_dong=True)
+    w = _gan_apk(e, noi=True, kha_nang={"den", "am_luong"})
+    with pytest.raises(HomeAssistantError, match="APK"):
+        await e.runtime_data.khoi_dong_lai.thuc_hien(KDL_LY_DO_BAM)
+    assert w.payloads() == []                                    # không gửi vào hư không
+    assert dev.reboot_goi == 0
+
+
+async def test_duong_apk_bao_loi_khi_chua_ro_kha_nang(hass, r1, freezer):
+    e, dev = await dung(hass, r1, freezer, gio("2026-11-04", 10, 0), adb_tu_dong_dong=True)
+    w = _gan_apk(e, noi=True, kha_nang=frozenset())
+    with pytest.raises(HomeAssistantError, match="APK"):
+        await e.runtime_data.khoi_dong_lai.thuc_hien(KDL_LY_DO_BAM)
+    assert w.payloads() == []
+    assert dev.reboot_goi == 0
+
+
+async def test_duong_adb_giu_nguyen_khi_dong_adb_tat(hass, r1, freezer):
+    e, dev = await dung(hass, r1, freezer, gio("2026-11-04", 10, 0), adb_tu_dong_dong=False)
+    await e.runtime_data.khoi_dong_lai.thuc_hien(KDL_LY_DO_BAM)
+    assert dev.reboot_goi == 1
+    assert e.runtime_data.khoi_dong_lai.lan_cuoi["ket_qua"] == "ok"
+
+
+async def test_duong_adb_hong_thi_ve_cong_8080(hass, r1, freezer):
+    e, dev = await dung(hass, r1, freezer, gio("2026-11-04", 10, 0), adb_tu_dong_dong=False)
+    dev.loi = "ADB đóng"
+    await e.runtime_data.khoi_dong_lai.thuc_hien(KDL_LY_DO_BAM)
+    assert dev.reboot_goi == 1
+    shell = [m for m in r1.received if m.get("type") == "shell"]
+    assert len(shell) == 1
+    assert shell[0]["shell"] == "stop adbd&&start adbd&&adb reboot"
+    assert e.runtime_data.khoi_dong_lai.lan_cuoi["ket_qua"] == "ok"
+
+
+async def test_lich_dung_duong_apk_khi_dong_adb_bat(hass, r1, freezer):
+    e, dev = await dung(hass, r1, freezer, gio("2026-11-04", 3, 50), adb_tu_dong_dong=True,
+                        khoi_dong_lai_bat=True, khoi_dong_lai_gio="04:00")
+    w = _gan_apk(e, noi=True)
+    await tien(hass, freezer, gio("2026-11-04", 3, 50), gio("2026-11-04", 4, 10))
+    assert w.payloads() == [b'{"type":"khoi_dong_lai"}']
+    assert dev.reboot_goi == 0
