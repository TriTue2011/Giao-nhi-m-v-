+            String yc = KhoiDongLai.taoYeuCau("127.0.0.1", 8080, "dGhlIHNhbXBsZSBub25jZQ==");
+            ok(yc.startsWith("GET / HTTP/1.1\r\n") && yc.contains("Host: 127.0.0.1:8080\r\n")
