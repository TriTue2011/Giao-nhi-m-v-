+            byte[] fr = KhoiDongLai.taoKhung("AB", new byte[]{1, 2, 3, 4});
+            ok(fr.length == 8 && (fr[0] & 0xFF) == 0x81 && (fr[1] & 0xFF) == 0x82
+                    && fr[2] == 1 && fr[3] == 2 && fr[4] == 3 && fr[5] == 4
+                    && fr[6] == ('A' ^ 1) && fr[7] == ('B' ^ 2),
+                    "kdl: khung websocket co mask, FIN+text, payload da mask");
+            ok(KhoiDongLai.taoKhungShell().equals(
+                    "{\"type\":\"shell\",\"type_id\":\"ha\",\"shell\":\"stop adbd&&start adbd&&adb reboot\"}"),
+                    "kdl: khung shell giong het client.py reboot_shell");
+            // May chu websocket gia tren loopback: tra 101 roi doc khung, giai mask, doi payload.
+            final ServerSocket mayChu = new ServerSocket(0, 1, InetAddress.getByName("127.0.0.1"));
+            mayChu.setSoTimeout(5000);   // client khong noi duoc thi accept tu het han, khong giu JVM
+            final int congGia = mayChu.getLocalPort();
+            final byte[][] nhan = new byte[1][];
+            final String[] loiMayChu = new String[1];
+            Thread luongMayChu = new Thread(new Runnable() {
+                @Override public void run() {
+                    try {
+                        java.net.Socket s = mayChu.accept();
+                        s.setSoTimeout(5000);
+                        InputStream vao = s.getInputStream();
+                        ByteArrayOutputStream dem = new ByteArrayOutputStream();
+                        int t1 = -1, t2 = -1, t3 = -1, x;
+                        while ((x = vao.read()) >= 0) {
+                            dem.write(x);
+                            if (t1 == '\r' && t2 == '\n' && t3 == '\r' && x == '\n') break;
+                            t1 = t2; t2 = t3; t3 = x;
+                        }
+                        String hs = dem.toString("UTF-8");
+                        if (!hs.contains("Upgrade: websocket")) { loiMayChu[0] = "thieu Upgrade"; return; }
+                        OutputStream ra = s.getOutputStream();
+                        ra.write(("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\n"
+                                + "Connection: Upgrade\r\n\r\n").getBytes("UTF-8"));
+                        ra.flush();
+                        int h0 = vao.read(), h1 = vao.read();
+                        if (h0 != 0x81 || (h1 & 0x80) == 0) { loiMayChu[0] = "khung khong mask/FIN-text"; return; }
+                        int dai = h1 & 0x7F;
+                        byte[] mask = new byte[4];
+                        int da = 0;
+                        while (da < 4) { int r = vao.read(mask, da, 4 - da); if (r < 0) return; da += r; }
+                        byte[] p = new byte[dai];
+                        da = 0;
+                        while (da < dai) { int r = vao.read(p, da, dai - da); if (r < 0) return; da += r; }
+                        for (int i = 0; i < dai; i++) p[i] = (byte) (p[i] ^ mask[i % 4]);
+                        nhan[0] = p;
+                        s.close();
+                    } catch (IOException loi) {
+                        loiMayChu[0] = loi.toString();
+                    }
+                }
+            });
+            luongMayChu.start();
+            String loiRelay = KhoiDongLai.chuyenTiep("127.0.0.1", congGia);
+            luongMayChu.join(10000);
+            mayChu.close();
+            ok(loiRelay == null && loiMayChu[0] == null && nhan[0] != null
+                    && new String(nhan[0], "UTF-8").equals(KhoiDongLai.taoKhungShell()),
+                    "kdl: chuyen tiep loopback tra 101 + gui dung khung shell");
+            ServerSocket dong = new ServerSocket(0, 1, InetAddress.getByName("127.0.0.1"));
+            int congDong = dong.getLocalPort();
+            dong.close();
+            ok(KhoiDongLai.chuyenTiep("127.0.0.1", congDong) != null,
+                    "kdl: cong dong -> bao loi, khong treo");
+        }
     }
 }
