# Copy to .env and fill in your own values. NEVER commit the real .env.
# No real credential values are stored in this repository.

# Camera (DVRIP, TCP 34567) -- the DOSEN RPO V1 on your LAN.
ICSEE_CAM_IP=
ICSEE_CAM_PORT=34567
ICSEE_CAM_USER=admin
ICSEE_CAM_PASS=
ICSEE_CAM_CHANNEL=0
# Monitor stream: Main (1080P) or Extra1 (D1 sub stream).
ICSEE_CAM_STREAM=Main
# Device serial -- only needed by the (not yet implemented) FunSDK/AV-talk
# path. DVRIP-native mic/talk do not need it.
ICSEE_CAM_SN=

# Video pipeline fallbacks (used when DecoderPram negotiation fails).
# The iCSee app falls back to 864x480 / fps 10 / H264; set these to match
# your camera (DOSEN RPO V1: 1920x1080 / 30 / H265) if you want the
# pipeline to use the camera's own settings without negotiating.
VIDEO_WIDTH=864
VIDEO_HEIGHT=480
VIDEO_FPS=10
VIDEO_CODEC=H264
# Optional: directory to dump raw YUV debug frames (off by default).
VIDEO_DEBUG_DUMP_DIR=

# HTTP API.
API_HOST=0.0.0.0
API_PORT=8080

# DVRIP socket timeouts (seconds).
DVRIP_CONNECT_TIMEOUT=5
DVRIP_READ_TIMEOUT=10
