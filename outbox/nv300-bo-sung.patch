+def di_tru_khoa_theo_provider(du_lieu, loai_tru=()) -> dict:
+    """Đổi khoá các bản ghi có module_id sang id phân vùng (NV300 bổ sung).
+
+    Hàm THUẦN, không chạm kho thật: chủ máy/điều phối gọi lúc di trú trên
