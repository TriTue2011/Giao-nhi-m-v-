+    ``{"tai_khoan": {...}}``), rồi ghi lại. Quy tắc: bản ghi có module_id
+    → khoá mới ``ma_tai_khoan(email, module_id)`` (đồng thời sửa trường
+    ``id`` trong bản ghi); bản ghi trong ``loai_tru`` (email, đã chuẩn
+    hoá — dùng cho trường hợp được dặn loại trừ) và bản ghi không module
+    giữ nguyên; đụng khoá đích (đích đã có bản ghi) → giữ bản ghi đích,
+    bản ghi nguồn ở lại khoá cũ để không mất dữ liệu. Gọi lại trên kết quả
+    đã di trú → không đổi.
+    """
+    loai = set()
+    for email in (loai_tru or ()):
+        try:
+            loai.add(chuan_hoa_email(email))
+        except LoiKhoTaiKhoan:
+            continue
+
+    def _doi_khoa(ban_ghi_map: dict) -> dict:
+        co_dinh = set()
+        for id_, ban in ban_ghi_map.items():
+            if not isinstance(ban, dict):
+                co_dinh.add(id_)
+                continue
+            email = ban.get("email", "")
+            module = ban.get("module_id", "")
+            if (not isinstance(module, str) or not module
+                    or email in loai):
+                co_dinh.add(id_)
+                continue
+            try:
+                email_chuan = chuan_hoa_email(email)
+            except LoiKhoTaiKhoan:
+                co_dinh.add(id_)
+                continue
+            if ma_tai_khoan(email_chuan, module) == id_:
+                co_dinh.add(id_)
+        moi_map = {}
+        da_chiem = set(co_dinh)
+        for id_, ban in ban_ghi_map.items():
+            if id_ in co_dinh:
+                moi_map[id_] = ban
+                continue
+            try:
+                email_chuan = chuan_hoa_email(ban.get("email", ""))
+            except LoiKhoTaiKhoan:
+                moi_map[id_] = ban
+                continue
+            id_moi = ma_tai_khoan(email_chuan, ban.get("module_id", ""))
+            if id_moi in da_chiem:
+                log.warning("di-tru-khoa: đụng khoá đích, giữ bản ghi cũ")
+                moi_map[id_] = ban
+                continue
+            ban_moi = dict(ban)
+            ban_moi["id"] = id_moi
+            moi_map[id_moi] = ban_moi
+            da_chiem.add(id_moi)
+        return moi_map
+
+    if not isinstance(du_lieu, dict):
+        return du_lieu
+    boc = du_lieu.get("tai_khoan")
+    if isinstance(boc, dict):
+        moi = dict(du_lieu)
+        moi["tai_khoan"] = _doi_khoa(boc)
+        return moi
+    return _doi_khoa(du_lieu)
