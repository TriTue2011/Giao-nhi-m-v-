+def test_dong_hoa_chi_go_vong_cua_module_da_di(tmp_path, monkeypatch):
+    monkeypatch.setenv("WEB2API_DATA", str(tmp_path / "data"))
+
+    async def _chay():
+        ql = tlm.QuanLyTuLamMoi()
+        mod_a = _ModuleGiaVong("mod-a-nv300", ["tk-aaaaaaaaaaaaaaaa"])
+        mod_b = _ModuleGiaVong("mod-b-nv300", ["tk-bbbbbbbbbbbbbbbb"])
+        ql.dong_hoa({"mod-a-nv300": mod_a, "mod-b-nv300": mod_b})
+        vong_b_truoc = ql._vong["mod-b-nv300"]
+        ql.dong_hoa({"mod-b-nv300": mod_b})
+        assert "mod-a-nv300" not in ql._vong
+        assert ql._vong["mod-b-nv300"] is vong_b_truoc
+        ql.dong_hoa({})
+        assert ql._vong == {}
+        await asyncio.sleep(0)
+
+    chay(_chay())
