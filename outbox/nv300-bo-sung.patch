+
+class _ModuleGiaVong:
+    def __init__(self, module_id, khoa_list, loi=False):
+        self.manifest = {"id": module_id}
+        self._khoa_list = khoa_list
+        self._loi = loi
+        self.da_kiem = []
+
+    def khoa_tai_khoan(self):
+        if self._loi:
+            raise RuntimeError("loi-gia-vong-nv300")
+        return list(self._khoa_list)
+
+    async def lam_moi_phien(self, khoa):
+        self.da_kiem.append(khoa)
+        return kp.KetQuaKhoiPhuc(True, tang="a")
+
