+def tim_theo_email_va_module(email, module_id) -> dict | None:
+    """Tìm bản ghi nội bộ theo (email, module) — NV300 bổ sung.
+
+    Cùng email ở hai provider là hai bản ghi độc lập: ưu tiên id phân vùng
