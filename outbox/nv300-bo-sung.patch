+"""Test bổ sung NV300 (phân vùng kho theo provider + quy tắc nghiệm thu
+email/Google + đường trực tiếp grok.com/sign-in).
+
+ĐỎ-TRƯỚC-XANH cho phần bổ sung; NV300 gốc không làm lại. Mọi chuỗi bí mật
+đều là chuỗi giả rõ ràng; trình duyệt giả `TrinhDuyetGia` chỉ ghi khóa
+hành động, không ghi giá trị điền.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import importlib.util
+import json
+import sys
+from pathlib import Path
+
+import pytest
+
+GOC = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(GOC))
+
+from app import kho_tai_khoan as kho
+from app import kho as kho_thap
+from app import khoi_phuc_phien as kp
+from app import tu_lam_moi as tlm
+from app.tai_khoan_hang_loat import BiMatTam, DongDaTach
+
+EMAIL_GIA = "bo-sung-nv300@example.com"
+MAT_KHAU_GIA = "mat-khau-gia-nv300-001"
+
+
+def chay(coro):
+    return asyncio.run(coro)
+
+
+def _tai_goi_module(thu_muc: Path, ten: str):
+    goi = f"nv300_bs_{ten}"
+    spec = importlib.util.spec_from_file_location(
+        goi, thu_muc / "module.py",
+        submodule_search_locations=[str(thu_muc)])
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules[goi] = mod
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def _mod_grok(tmp_path, monkeypatch):
+    thu_muc = GOC / "modules" / "grok-web"
+    mod = _tai_goi_module(thu_muc, "grok")
+    manifest = json.loads((thu_muc / "manifest.json").read_text(encoding="utf-8"))
+    monkeypatch.setenv("WEB2API_DATA", str(tmp_path / "data"))
+    m = mod.Module(dict(manifest))
+    m.kho = kho_thap.kho_rieng("grok-web")
+    # grok kiểm phiên bằng GET trang chủ qua client: giả bằng client nhẹ.
+    import httpx
+
+    def xu_ly(req):
+        cookie = req.headers.get("cookie", "")
+        if req.url.path == "/":
+            if "sso-gia" in cookie or "x-userid-gia" in cookie:
+                return httpx.Response(200, text="ok")
+            return httpx.Response(401, text="het han")
+        return httpx.Response(404, text="khong co")
+
+    transport = httpx.MockTransport(xu_ly)
+
+    def tao_client(self, jar=None):
+        return mod.GrokWebClient(jar, base_url=m._goc_https, transport=transport)
+
+    monkeypatch.setattr(mod.Module, "_tao_client", tao_client)
+    return m, mod
+
+
+def _mod_claude(tmp_path, monkeypatch):
+    thu_muc = GOC / "modules" / "claude-web"
+    mod = _tai_goi_module(thu_muc, "claude")
+    mod_client = sys.modules.get("nv300_bs_claude.client")
+    import httpx
+    manifest = json.loads((thu_muc / "manifest.json").read_text(encoding="utf-8"))
