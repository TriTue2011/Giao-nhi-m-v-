+def test_vong_rieng_khoa_cua_mot_module_khong_lan_sang_module_khac(tmp_path, monkeypatch):
+    """Cùng tên khoá ở hai module: sổ lần kiểm key theo (module_id, khoá)
+    nên vòng mỗi bên kiểm khoá của chính nó, không ăn gian lần kiểm của
+    bên kia."""
+    monkeypatch.setenv("WEB2API_DATA", str(tmp_path / "data"))
+    monkeypatch.setenv("WEB2API_TU_LAM_MOI_BAT", "1")
+    tlm._lan_kiem.clear()
+    mod_a = _ModuleGiaVong("mod-a-nv300", ["tk-aaaaaaaaaaaaaaaa"])
+    mod_b = _ModuleGiaVong("mod-b-nv300", ["tk-aaaaaaaaaaaaaaaa"])
+    vong_a = tlm.VongTuLamMoi(mod_a, "mod-a-nv300")
+    vong_b = tlm.VongTuLamMoi(mod_b, "mod-b-nv300")
+    assert chay(vong_a.chay_mot_vong()) == 1
+    assert chay(vong_b.chay_mot_vong()) == 1
+    assert mod_a.da_kiem == ["tk-aaaaaaaaaaaaaaaa"]
+    assert mod_b.da_kiem == ["tk-aaaaaaaaaaaaaaaa"]
+
+
+def test_loi_vong_mot_module_khong_chan_vong_module_khac(tmp_path, monkeypatch):
+    monkeypatch.setenv("WEB2API_DATA", str(tmp_path / "data"))
+    monkeypatch.setenv("WEB2API_TU_LAM_MOI_BAT", "1")
+    tlm._lan_kiem.clear()
+    mod_a = _ModuleGiaVong("mod-a-nv300", ["tk-aaaaaaaaaaaaaaaa"], loi=True)
+    mod_b = _ModuleGiaVong("mod-b-nv300", ["tk-bbbbbbbbbbbbbbbb"])
+    vong_a = tlm.VongTuLamMoi(mod_a, "mod-a-nv300")
+    vong_b = tlm.VongTuLamMoi(mod_b, "mod-b-nv300")
+    assert chay(vong_a.chay_mot_vong()) == 0
+    assert chay(vong_b.chay_mot_vong()) == 1
+    assert mod_b.da_kiem == ["tk-bbbbbbbbbbbbbbbb"]
+
