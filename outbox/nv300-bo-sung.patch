+def test_di_tru_khoa_theo_provider_va_loai_tru(tmp_path, monkeypatch):
+    """Helper di trú (thuần, không chạm kho thật): đổi khoá các bản ghi có
+    module_id sang id phân vùng; bản ghi trong danh sách loại trừ và bản
+    ghi không module giữ nguyên; không đụng id khi đã đúng."""
+    monkeypatch.setenv("WEB2API_DATA", str(tmp_path / "data"))
+    id_email = kho.ma_tai_khoan(EMAIL_GIA)
+    email_loai = "loai-tru-gia-nv300@example.com"
+    du_lieu = {
+        id_email: {"id": id_email, "email": EMAIL_GIA, "module_id": "grok-web",
+                   "mat_khau": MAT_KHAU_GIA},
+        kho.ma_tai_khoan(email_loai): {
+            "id": kho.ma_tai_khoan(email_loai), "email": email_loai,
+            "module_id": "grok-web", "mat_khau": MAT_KHAU_GIA},
+        kho.ma_tai_khoan("cu-gia-nv300@example.com"): {
+            "id": kho.ma_tai_khoan("cu-gia-nv300@example.com"),
+            "email": "cu-gia-nv300@example.com", "mat_khau": MAT_KHAU_GIA},
+    }
+    moi = kho.di_tru_khoa_theo_provider(du_lieu, loai_tru=(email_loai,))
+    id_moi = kho.ma_tai_khoan(EMAIL_GIA, "grok-web")
+    assert id_moi in moi
+    assert moi[id_moi]["module_id"] == "grok-web"
+    assert moi[id_moi]["id"] == id_moi
+    assert id_email not in moi
+    assert kho.ma_tai_khoan(email_loai) in moi
+    assert kho.ma_tai_khoan("cu-gia-nv300@example.com") in moi
+    # Gọi lại trên kết quả đã di trú → không đổi (idempotent).
+    moi2 = kho.di_tru_khoa_theo_provider(moi, loai_tru=(email_loai,))
+    assert moi2 == moi
+    # Dạng bọc {"tai_khoan": ...} cũng được chấp nhận.
+    boc = kho.di_tru_khoa_theo_provider({"tai_khoan": du_lieu},
+                                         loai_tru=(email_loai,))
+    assert boc["tai_khoan"] == moi
