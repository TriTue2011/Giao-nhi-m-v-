+        del sys.modules[ten]
+    spec = importlib.util.spec_from_file_location(ten, THU_MUC_MODULE / "trich_xuat.py")
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules[ten] = mod
+    spec.loader.exec_module(mod)
+    return mod
