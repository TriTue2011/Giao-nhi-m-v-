+class BanGia:
+    """Phản hồi thượng nguồn giả cho rơ-le: headers + aiter_bytes."""
+
+    def __init__(self, headers, khoi=b"x" * 100):
+        self.status_code = 206
+        self.headers = headers
+        self.khoi = khoi
+
+    async def aiter_bytes(self):
+        yield self.khoi
+
+    async def aclose(self):
+        return None
