diff --git a/demo/lich-viet-demo.html b/demo/lich-viet-demo.html
new file mode 100644
index 0000000..812c9bf
--- /dev/null
+++ b/demo/lich-viet-demo.html
@@ -0,0 +1,106 @@
+<!doctype html>
+<html lang="vi">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Lịch Việt — Demo lưới 12 con giáp bằng xương (NV270, luồng C)</title>
+<style>
+  body{font-family:Georgia,serif;background:#f6edd6;color:#2d1b10;margin:0;padding:16px}
+  h1{font-size:20px;margin:0 0 4px}
+  p{margin:4px 0 12px;line-height:1.45}
+  .ctl{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin:0 0 16px}
+  .luoi{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px}
+  .o{border:1px solid #8a2a1c;border-radius:10px;background:#fff8e6;padding:10px}
+  .o h2{font-size:15px;margin:0 0 6px}
+  .o canvas,.o .nghi{width:100%;display:block}
+  .o .nghi{aspect-ratio:4/3;background-size:600% 300%;background-repeat:no-repeat}
+  .o small{display:block;margin-top:6px;opacity:.75;line-height:1.35}
+  .dung canvas{opacity:.85}
+</style>
+</head>
+<body>
+<h1>Lịch Việt — Lưới 12 con giáp (NV270)</h1>
+<p>Chạy bằng cùng bộ vẽ <code>taoXuong</code> với thẻ (<code>lich-bloc-xua-xuong.js</code>).
+Con nào đã có <code>xuong/&lt;khoa&gt;.json</code> + ảnh lớp thì vẽ bằng xương; con chưa có
+thì hiện tư thế đứng nghỉ của sprite (khung 16) và ghi rõ “chờ ảnh + cấu hình” — sprite
+vẫn là đường dự phòng, không bị bỏ. Một vòng <code>requestAnimationFrame</code> cho cả lưới;
+nút Tạm dừng thêm class <code>dung</code> và vẽ tư thế nghỉ (t = 0) như thẻ.</p>
+<p><b>Cách xem:</b> phục vụ từ gốc kho (ví dụ <code>python3 -m http.server</code> rồi mở
+<code>/demo/lich-viet-demo.html</code>). Mở trực tiếp bằng <code>file://</code> có thể bị chặn
+tải module/fetch.</p>
+<div class="ctl">
+  <button id="tamDung" type="button">Tạm dừng</button>
+  <label>Tốc độ <input id="tocDo" type="range" min="0.25" max="3" step="0.05" value="1"> <span id="tocDoGt">×1.00</span></label>
+  <span id="trangThai">Đang tải…</span>
+</div>
+<div class="luoi" id="luoi"></div>
+<script type="module">
+import { taoXuong } from "../custom_components/lich_viet/frontend/lich-bloc-xua-xuong.js";
+const KHOA = [
+  ["ty", "Chuột"], ["suu", "Trâu"], ["dan", "Hổ"], ["mao", "Mèo"],
+  ["thin", "Rồng"], ["ran", "Rắn"], ["ngo", "Ngựa"], ["mui", "Dê"],
+  ["than", "Khỉ"], ["ga", "Gà"], ["cho", "Chó"], ["heo", "Heo"],
+];
+const GOC = "../custom_components/lich_viet/frontend/";
+const luoi = document.getElementById("luoi");
+const trangThai = document.getElementById("trangThai");
+const xuongs = [];
+let dung = false, tocDo = 1, goc = undefined;
+
+function taiAnh(src) {
+  return new Promise((res, rej) => {
+    const im = new Image();
+    im.onload = () => res(im); im.onerror = () => rej(new Error("không tải được " + src));
+    im.src = src;
+  });
+}
+// Tư thế đứng nghỉ của sprite: khung 16 trong lưới 6×3 (cột 4, hàng 2).
+function spriteNghi(khoa) {
+  const d = document.createElement("div");
+  d.className = "nghi";
+  d.style.backgroundImage = `url('${GOC}thu/${khoa}.webp')`;
+  d.style.backgroundPosition = "80% 100%";
+  return d;
+}
+for (const [khoa, ten] of KHOA) {
+  const o = document.createElement("div");
+  o.className = "o";
+  o.innerHTML = `<h2>${ten} (${khoa})</h2>`;
+  luoi.appendChild(o);
+  try {
+    const cfg = await fetch(`${GOC}xuong/${khoa}.json`).then((r) => { if (!r.ok) throw new Error("chưa có cấu hình"); return r.json(); });
+    const chinh = await taiAnh(`${GOC}xuong/${khoa}-chinh.webp`);
+    let xa = chinh;
+    try { xa = await taiAnh(`${GOC}xuong/${khoa}-xa.webp`); } catch (e) { if (!cfg.song) throw e; }
+    const cv = document.createElement("canvas");
+    o.appendChild(cv);
+    xuongs.push(taoXuong(cv, cfg, { chinh, xa }));
+    const ghi = document.createElement("small");
+    ghi.textContent = cfg.song ? "Vẽ bằng sóng xương (không chân)." : "Vẽ bằng xương.";
+    o.appendChild(ghi);
+  } catch (e) {
+    o.appendChild(spriteNghi(khoa));
+    const ghi = document.createElement("small");
+    ghi.textContent = "Chờ ảnh + cấu hình xương: đang hiện sprite đứng nghỉ (đường dự phòng).";
+    o.appendChild(ghi);
+  }
+}
+trangThai.textContent = `Đã tải: ${xuongs.length}/12 con bằng xương, còn lại hiện sprite nghỉ.`;
+document.getElementById("tamDung").addEventListener("click", (e) => {
+  dung = !dung;
+  document.body.classList.toggle("dung", dung);
+  e.target.textContent = dung ? "Chạy tiếp" : "Tạm dừng";
+});
+const toc = document.getElementById("tocDo"), tocGt = document.getElementById("tocDoGt");
+toc.addEventListener("input", () => { tocDo = +toc.value; tocGt.textContent = "×" + tocDo.toFixed(2); });
+// MỘT vòng rAF cho cả lưới, giống thẻ: t = đồng hồ đơn / chu kỳ 1,2 s × toc_do.
+function buoc(now) {
+  if (goc === undefined) goc = now;
+  const t = (((now - goc) / 1000) / 1.2 * tocDo) % 1;
+  for (const x of xuongs) x.ve(dung ? 0 : t);
+  requestAnimationFrame(buoc);
+}
+requestAnimationFrame(buoc);
+</script>
+</body>
+</html>
