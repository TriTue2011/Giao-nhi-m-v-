+"""NV270, luồng C: bộ vẽ 2 chân, không chân và demo (không cần WebGL để chạy).
+
+Các test này chỉ kiểm tra tĩnh mã nguồn và toán thuần (bản sao Python của
+dichChuyenSong/loaiXuong trong lich-bloc-xua-xuong.js). Vẽ WebGL thật,
+Chrome headless và đo trên hình vẽ thật KHÔNG chạy được trong VM này
+(không có Chrome) nên được ghi CHƯA KIỂM trong báo cáo, không bịa số.
+"""
+
+from __future__ import annotations
+
+import math
+import re
+from pathlib import Path
+
+GOC = Path(__file__).resolve().parent.parent
+FE = GOC / "custom_components" / "lich_viet" / "frontend"
+XUONG_JS = (FE / "lich-bloc-xua-xuong.js").read_text(encoding="utf-8")
+THE = (FE / "lich-bloc-xua-card.js").read_text(encoding="utf-8")
+DEMO = (GOC / "demo" / "lich-viet-demo.html").read_text(encoding="utf-8")
+
+
+# ---------- bản sao Python của toán sóng (đối chiếu công thức JS) ----------
+
+def _bien_do(x, song):
+    return (song.get("bien_do", 20)) * min(1, max(0, (song["dau"][0] - x) / song["dai"]))
+
+
+def _dich(x, y, t, song):
+    tt = t % 1.0
+    buoc = min(1.3 * song["dai"], max(song["dai"], song.get("buoc_song", song["dai"] * 1.15)))
+    dy = _bien_do(x, song) * math.sin((2 * math.pi / buoc) * x - 2 * math.pi * tt)
+    th = song.get("xoay", 0.03) * math.sin(2 * math.pi * tt)
+    qx, qy = x - song["dau"][0], y - song["dau"][1]
+    return (qx * math.cos(th) - qy * math.sin(th) + song["dau"][0],
+            qx * math.sin(th) + qy * math.cos(th) + song["dau"][1] + dy)
+
+
+def _loai(cfg):
+    if cfg.get("song"):
+        return "khong-chan"
+    a = len(cfg.get("chinh", {}).get("chan", []))
+    b = len(cfg.get("xa", {}).get("chan", []))
+    if a == 2 and b == 2:
+        return "bon-chan"
+    if a == 1 and b == 1:
+        return "hai-chan"
+    return None
+
+
+def test_song_dau_dung_yen_bien_do_tang_ve_duoi():
+    song = {"dau": [1000, 500], "dai": 800, "bien_do": 40, "buoc_song": 1000, "xoay": 0.03}
+    assert _bien_do(1000, song) == 0
+    assert _bien_do(600, song) == 20
+    assert _bien_do(200, song) == 40
+    assert _bien_do(0, song) == 40  # kẹp ở đuôi, không vượt bien_do
+    x0, y0 = _dich(1000, 500, 0.3, song)
+    assert abs(x0 - 1000) < 1e-9 and abs(y0 - 500) < 1e-9  # đầu không nhích
+
+
+def test_song_buoc_song_trong_khoang_1_den_1_3_chieu_dai():
+    for buoc in (500, 800, 1040, 2000):
+        song = {"dau": [1000, 500], "dai": 800, "bien_do": 40, "buoc_song": buoc}
+        kep = min(1.3 * 800, max(800, buoc))
+        assert 800 <= kep <= 1040
+
+
+def test_song_xoay_rat_nhe():
+    song = {"dau": [1000, 500], "dai": 800, "bien_do": 40, "xoay": 0.03}
+    # Ở t = 0,25, xoay cực đại 0,03 rad: điểm đuôi lệch y do xoay ≈ 800×0,03 = 24 px.
+    _, y = _dich(200, 500, 0.25, song)
+    assert abs(y - 500) <= 40 + 24 + 1
+
+
+def test_loai_xuong():
+    assert _loai({"song": {"dau": [1, 2], "dai": 3}}) == "khong-chan"
+    mot = {"chan": [{}]}
+    assert _loai({"chinh": mot, "xa": mot}) == "hai-chan"
+    hai = {"chan": [{}, {}]}
+    assert _loai({"chinh": hai, "xa": hai}) == "bon-chan"
+    assert _loai({"chinh": {"chan": []}, "xa": {"chan": []}}) is None
+
+
+def test_xuong_js_co_song_hai_chan_va_phu():
+    assert "export function loaiXuong" in XUONG_JS
+    assert "export function dichChuyenSong" in XUONG_JS
+    assert "export function bienDoSong" in XUONG_JS
+    assert "taoXuongSong" in XUONG_JS
+    assert "goc_max" in XUONG_JS and "Math.min(0.07" in XUONG_JS  # xương phụ ≤ 0,07 rad
+    assert "song" in XUONG_JS and "buoc_song" in XUONG_JS
+
+
+def test_the_tai_theo_khoa_va_giu_sprite_du_phong():
+    assert "taiCauHinhXuong(khoa)" in THE
+    assert "taiAnhXuongCa(khoa, cfg)" in THE
+    assert "theoKhoa" in THE
+    assert "taoXuong(cv, cfg, anh)" in THE
+    assert "const SPRITE_CSS" in THE and "dongSprite" in THE
+    assert THE.count("requestAnimationFrame(buoc)") == 2  # MỘT vòng rAF cho cả thẻ
+    assert ".dung" in THE or 'classList.toggle("dung"' in THE
+    # Bánh răng: toc_do đọc trực tiếp trong vòng xương, chay/nghi qua _lichThu.
+    assert "_chayVongXuong" in THE and "_lichThu" in THE and "toc_do" in THE
+
+
+def test_demo_luoi_12_con_dung_chung_tao_xuong():
+    assert "from \"../custom_components/lich_viet/frontend/lich-bloc-xua-xuong.js\"" in DEMO
+    assert "taoXuong" in DEMO
+    for khoa in ("ty", "suu", "dan", "mao", "thin", "ran", "ngo", "mui", "than", "ga", "cho", "heo"):
+        assert khoa in DEMO
+    assert "requestAnimationFrame(buoc)" in DEMO
+    assert "dung" in DEMO
