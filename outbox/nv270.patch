-// Bộ vẽ xương cho thẻ «Lịch bloc xưa» (NV269): MỘT ảnh duy nhất biến dạng theo xương
-// bằng lưới tam giác WebGL thuần (không thư viện ngoài). Chép logic từ tham chiếu
-// xuong-tham-chieu/rig2.html, chỉ tách cấu hình ra tệp JSON riêng.
+// Bộ vẽ xương cho thẻ «Lịch bloc xưa» (NV269, mở rộng NV270): MỘT ảnh duy nhất
+// biến dạng theo xương bằng lưới tam giác WebGL thuần (không thư viện ngoài).
+// Chép logic từ tham chiếu xuong-tham-chieu/rig2.html, chỉ tách cấu hình ra JSON riêng.
 // Cách dùng: taoXuong(canvas, cauHinh, anh) -> { ve(t), dung(), huy() }.
+//   - Bốn chân: mỗi lớp 2 chân (chó, NV269). Hai chân: mỗi lớp 1 chân (ty, than, ga),
+//     cộng một xương phụ tùy chọn (đuôi/tay, ≤ 0,07 rad) khi lớp chỉ có 1 chân.
+//   - Không chân (ran, thin): cauHinh.song = { dau:[x,y] (đầu, bên phải), dai (chiều
+//     dài thân, hệ cấu hình), bien_do (px, hệ cấu hình), buoc_song (mặc định 1,15×dai,
+//     kẹp trong [dai, 1,3×dai]), xoay (mặc định 0,03 rad) }; sóng chạy trong bộ đổ đỉnh.
 //   - canvas: thẻ <canvas> (module tự đặt width/height theo cấu hình rồi mới lấy ngữ cảnh).
 //   - cauHinh: nội dung frontend/xuong/cho.json (khớp ở hệ 1200 px, K đưa về ảnh 800 px).
 //   - anh: { chinh: <ảnh lớp chính>, xa: <ảnh lớp chân xa> } (đã tải xong).
@@ -47,7 +52,7 @@ export function viTriBanChan(chan, t) {
 // Khoảng cách NGANG giữa bàn chân gần và bàn chân xa cùng cặp ở pha t:
 // { truoc: |x(chân trước gần) - x(chân trước xa)|, sau: ... }.
 // Cặp trước = chân có hip.x lớn hơn trong mỗi lớp; cặp sau = chân còn lại.
-export function khoangCachChan(cauHinh, t) {
+export function capChan(cauHinh) {
   const lay = (lop) => {
     const chan = cauHinh[lop].chan;
     const truoc = chan[0].hip[0] < chan[1].hip[0] ? chan[1] : chan[0];
@@ -56,11 +61,122 @@ export function khoangCachChan(cauHinh, t) {
   };
   const chinh = lay("chinh"), xa = lay("xa");
   return {
-    truoc: Math.abs(viTriBanChan(chinh.truoc, t)[0] - viTriBanChan(xa.truoc, t)[0]),
-    sau: Math.abs(viTriBanChan(chinh.sau, t)[0] - viTriBanChan(xa.sau, t)[0]),
+    sau: { gan: chinh.sau, xa: xa.sau },
+    truoc: { gan: chinh.truoc, xa: xa.truoc },
+  };
+}
+
+export function khoangCachChan(cauHinh, t) {
+  const cap = capChan(cauHinh);
+  return {
+    truoc: Math.abs(viTriBanChan(cap.truoc.gan, t)[0] - viTriBanChan(cap.truoc.xa, t)[0]),
+    sau: Math.abs(viTriBanChan(cap.sau.gan, t)[0] - viTriBanChan(cap.sau.xa, t)[0]),
   };
 }
 
+// Loại bộ vẽ theo cấu hình: "bon-chan" (mỗi lớp 2 chân), "hai-chan" (mỗi lớp
+// 1 chân), "khong-chan" (có cauHinh.song), null khi cấu hình không hợp lệ.
+export function loaiXuong(cauHinh) {
+  if (cauHinh.song) return "khong-chan";
+  const n = (lop) => (cauHinh[lop] && Array.isArray(cauHinh[lop].chan)) ? cauHinh[lop].chan.length : 0;
+  const a = n("chinh"), b = n("xa");
+  if (a === 2 && b === 2) return "bon-chan";
+  if (a === 1 && b === 1) return "hai-chan";
+  return null;
+}
+
+// Sóng cho con không chân, đúng công thức NV270: y' = y + A(x)·sin(k·x − ω·t).
+// Đầu ở bên phải nên biên độ tăng dần về đuôi (x giảm): A(x) = bien_do × s với
+// s = kẹp((dau.x − x)/dai, 0, 1); đầu (s = 0) gần như đứng yên. Bước sóng kẹp
+// trong [dai, 1,3×dai]. Xoay rất nhẹ quanh đầu: th = xoay·sin(2πt).
+export function bienDoSong(x, song) {
+  return (song.bien_do ?? 20) * Math.min(1, Math.max(0, (song.dau[0] - x) / song.dai));
+}
+export function dichChuyenSong(x, y, t, song) {
+  const tt = ((t % 1) + 1) % 1;
+  const buoc = Math.min(1.3 * song.dai, Math.max(song.dai, song.buoc_song ?? song.dai * 1.15));
+  const dy = bienDoSong(x, song) * Math.sin((2 * Math.PI / buoc) * x - 2 * Math.PI * tt);
+  const th = (song.xoay ?? 0.03) * Math.sin(2 * Math.PI * tt);
+  const qx = x - song.dau[0], qy = y - song.dau[1];
+  return [
+    qx * Math.cos(th) - qy * Math.sin(th) + song.dau[0],
+    qx * Math.sin(th) + qy * Math.cos(th) + song.dau[1] + dy,
+  ];
+}
+
+// Quãng di chuyển NGANG của một bàn chân trong một chu kỳ (max x - min x,
+// hệ toạ độ cấu hình). Đây là số dùng cho tiêu chí (a) và (b) của NV270 §3.
+export function quangDuongBanChan(chan, n = 240) {
+  let lo = Infinity, hi = -Infinity;
+  for (let i = 0; i < n; i++) {
+    const x = viTriBanChan(chan, i / n)[0];
+    if (x < lo) lo = x;
+    if (x > hi) hi = x;
+  }
+  return hi - lo;
+}
+
+export function quangDuongBonChan(cauHinh) {
+  const cap = capChan(cauHinh);
+  return {
+    sauGan: quangDuongBanChan(cap.sau.gan),
+    sauXa: quangDuongBanChan(cap.sau.xa),
+    truocGan: quangDuongBanChan(cap.truoc.gan),
+    truocXa: quangDuongBanChan(cap.truoc.xa),
+  };
+}
+
+// (a) Tỉ lệ quãng di chuyển chân xa / chân gần cùng cặp. Phải ≥ 0,8:
+// chân xa không được "ở mãi một chỗ" trong khi chân gần bước.
+export function tiLeChanXaGan(cauHinh) {
+  const q = quangDuongBonChan(cauHinh);
+  return { sau: q.sauXa / q.sauGan, truoc: q.truocXa / q.truocGan };
+}
+
+// (b) Bước đều: quãng nhỏ nhất / quãng lớn nhất của bốn chân. Phải ≥ 0,8.
+export function doDeuBuoc(cauHinh) {
+  const q = Object.values(quangDuongBonChan(cauHinh));
+  return Math.min(...q) / Math.max(...q);
+}
+
+// (b, tiếp) Độ lệch lớn nhất khỏi đường thẳng của x bàn chân trong pha
+// chạm đất (stance, 60% đầu chu kỳ của mỗi chân), tính bằng hồi quy tuyến
+// tính x theo pha stance. Phải ≤ 5 px (NV270 §3; số đo thật trên hình vẽ
+// của điều phối ≤ 3 px). Trả về px lớn nhất trong bốn chân.
+export function lechTruotTiepXuc(cauHinh) {
+  const cap = capChan(cauHinh);
+  const chan = [cap.sau.gan, cap.sau.xa, cap.truoc.gan, cap.truoc.xa];
+  let toiDa = 0;
+  for (const g of chan) {
+    const pts = [];
+    for (let i = 0; i < 1200; i++) {
+      const t = i / 1200, phi = ((t + g.ph) % 1 + 1) % 1;
+      if (phi < CHU_KY_DUTY) pts.push([phi, viTriBanChan(g, t)[0]]);
+    }
+    const n = pts.length;
+    const mx = pts.reduce((s, p) => s + p[0], 0) / n, my = pts.reduce((s, p) => s + p[1], 0) / n;
+    const b = pts.reduce((s, p) => s + (p[0] - mx) * (p[1] - my), 0) / pts.reduce((s, p) => s + (p[0] - mx) ** 2, 0);
+    const a = my - b * mx;
+    for (const p of pts) toiDa = Math.max(toiDa, Math.abs(p[1] - (a + b * p[0])));
+  }
+  return toiDa;
+}
+
+// Khoảng cách ngang gần–xa nhỏ nhất trong một chu kỳ, theo cặp.
+// CHÚ Ý: đây là khoảng cách giữa ĐIỂM KHỚP bàn chân của động học thuận,
+// không phải tâm bàn chân trên hình vẽ thật (do_chan.py đo tâm bàn chân
+// từ ảnh vẽ, nơi bàn chân có bề rộng và tâm lệch khỏi khớp). Vì vậy số
+// này chỉ dùng để báo cáo, không dùng để kết luận tiêu chí (c) của
+// NV270 §3 — tiêu chí (c) phải đo trên hình vẽ thật.
+export function khoangCachChanToiThieu(cauHinh, n = 240) {
+  let truoc = Infinity, sau = Infinity;
+  for (let i = 0; i < n; i++) {
+    const d = khoangCachChan(cauHinh, i / n);
+    truoc = Math.min(truoc, d.truoc); sau = Math.min(sau, d.sau);
+  }
+  return { truoc, sau };
+}
+
 const sm = (a, b, x) => {
   const t = Math.min(1, Math.max(0, (x - a) / (b - a)));
   return t * t * (3 - 2 * t);
@@ -91,6 +207,9 @@ const Sc = (sx, sy) => [sx, 0, 0, 0, sy, 0, 0, 0, 1];
 const about = (piv, M) => mul(T(piv[0], piv[1]), mul(M, T(-piv[0], -piv[1])));
 
 export function taoXuong(canvasMe, cauHinh, anh) {
+  const loai = loaiXuong(cauHinh);
+  if (!loai) throw new Error("cấu hình xương không hợp lệ: mỗi lớp cần 1 hoặc 2 chân, hoặc cấu hình song cho con không chân");
+  if (loai === "khong-chan") return taoXuongSong(canvasMe, cauHinh, anh);
   const K = cauHinh.K;
