+#: engine này trước đây không có trần tổng — một lượt tầng (b) kẹt lâu
+#: không bị cắt ở tầng lõi. Hết ngân sách thì bỏ tầng (b) (việc dài), vẫn
+#: được xoay sang tài khoản kế ở tầng (c) rồi mới cần người ở (d).
+#: Kiểm ở BIÊN tầng — một lượt gọi tầng đang chạy không bị cắt giữa chừng
+#: (giống c2a kiểm giữa các bước); trần của lượt gọi ngoài (vd timeout MCP)
+#: vẫn là lớp cắt cuối.
+NGAN_SACH_ABCD_GIAY = 1200.0
+
+
+def _bay_gio() -> float:
+    """Đồng hồ đơn điệu cho ngân sách (điểm chích để test giả lập hết giờ)."""
+    return time.monotonic()
+
+
+def _het_ngan_sach(bat_dau: float) -> bool:
+    """Đã quá ngân sách tổng của lượt này chưa (tính từ lúc bắt đầu lượt)."""
+    return _bay_gio() - bat_dau >= NGAN_SACH_ABCD_GIAY
+
