+
+
+# ── NV309-d: thử lại 1 lần qua làm mới khi lỗi phiên, trước khi xoay ──
+# Mẫu c2a api/grok_web.py::stream_chat (mỗi tài khoản tối đa 2 lượt: lỗi phiên
+# lần đầu → lam_moi(p) một lần → thử lại; vẫn hỏng mới sang tài khoản kế).
+# w2a: tầng (a) lam_moi_phien chỉ KIỂM lại phiên (grok.com không có endpoint
+# làm mới công khai) — sống lại thì thử lại lượt chat, không thì xoay.
+# Chỉ thử lại khi CHƯA có chữ nào và lỗi là lỗi phiên; lỗi khác (hết lượt,
+# lỗi máy chủ) xoay ngay không làm mới; đã có chữ thì dừng như cũ.
+
+
+class _KhachGrokGia:
+    """Khách Grok giả: chạy theo kịch bản (lỗi hoặc chữ) theo lần gọi chay()."""
+
+    def __init__(self, kich_ban):
+        self.kich_ban = list(kich_ban)
+        self.so_lan_chay = 0
+
+    async def chay(self, che_do, loi_nhan):
+        self.so_lan_chay += 1
+        while self.kich_ban:
+            muc = self.kich_ban.pop(0)
+            if isinstance(muc, Exception):
+                raise muc
+            yield muc
+
+
+def _lap_module_lam_moi_gia(bo_module, may_chu, kich_ban_khach, lam_moi_ok=True,
+                            monkeypatch=None):
+    """Module grok-web với _khach/lam_moi_phien giả (không mạng, không ws thật).
+
+    kich_ban_khach: {idx: [LoiGrokWeb | str, ...]}. Trả (md, goi_khach,
+    goi_lam_moi, khach_theo_idx). monkeypatch (nếu có) dùng để tắt kích hoạt
+    khôi phục nền ``bao_loi_phien`` — nó cũng gọi ``lam_moi_phien`` (T0) qua
+    tác vụ nền, làm nhiễu đếm «làm mới trong lượt chat» ở đây (hành vi nền
+    đó đã có từ trước, không thuộc phạm vi test này).
+    """
+    mod, _ = bo_module
+    md = lap_module(bo_module, [cookie("tot_1"), cookie("tot_2")], may_chu.url)
+    if monkeypatch is not None:
+        monkeypatch.setattr(mod.tu_lam_moi, "bao_loi_phien",
+                            lambda *a, **k: None)
+    goi_khach: list[int] = []
+    goi_lam_moi: list[str] = []
+    khach_theo_idx = {i: _KhachGrokGia(kb) for i, kb in kich_ban_khach.items()}
+
+    async def khach_gia(idx):
+        goi_khach.append(idx)
+        return khach_theo_idx[idx]
+
+    async def lam_moi_gia(khoa):
+        goi_lam_moi.append(khoa)
+        return mod.KetQuaKhoiPhuc(lam_moi_ok, tang="a",
+                                  ma_loi="" if lam_moi_ok else "het_han")
+
+    md._khach = khach_gia
+    md.lam_moi_phien = lam_moi_gia
+    return md, goi_khach, goi_lam_moi, khach_theo_idx
+
+
+async def _doc_luong(md):
+    return "".join([m async for m in md._luong_van_ban("fast", "xin chào")])
+
+
+def test_nv309d_loi_phien_thu_lai_qua_lam_moi_roi_thanh_cong(bo_module, may_chu, monkeypatch):
+    mod, _ = bo_module
+    md, goi_khach, goi_lam_moi, khach = _lap_module_lam_moi_gia(
+        bo_module, may_chu,
+        {0: [mod.LoiPhienGrokWeb("het phien"), "xin chào"],
+         1: ["không dùng tới"]},
+        lam_moi_ok=True, monkeypatch=monkeypatch)
+    assert chay(_doc_luong(md)) == "xin chào"
+    assert len(goi_lam_moi) == 1  # làm mới đúng một lần cho tài khoản 0
+    assert goi_khach == [0, 0]  # thử lại cùng tài khoản, không xoay
+    assert khach[1].so_lan_chay == 0
+
+
+def test_nv309d_lam_moi_hong_thi_xoay_tai_khoan_ke(bo_module, may_chu, monkeypatch):
+    mod, _ = bo_module
+    md, goi_khach, goi_lam_moi, _ = _lap_module_lam_moi_gia(
+        bo_module, may_chu,
+        {0: [mod.LoiPhienGrokWeb("het phien")],
+         1: ["từ tài khoản hai"]},
+        lam_moi_ok=False, monkeypatch=monkeypatch)
+    assert chay(_doc_luong(md)) == "từ tài khoản hai"
+    assert len(goi_lam_moi) == 1
+    assert goi_khach == [0, 1]  # làm mới hỏng → không thử lại, xoay ngay
+
+
+def test_nv309d_thu_lai_van_hong_thi_xoay_chi_lam_moi_mot_lan(bo_module, may_chu, monkeypatch):
+    mod, _ = bo_module
+    md, goi_khach, goi_lam_moi, _ = _lap_module_lam_moi_gia(
+        bo_module, may_chu,
+        {0: [mod.LoiPhienGrokWeb("het phien"),
+             mod.LoiPhienGrokWeb("van het phien")],
+         1: ["từ tài khoản hai"]},
+        lam_moi_ok=True, monkeypatch=monkeypatch)
+    assert chay(_doc_luong(md)) == "từ tài khoản hai"
+    assert len(goi_lam_moi) == 1  # mỗi tài khoản tối đa một lần làm mới
+    assert goi_khach == [0, 0, 1]
+
+
+def test_nv309d_loi_khong_phai_phien_khong_lam_moi(bo_module, may_chu, monkeypatch):
+    mod, _ = bo_module
+    md, goi_khach, goi_lam_moi, _ = _lap_module_lam_moi_gia(
+        bo_module, may_chu,
+        {0: [mod.LoiHanMucGrokWeb("het luot")],
+         1: ["từ tài khoản hai"]},
+        lam_moi_ok=True, monkeypatch=monkeypatch)
+    assert chay(_doc_luong(md)) == "từ tài khoản hai"
+    assert goi_lam_moi == []  # hết lượt thì xoay ngay, không làm mới
+    assert goi_khach == [0, 1]
+
+
+def test_nv309d_loi_phien_sau_khi_co_chu_khong_thu_lai(bo_module, may_chu, monkeypatch):
+    mod, _ = bo_module
+    md, goi_khach, goi_lam_moi, _ = _lap_module_lam_moi_gia(
+        bo_module, may_chu,
+        {0: ["một ", mod.LoiPhienGrokWeb("het phien")]},
+        lam_moi_ok=True, monkeypatch=monkeypatch)
+
+    async def doc_luong_loi():
+        chu = []
+        try:
+            async for m in md._luong_van_ban("fast", "xin chào"):
+                chu.append(m)
+        except mod.LoiPhienGrokWeb:
+            return "".join(chu), True
+        return "".join(chu), False
+
+    van_ban, co_loi = chay(doc_luong_loi())
+    assert (van_ban, co_loi) == ("một ", True)
+    assert goi_lam_moi == []  # đã có chữ: dừng, không thử lại
