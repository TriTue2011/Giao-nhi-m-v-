+class R1PhanHoi(R1MicEntity, BinarySensorEntity):
+    """NV288 — «Loa phản hồi»: bật = loa còn phản hồi, tắt = không phản hồi (treo
+    hoặc mất mạng, phân biệt bằng thuộc tính ``ly_do``). CỐ TÌNH luôn khả dụng:
+    chính cảm biến này là thứ báo loa có tới được không, nên nó không được
+    ``unavailable`` theo loa (khác các thực thể điều khiển loa vốn unavailable khi
+    vòng hỏi hỏng). Đánh giá lại mỗi lần coordinator hỏi xong, khi APK báo nhịp
+    tim, và mỗi 30 giây."""
+
+    _attr_translation_key = "phan_hoi"
+    _attr_device_class = BinarySensorDeviceClass.CONNECTIVITY
+    _attr_entity_category = EntityCategory.DIAGNOSTIC
+
+    def __init__(self, entry: R1ConfigEntry) -> None:
+        super().__init__(entry, "phan_hoi")
+        self._tt = None
+
+    @property
+    def is_on(self) -> bool | None:
+        return self._tt.is_on if self._tt is not None else None
+
+    @property
+    def extra_state_attributes(self) -> dict:
+        if self._tt is None:
+            return {"ly_do": None}
+        return {"ly_do": self._tt.ly_do, **self._tt.thuoc_tinh}
+
+    async def _danh_gia(self, _now=None) -> None:
+        ph = getattr(self._entry.runtime_data, "phan_hoi", None)
+        if ph is None:
+            return
+        self._tt = await ph.danh_gia()
+        self.async_write_ha_state()
+
+    async def async_added_to_hass(self) -> None:
+        await super().async_added_to_hass()
+        await self._danh_gia()
+        # Đưa thẳng coroutine function cho async_track_time_interval để HA tự tạo
+        # task đúng luồng: lambda trả về coroutine bị HassJob xếp loại Callback nên
+        # coroutine không được await; còn tự gọi ``hass.async_create_task`` trong
+        # callback của timer thì HA gắn cờ sai luồng lúc teardown (xem test_bao_thuc).
+        self.async_on_remove(async_track_time_interval(
+            self.hass, self._danh_gia, timedelta(seconds=PHAN_HOI_CHU_KY_S)))
+        coord = self._entry.runtime_data
+        self.async_on_remove(coord.async_add_listener(
+            lambda: self.hass.async_create_task(self._danh_gia())))
+        self.async_on_remove(coord.talk.add_listener(
+            lambda: self.hass.async_create_task(self._danh_gia())))
+
