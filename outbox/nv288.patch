+
+    def __init__(self, entry: R1ConfigEntry) -> None:
+        super().__init__(entry, "lich_gio")
+
+    @property
+    def native_value(self) -> datetime.time | None:
+        g = lich_gio(self._entry)
+        return datetime.time(g[0], g[1]) if g is not None else None
+
+    async def async_set_value(self, value: datetime.time) -> None:
+        dat_tuy_chon(self.hass, self._entry, CONF_LICH_GIO,
+                     f"{value.hour:02d}:{value.minute:02d}", DEFAULT_LICH_GIO)
+        self.async_write_ha_state()
