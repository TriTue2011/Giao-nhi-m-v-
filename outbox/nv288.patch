+"""NV288 — khởi động lại theo lịch + cảm biến «Loa phản hồi» + tự phục hồi khi treo.
+
+ĐỎ-TRƯỚC-XANH: các test này import ``phan_hoi`` và ``khoi_dong_lai`` (mới hoàn toàn);
+trên mã cũ chúng đỏ vì thiếu module — đúng lý do, không phải do test sai.
+
+Ngưỡng trong test là NGƯỠNG CHƯA ĐO (chủ máy 02/11/2026: chưa có nhật ký lần treo thật
+nào): test chỉ khẳng định hành vi theo hằng số đã đặt tên trong ``const.py``, không khẳng
+định ngưỡng đó là đúng trên loa thật.
+"""
+
+import asyncio
+import re
+import time
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from custom_components.r1_speaker import const
+from custom_components.r1_speaker.phan_hoi import PhanHoi, TinHieu
+from custom_components.r1_speaker.khoi_dong_lai import LichKhoiDong
+
+TZ = timezone(timedelta(hours=7))
+
+
+class KhoGia:
+    """Store giả: chỉ nhớ dict đã lưu."""
+
+    def __init__(self, ban_dau=None):
+        self.du_lieu = ban_dau
+
+    async def async_load(self):
+        return self.du_lieu
+
+    async def async_save(self, data):
+        self.du_lieu = data
+
+
+class DongHo:
+    """Giờ giả: ``bay_gio`` (wall) + ``monotonic`` cùng tiến khi ``tien``."""
+
+    def __init__(self, bat_dau):
+        self.hien = bat_dau
+        self._mono = 1000.0
+
+    def bay_gio(self):
+        return self.hien
+
+    def monotonic(self):
+        return self._mono
+
+    def tien(self, **kwargs):
+        self.hien += timedelta(**kwargs)
+        self._mono += timedelta(**kwargs).total_seconds()
+
+
+class MucGia:
+    """Một mục cấu hình giả: chỉ cần ``options``/``data`` cho các helper ``settings``."""
+
+    def __init__(self, **tuy_chon):
+        self.options = tuy_chon
+        self.data = {}
+
+
+def muc_lich(bat=True, gio="03:00", ngay=(0, 1, 2, 3, 4, 5, 6), tu_phuc_hoi=False):
+    return MucGia(lich_khoi_dong_lai=bat, lich_gio=gio, lich_ngay=list(ngay),
+                  tu_phuc_hoi_khi_treo=tu_phuc_hoi)
+
+
+def lich_moi(dong_ho, muc, kho=None, ban=None, khoi_dong=None, phan_hoi=None, adb=None):
+    goi = []
+
+    async def _khoi(ly_do):
+        goi.append(ly_do)
+
+    return LichKhoiDong(
+        None, muc, store=kho or KhoGia(), bay_gio=dong_ho.bay_gio, ban=ban or (lambda: False),
+        khoi_dong_lai=khoi_dong or _khoi, phan_hoi=phan_hoi,
+        adb_con_nghe=adb or (lambda: asyncio.sleep(0, result=True))), goi
+
+
+# ── Lịch: giờ/ngày ────────────────────────────────────────────────────────────
+
+async def test_lich_tat_khong_chay():
+    dh = DongHo(datetime(2026, 11, 4, 3, 0, tzinfo=TZ))          # thứ Tư
+    lich, goi = lich_moi(dh, muc_lich(bat=False))
+    assert await lich.tick() == "tat"
+    assert goi == []
+
+
+async def test_dung_gio_dung_ngay_chay_dung_mot_lan():
+    dh = DongHo(datetime(2026, 11, 4, 2, 59, tzinfo=TZ))
+    lich, goi = lich_moi(dh, muc_lich())
+    assert await lich.tick() == "chua_toi_gio"
+    dh.tien(minutes=2)
+    assert await lich.tick() == "chay"
+    assert goi == ["lich"]
+    assert await lich.tick() == "da_chay"                          # cùng ngày không chạy lại
+    assert goi == ["lich"]
+
+
+async def test_ngay_khong_chon_khong_chay():
+    dh = DongHo(datetime(2026, 11, 4, 3, 0, tzinfo=TZ))          # thứ Tư (weekday 2)
+    lich, goi = lich_moi(dh, muc_lich(ngay=(0,)))                  # chỉ thứ Hai
+    assert await lich.tick() == "khong_phai_ngay"
+    assert goi == []
+
+
+async def test_qua_nua_dem_doi_ngay_dung():
+    dh = DongHo(datetime(2026, 11, 4, 23, 30, tzinfo=TZ))
+    lich, goi = lich_moi(dh, muc_lich(gio="23:30"))
+    assert await lich.tick() == "chay"
+    dh.tien(minutes=40)                                            # sang 00:10 ngày mới
+    assert await lich.tick() == "chua_toi_gio"                     # lịch hôm nay chưa tới, không chạy bù hôm qua
+    dh.tien(hours=23, minutes=20)                                  # 23:30 ngày mới
+    assert await lich.tick() == "chay"
+    assert goi == ["lich", "lich"]
+
+
+async def test_co_nho_da_chay_qua_khoi_dong_lai_ha():
+    dh = DongHo(datetime(2026, 11, 4, 3, 0, tzinfo=TZ))
+    kho = KhoGia()
+    lich, goi = lich_moi(dh, muc_lich(), kho=kho)
+    assert await lich.tick() == "chay"
+    lich2, _ = lich_moi(dh, muc_lich(), kho=kho)                   # HA khởi động lại: nạp lại từ kho
+    await lich2.async_load()
+    assert await lich2.tick() == "da_chay"
+
+
+async def test_gio_sai_khong_vo():
+    dh = DongHo(datetime(2026, 11, 4, 3, 0, tzinfo=TZ))
+    lich, goi = lich_moi(dh, muc_lich(gio="25:99"))
+    assert await lich.tick() == "gio_sai"
+    assert goi == []
+
+
+# ── Lịch: hoãn khi bận ────────────────────────────────────────────────────────
+
+async def test_dang_ban_thi_hoan_roi_chay_khi_ranh():
+    dh = DongHo(datetime(2026, 11, 4, 3, 0, tzinfo=TZ))
+    ban = {"co": True}
+    lich, goi = lich_moi(dh, muc_lich(), ban=lambda: ban["co"])
+    assert await lich.tick() == "hoan"
+    assert goi == []
+    dh.tien(minutes=10)
+    assert await lich.tick() == "hoan"                             # vẫn bận, chưa quá hạn hoãn
+    ban["co"] = False
+    assert await lich.tick() == "chay"
+    assert goi == ["lich"]
+
+
+async def test_ban_qua_han_hoan_thi_bo_qua_ngay_khong_khoi_dong_vao_phien():
+    dh = DongHo(datetime(2026, 11, 4, 3, 0, tzinfo=TZ))
+    lich, goi = lich_moi(dh, muc_lich(), ban=lambda: True)
+    assert await lich.tick() == "hoan"
+    dh.tien(minutes=const.LICH_HOAN_TOI_DA_PHUT + 1)
+    assert await lich.tick() == "bo_qua"                           # quá hạn mà vẫn bận: bỏ, không reboot vào phiên
+    assert goi == []
+    assert await lich.tick() == "da_chay"
+
+
+# ── Cảm biến «Loa phản hồi»: phân loại ───────────────────────────────────────
+
+def phan_hoi_moi(tuoi_get_info, heartbeat, tcp):
+    tin = TinHieu(get_info_tuoi_s=tuoi_get_info, heartbeat_song=heartbeat, adb_noi=None)
+
+    async def _tcp():
+        return tcp
+
+    return PhanHoi(lambda: tin, tcp_kiem_tra=_tcp, monotonic=lambda: 1000.0)
+
+
+async def test_get_info_moi_la_binh_thuong():
+    ph = phan_hoi_moi(5.0, False, False)
+    tt = await ph.danh_gia()
+    assert (tt.is_on, tt.ly_do) == (True, "binh_thuong")
+
+
+async def test_im_trong_grace_giu_trang_thai_cu_khong_dao():
+    ph = phan_hoi_moi(60.0, False, True)
+    tt = await ph.danh_gia()
+    assert (tt.is_on, tt.ly_do) == (True, "binh_thuong")           # chưa quá ngưỡng treo: chưa kết luận
+
+
+async def test_mang_thong_nhung_tin_hieu_im_qua_nguong_la_treo():
+    ph = phan_hoi_moi(300.0, False, True)
+    tt = await ph.danh_gia()
+    assert (tt.is_on, tt.ly_do) == (False, "treo")
+
+
+async def test_tcp_khong_noi_la_mat_mang():
+    ph = phan_hoi_moi(300.0, False, False)
+    tt = await ph.danh_gia()
+    assert (tt.is_on, tt.ly_do) == (False, "mat_mang")
+
+
+async def test_nhip_tim_con_song_thi_khong_ket_luan_treo():
+    ph = phan_hoi_moi(300.0, True, True)
+    tt = await ph.danh_gia()
+    assert (tt.is_on, tt.ly_do) == (True, "binh_thuong")           # APK còn sống: chưa đủ «mọi tín hiệu im»
+
+
+async def test_khoi_phuc_lai_binh_thuong_khi_get_info_co_lai():
+    ph = phan_hoi_moi(300.0, False, True)
+    assert (await ph.danh_gia()).ly_do == "treo"
+    ph._lay = lambda: TinHieu(get_info_tuoi_s=5.0, heartbeat_song=False, adb_noi=None)
+    tt = await ph.danh_gia()
+    assert (tt.is_on, tt.ly_do) == (True, "binh_thuong")
+
+
+# ── Tự phục hồi khi treo ─────────────────────────────────────────────────────
+
+async def test_tu_phuc_hoi_chi_khi_treo_qua_nguong_adb_noi_va_dung_mot_lan():
+    dh = DongHo(datetime(2026, 11, 4, 10, 0, tzinfo=TZ))
+    ph = phan_hoi_moi(300.0, False, True)
+    await ph.danh_gia()
+    ph._treo_tu = dh.monotonic() - (const.PHUC_HOI_SAU_S + 1)
+    lich, goi = lich_moi(dh, muc_lich(bat=False, tu_phuc_hoi=True), phan_hoi=ph)
+    assert await lich.tick() == "tu_phuc_hoi"
+    assert goi == ["treo"]
+    assert lich.lan_khoi_dong_lai_cuoi["ly_do"] == "treo"
+    assert await lich.tick() == "tat"                              # lịch tắt; tự phục hồi đã vào nghỉ
+    # Treo lại ngay trong thời gian nghỉ: không reboot lần nữa.
+    ph._treo_tu = dh.monotonic() - (const.PHUC_HOI_SAU_S + 1)
+    lich2, goi2 = lich_moi(dh, muc_lich(bat=False, tu_phuc_hoi=True), phan_hoi=ph)
+    lich2._lan_tu_phuc_hoi = dh.bay_gio().isoformat()
+    assert await lich2.tick() == "nghi"
+    assert goi2 == []
+
+
+async def test_tu_phuc_hoi_tat_thi_khong_tu_chay():
+    dh = DongHo(datetime(2026, 11, 4, 10, 0, tzinfo=TZ))
+    ph = phan_hoi_moi(300.0, False, True)
+    await ph.danh_gia()
+    ph._treo_tu = dh.monotonic() - (const.PHUC_HOI_SAU_S + 1)
+    lich, goi = lich_moi(dh, muc_lich(bat=False, tu_phuc_hoi=False), phan_hoi=ph)
+    assert await lich.tick() == "tat"
+    assert goi == []
+
+
+async def test_mat_mang_khong_tu_phuc_hoi():
+    dh = DongHo(datetime(2026, 11, 4, 10, 0, tzinfo=TZ))
+    ph = phan_hoi_moi(300.0, False, False)
+    await ph.danh_gia()
+    lich, goi = lich_moi(dh, muc_lich(bat=False, tu_phuc_hoi=True), phan_hoi=ph)
+    assert await lich.tick() == "tat"
+    assert goi == []
+
+
+async def test_adb_khong_noi_thi_khong_tu_phuc_hoi():
+    dh = DongHo(datetime(2026, 11, 4, 10, 0, tzinfo=TZ))
+    ph = phan_hoi_moi(300.0, False, True)
+    await ph.danh_gia()
+    ph._treo_tu = dh.monotonic() - (const.PHUC_HOI_SAU_S + 1)
+
+    async def _adb_khong():
+        return False
+
+    lich, goi = lich_moi(dh, muc_lich(bat=False, tu_phuc_hoi=True), phan_hoi=ph, adb=_adb_khong)
+    assert await lich.tick() == "cho_adb"                         # ADB không nối được: chờ, không reboot
+    assert goi == []
+
+
+# ── Ghi lần khởi động lại cuối ────────────────────────────────────────────────
+
+async def test_ghi_khoi_dong_lai_bam():
+    dh = DongHo(datetime(2026, 11, 4, 10, 0, tzinfo=TZ))
+    lich, _ = lich_moi(dh, muc_lich())
+    await lich.ghi_khoi_dong_lai("bam", luc=dh.bay_gio())
+    assert lich.lan_khoi_dong_lai_cuoi == {"luc": "2026-11-04T10:00:00+07:00", "ly_do": "bam"}
