+async def tcp_8080(host: str, cong: int) -> bool:
+    """Thử bắt tay TCP tới cổng điều khiển (không nói giao thức gì thêm)."""
+    try:
+        _doc, ghi = await asyncio.wait_for(asyncio.open_connection(host, cong),
+                                           timeout=PHAN_HOI_TCP_TIMEOUT_S)
+    except (OSError, asyncio.TimeoutError):
+        return False
+    ghi.close()
+    try:
+        await ghi.wait_closed()
+    except OSError:
+        pass
+    return True
