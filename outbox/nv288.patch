@@ -0,0 +1,126 @@
+"""NV288 — thực thể + options flow: ghi tuỳ chọn qua thực thể, bước lịch, cảm biến
+«Loa phản hồi» ở mức tích hợp, nút bấm ghi lý do «bam».
+
+Dùng ``_them`` (tích hợp thật + loa giả) như các test khác; không dùng loa thật.
+"""
+
+import time
+from datetime import datetime, timezone
+from unittest.mock import AsyncMock
+
+import pytest
+
+from homeassistant.components import button as button_comp
+from homeassistant.components import switch as switch_comp
+from homeassistant.components import time as time_comp
+
+from custom_components.r1_speaker.client import R1Error
+from tests.test_bo_dam import _them
+
+
+async def _goi_dich_vu(hass, mien, dich_vu, thuc_the, **them):
+    await hass.services.async_call(mien, dich_vu, {"entity_id": thuc_the, **them}, blocking=True)
+    await hass.async_block_till_done()
+
+
+async def _cau_hinh(hass, e, tuy_chon):
+    res = await hass.config_entries.options.async_init(e.entry_id)
+    res = await hass.config_entries.options.async_configure(res["flow_id"], tuy_chon)
+    await hass.async_block_till_done()
+    return res
+
+
+async def test_buoc_lich_luu_dung_va_gio_sai_bao_loi(hass, r1):
+    e = await _them(hass, r1)
+    res = await hass.config_entries.options.async_init(e.entry_id)
+    res = await hass.config_entries.options.async_configure(
+        res["flow_id"], {"host": "127.0.0.1", "port": r1.port, "lich": True})
+    assert res["type"].name == "FORM" and res["step_id"] == "lich"
+    assert {str(k) for k in res["data_schema"].schema} == {
+        "lich_khoi_dong_lai", "lich_gio", "lich_thu_2", "lich_thu_3", "lich_thu_4", "lich_thu_5",
+        "lich_thu_6", "lich_thu_7", "lich_chu_nhat", "tu_phuc_hoi_khi_treo"}
+    # Giờ sai dạng → báo lỗi, không lưu.
+    res = await hass.config_entries.options.async_configure(
+        res["flow_id"], {"lich_khoi_dong_lai": True, "lich_gio": "25:99", "lich_thu_2": True,
+                         "tu_phuc_hoi_khi_treo": False})
+    assert res["errors"] == {"lich_gio": "gio_sai"}
+    # Giờ đúng → lưu: chỉ thứ Hai, bật lịch + tự phục hồi.
+    res = await hass.config_entries.options.async_configure(
+        res["flow_id"], {"lich_khoi_dong_lai": True, "lich_gio": "04:30", "lich_thu_2": True,
+                         "lich_thu_3": False, "lich_thu_4": False, "lich_thu_5": False,
+                         "lich_thu_6": False, "lich_thu_7": False, "lich_chu_nhat": False,
+                         "tu_phuc_hoi_khi_treo": True})
+    await hass.async_block_till_done()
+    tuy_chon = hass.config_entries.async_get_entry(e.entry_id).options
+    assert tuy_chon["lich_khoi_dong_lai"] is True
+    assert tuy_chon["lich_gio"] == "04:30"
+    assert tuy_chon["lich_ngay"] == [0]
+    assert tuy_chon["tu_phuc_hoi_khi_treo"] is True
+
+
+async def test_bo_qua_buoc_lich_thi_giu_lich_cu(hass, r1):
+    e = await _them(hass, r1)
+    hass.config_entries.async_update_entry(
+        e, options={"lich_khoi_dong_lai": True, "lich_gio": "04:30", "lich_ngay": [0, 2]})
+    await _cau_hinh(hass, e, {"host": "127.0.0.1", "port": r1.port})
+    tuy_chon = hass.config_entries.async_get_entry(e.entry_id).options
+    assert tuy_chon["lich_khoi_dong_lai"] is True and tuy_chon["lich_gio"] == "04:30"
+    assert tuy_chon["lich_ngay"] == [0, 2]
+
+
+async def test_cong_tac_lich_ghi_tuy_chon_va_nguoc_lai(hass, r1):
+    e = await _them(hass, r1)
+    await _goi_dich_vu(hass, "switch", "turn_on", "switch.r1_lich_khoi_dong_lai")
+    assert hass.config_entries.async_get_entry(e.entry_id).options["lich_khoi_dong_lai"] is True
+    assert hass.states.get("switch.r1_lich_khoi_dong_lai").state == "on"
+    await _goi_dich_vu(hass, "switch", "turn_off", "switch.r1_lich_khoi_dong_lai")
+    # Tắt = giá trị mặc định → khoá bị gỡ khỏi options (quy tắc _overrides).
+    assert "lich_khoi_dong_lai" not in hass.config_entries.async_get_entry(e.entry_id).options
+    assert hass.states.get("switch.r1_lich_khoi_dong_lai").state == "off"
+
+
+async def test_cong_tac_ngay_va_gio_lich_ghi_tuy_chon(hass, r1):
+    e = await _them(hass, r1)
+    await _goi_dich_vu(hass, "switch", "turn_off", "switch.r1_lich_thu_2")
+    assert hass.config_entries.async_get_entry(e.entry_id).options["lich_ngay"] == [1, 2, 3, 4, 5, 6]
+    await _goi_dich_vu(hass, "switch", "turn_on", "switch.r1_lich_thu_2")
+    assert "lich_ngay" not in hass.config_entries.async_get_entry(e.entry_id).options
+    await _goi_dich_vu(hass, "time", "set_value", "time.r1_lich_gio", time="04:30:00")
+    assert hass.config_entries.async_get_entry(e.entry_id).options["lich_gio"] == "04:30"
+    assert hass.states.get("time.r1_lich_gio").state == "04:30:00"
+
+
+async def test_cam_bien_phan_hoi_treo_roi_hoi_phuc(hass, r1):
+    e = await _them(hass, r1)
+    coord = e.runtime_data
+    cam_bien = "binary_sensor.r1_loa_phan_hoi"
+    assert hass.states.get(cam_bien).state == "on"                # loa giả đang khoẻ
+    # Ép tín hiệu cũ: get_info im 300 giây, nhịp tim im, nhưng cổng 8080 (loa giả) còn nối → treo.
+    coord.lan_cuoi_thanh_cong = time.monotonic() - 300
+    from datetime import timedelta
+    coord.talk.last_alive = datetime.now(timezone.utc) - timedelta(seconds=300)
+    goc = coord.client.async_fetch
+    coord.client.async_fetch = AsyncMock(side_effect=R1Error("gia lap hong"))
+    await coord.async_refresh()                                   # vòng hỏi hỏng → cảm biến đánh giá lại
+    await hass.async_block_till_done()
+    st = hass.states.get(cam_bien)
+    assert st.state == "off" and st.attributes["ly_do"] == "treo"
+    assert st.attributes["tcp_8080"] == "ket_noi"                 # mạng thông: đây là treo, không phải mất mạng
+    assert coord.talk.last_alive is not None
+    # Loa trả lại get_info → cảm biến hồi phục, không kẹt ở off.
+    coord.client.async_fetch = goc
+    await coord.async_refresh()
+    await hass.async_block_till_done()
+    st = hass.states.get(cam_bien)
+    assert st.state == "on" and st.attributes["ly_do"] == "binh_thuong"
+
+
+async def test_nut_bam_ghi_lan_khoi_dong_lai_cuoi_la_bam(hass, r1):
+    e = await _them(hass, r1)
+    e.runtime_data.apps.dev.reboot = AsyncMock()                  # không reboot loa giả thật
+    await _goi_dich_vu(hass, "button", "press", "button.r1_khoi_dong_lai")
+    lich = e.runtime_data.lich
+    assert lich.lan_khoi_dong_lai_cuoi["ly_do"] == "bam"
+    st = hass.states.get("sensor.r1_lan_khoi_dong_lai_cuoi")
+    assert st.state not in ("unknown", "unavailable")
+    assert st.attributes["ly_do"] == "bam"
