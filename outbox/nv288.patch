diff --git a/custom_components/r1_speaker/khoi_dong_lai.py b/custom_components/r1_speaker/khoi_dong_lai.py
new file mode 100644
index 0000000..73916a5
--- /dev/null
+++ b/custom_components/r1_speaker/khoi_dong_lai.py
@@ -0,0 +1,223 @@
+"""Khởi động lại loa theo lịch + tự phục hồi khi treo (NV288).
+
+Đường khởi động lại dùng chung với nút «Khởi động lại loa» (``button.py``): ADB
+trước, hỏng thì cổng 8080. Mọi lần khởi động lại đều ghi lý do (``lich`` / ``treo`` /
+``bam``) vào «lần khởi động lại cuối» để thẻ hiện.
+
+Lịch (mặc định TẮT, phòng ngừa — chủ máy 02/11/2026 yêu cầu làm kể cả khi chưa có
+bằng chứng treo):
+
+* Tới giờ + đúng ngày trong tuần + chưa chạy hôm nay → kiểm loa bận không (phiên
+  Assist, đàm thoại song công, nhạc đang phát). Bận thì hoãn tối đa
+  ``LICH_HOAN_TOI_DA_PHUT`` phút; quá hạn mà vẫn bận thì BỎ lịch hôm đó (không reboot
+  vào giữa phiên).
+* Cờ «đã chạy hôm nay» lưu bền (Store) nên HA khởi động lại giữa chừng cũng không
+  chạy hai lần một ngày; qua nửa đêm đổi ngày đúng (không chạy bù ngày cũ).
+
+Tự phục hồi (mặc định TẮT, công tắc riêng): treo kéo dài quá ``PHUC_HOI_SAU_S``
+giây, ADB còn nghe được (thử bắt tay TCP cổng 5555, không nói giao thức ADB) thì
+khởi động lại MỘT lần bằng ADB, rồi nghỉ ít nhất ``PHUC_HOI_NGHI_GIO`` giờ — không
+bao giờ vòng lặp. Mất mạng thì KHÔNG tự phục hồi (HA không tới được loa từ xa).
+
+``LichKhoiDong`` không phụ thuộc HA trừ Store/timer: test truyền ``store``,
+``bay_gio``, ``ban``, ``khoi_dong_lai`` giả. Nhịp thật do ``start()`` gắn
+(``async_track_time_interval`` mỗi ``LICH_CHU_KY_S`` giây).
+"""
+
+from __future__ import annotations
+
+import logging
+from datetime import datetime, timedelta
+from typing import Any, Awaitable, Callable
+
+from homeassistant.core import HomeAssistant
+from homeassistant.exceptions import HomeAssistantError
+from homeassistant.helpers.event import async_track_time_interval
+
+from .adb_client import AdbError
+from .client import R1Error
+from .const import (LICH_CHU_KY_S, LICH_HOAN_TOI_DA_PHUT, PHUC_HOI_NGHI_GIO,
+                    PHUC_HOI_SAU_S)
+from .settings import lich_bat, lich_gio, lich_ngay, tu_phuc_hoi
+
+_LOGGER = logging.getLogger(__name__)
+
+LY_DO_LICH, LY_DO_TREO, LY_DO_BAM = "lich", "treo", "bam"
+
+
+async def khoi_dong_lai_loa(coordinator, ly_do: str) -> None:
+    """Đường khởi động lại đã có ở nút bấm: ADB trước, hỏng thì cổng 8080.
+    Ghi log lý do; hỏng cả hai đường thì ném ``HomeAssistantError`` như nút cũ."""
+    _LOGGER.warning("R1: khởi động lại loa (lý do: %s)", ly_do)
+    try:
+        await coordinator.apps.dev.reboot()
+        return
+    except (AdbError, OSError, TimeoutError) as exc:
+        loi_adb = exc or type(exc).__name__
+    try:
+        await coordinator.client.reboot_shell()
+    except R1Error as exc:
+        raise HomeAssistantError(
+            f"Không khởi động lại được loa (ADB: {loi_adb}; cổng 8080: {exc})") from exc
+
+
+class LichKhoiDong:
+    """Trạng thái + nhịp lịch khởi động lại của một loa."""
+
+    def __init__(self, hass: HomeAssistant | None, entry, *, store=None,
+                 bay_gio: Callable[[], datetime] | None = None,
+                 ban: Callable[[], bool] | None = None,
+                 khoi_dong_lai: Callable[[str], Awaitable[None]] | None = None,
+                 phan_hoi=None,
+                 adb_con_nghe: Callable[[], Awaitable[bool]] | None = None) -> None:
+        self.hass = hass
+        self._entry = entry
+        self._store = store
+        self._bay_gio = bay_gio
+        self._ban = ban or (lambda: False)
+        self._khoi_dong_lai = khoi_dong_lai
+        self._phan_hoi = phan_hoi
+        self._adb_con_nghe = adb_con_nghe
+        self._da_chay_ngay: str | None = None
+        self._hoan_den: datetime | None = None
+        self._lan_khoi_dong_lai_cuoi: dict | None = None
+        self._lan_tu_phuc_hoi: str | None = None
+        self._nghe: list[Callable[[], None]] = []
+        self._unsub = None
+
+    # ── Trạng thái cho thực thể ──────────────────────────────────────────────
+    @property
+    def lan_khoi_dong_lai_cuoi(self) -> dict | None:
+        """``{"luc": iso, "ly_do": lich|treo|bam}`` hoặc None."""
+        return self._lan_khoi_dong_lai_cuoi
+
+    def add_state_listener(self, cb: Callable[[], None]) -> Callable[[], None]:
+        self._nghe.append(cb)
+        return lambda: self._nghe.remove(cb)
+
+    def _thong_bao(self) -> None:
+        for cb in list(self._nghe):
+            cb()
+
+    async def async_load(self) -> None:
+        """Nạp cờ bền từ Store (không có Store thì thôi, không vỡ)."""
+        if self._store is None:
+            return
+        try:
+            data = await self._store.async_load()
+        except Exception:                                       # noqa: BLE001 - kho hỏng thì chạy với trạng thái mới
+            _LOGGER.warning("R1: không đọc được kho lịch khởi động lại, dùng trạng thái mới")
+            return
+        if not isinstance(data, dict):
+            return
+        self._da_chay_ngay = data.get("da_chay_ngay")
+        if isinstance(data.get("lan_khoi_dong_lai_cuoi"), dict):
+            self._lan_khoi_dong_lai_cuoi = data["lan_khoi_dong_lai_cuoi"]
+        self._lan_tu_phuc_hoi = data.get("lan_tu_phuc_hoi")
+
+    async def _luu(self) -> None:
+        if self._store is None:
+            return
+        try:
+            await self._store.async_save({
+                "da_chay_ngay": self._da_chay_ngay,
+                "lan_khoi_dong_lai_cuoi": self._lan_khoi_dong_lai_cuoi,
+                "lan_tu_phuc_hoi": self._lan_tu_phuc_hoi})
+        except Exception:                                       # noqa: BLE001 - kho hỏng thì lần sau nạp lại trạng thái cũ
+            _LOGGER.warning("R1: không lưu được kho lịch khởi động lại")
+
+    def start(self) -> None:
+        """Gắn nhịp 60 giây (chỉ khi có hass; test gọi ``tick`` trực tiếp).
+        ``tick`` là coroutine nên đưa thẳng cho ``async_track_time_interval`` để HA
+        tự tạo task đúng luồng (không tự gọi ``async_create_task`` trong callback)."""
+        if self.hass is None or self._unsub is not None:
+            return
+        self._unsub = async_track_time_interval(
+            self.hass, self.tick, timedelta(seconds=LICH_CHU_KY_S))
+
+    def dung(self) -> None:
+        if self._unsub is not None:
+            self._unsub()
+            self._unsub = None
+
+    async def ghi_khoi_dong_lai(self, ly_do: str, luc: datetime | None = None) -> None:
+        """Ghi «lần khởi động lại cuối» (gọi SAU khi lệnh reboot đã chạy; nút bấm và
+        lịch đều qua đây để thẻ hiện đúng lý do)."""
+        now = luc or (self._bay_gio() if self._bay_gio else datetime.now().astimezone())
+        self._lan_khoi_dong_lai_cuoi = {"luc": now.isoformat(), "ly_do": ly_do}
+        await self._luu()
+        self._thong_bao()
+
+    def _bay_gio_hien(self, now: datetime | None) -> datetime:
+        if now is not None:
+            return now
+        if self._bay_gio is not None:
+            return self._bay_gio()
+        from homeassistant.util import dt as dt_util
+        return dt_util.now()
+
+    async def _tu_phuc_hoi(self, now: datetime) -> str | None:
+        """Đánh giá tự phục hồi; trả ``"tu_phuc_hoi"`` nếu đã reboot, ``"nghi"`` nếu
+        đang trong thời gian nghỉ, ``"cho_adb"`` nếu ADB chưa nối được, None nếu
+        không thuộc diện tự phục hồi."""
+        if not tu_phuc_hoi(self._entry) or self._phan_hoi is None:
+            return None
+        tt = await self._phan_hoi.danh_gia()
+        if tt.ly_do != "treo":
+            return None
+        tuoi = self._phan_hoi.treo_tuoi_s
+        if tuoi is None or tuoi < PHUC_HOI_SAU_S:
+            return None
+        if self._lan_tu_phuc_hoi is not None:
+            try:
+                lan = datetime.fromisoformat(self._lan_tu_phuc_hoi)
+            except ValueError:
+                lan = None
+            if lan is not None and now - lan < timedelta(hours=PHUC_HOI_NGHI_GIO):
+                return "nghi"
+        if self._adb_con_nghe is not None and not await self._adb_con_nghe():
+            return "cho_adb"
+        if self._khoi_dong_lai is not None:
+            await self._khoi_dong_lai(LY_DO_TREO)
+        self._lan_tu_phuc_hoi = now.isoformat()
+        await self.ghi_khoi_dong_lai(LY_DO_TREO, luc=now)
+        self._phan_hoi.dat_lai_treo()
+        return "tu_phuc_hoi"
+
+    async def tick(self, now: datetime | None = None) -> str:
+        """Một nhịp đánh giá; trả mã hành động để test khẳng định được."""
+        now = self._bay_gio_hien(now)
+        tu_phuc = await self._tu_phuc_hoi(now)
+        if tu_phuc is not None:
+            return tu_phuc
+        if not lich_bat(self._entry):
+            return "tat"
+        gio = lich_gio(self._entry)
+        if gio is None:
+            return "gio_sai"
+        hom_nay = now.date()
+        if self._da_chay_ngay == hom_nay.isoformat():
+            return "da_chay"
+        if hom_nay.weekday() not in lich_ngay(self._entry):
+            return "khong_phai_ngay"
+        lich_dt = now.replace(hour=gio[0], minute=gio[1], second=0, microsecond=0)
+        if now < lich_dt:
+            return "chua_toi_gio"
+        if self._ban():
+            if self._hoan_den is None:
+                self._hoan_den = now + timedelta(minutes=LICH_HOAN_TOI_DA_PHUT)
+            if now < self._hoan_den:
+                return "hoan"
+            self._da_chay_ngay = hom_nay.isoformat()
+            self._hoan_den = None
+            await self._luu()
+            _LOGGER.warning(
+                "R1: bỏ lịch khởi động lại hôm nay vì loa bận quá %s phút",
+                LICH_HOAN_TOI_DA_PHUT)
+            return "bo_qua"
+        if self._khoi_dong_lai is not None:
+            await self._khoi_dong_lai(LY_DO_LICH)
+        self._da_chay_ngay = hom_nay.isoformat()
+        self._hoan_den = None
+        await self.ghi_khoi_dong_lai(LY_DO_LICH, luc=now)
+        return "chay"
diff --git a/custom_components/r1_speaker/phan_hoi.py b/custom_components/r1_speaker/phan_hoi.py
new file mode 100644
index 0000000..70830c6
--- /dev/null
+++ b/custom_components/r1_speaker/phan_hoi.py
@@ -0,0 +1,142 @@
+"""Cảm biến «Loa phản hồi» (NV288): loa còn phản hồi không, và nếu không thì do «treo»
+hay «mất mạng».
+
+Tín hiệu (độc lập, không tín hiệu nào tự kết luận một mình):
+
+* ``get_info`` qua cổng 8080 (vòng hỏi của coordinator): lần cuối thành công lúc nào.
+* Nhịp tim APK ``speaker_alive`` (trigger / nhịp tim trong ``dam_thoai.py``).
+* ADB: cổng 5555 có đang nối không (chỉ là thuộc tính kèm theo; ADB là tín hiệu hệ
+  thống, không phủ quyết kết luận treo — treo định nghĩa theo tín hiệu ỨNG DỤNG).
+* TCP 8080: chỉ thử khi get_info đã im (không thử lúc loa đang khoẻ để khỏi thêm
+  kết nối); TCP nối được mà ứng dụng im = mạng thông, ứng dụng chết.
+
+Phân loại (ngưỡng CHƯA ĐO — xem ``const.py``):
+
+* get_info mới hơn ``PHAN_HOI_BINH_THUONG_S`` → bật / ``binh_thuong``.
+* get_info im từ ``PHAN_HOI_BINH_THUONG_S`` tới ``PHAN_HOI_TREO_S`` → GIỮ trạng thái
+  cũ (không dao động vì một thoáng mất tín hiệu).
+* get_info im quá ``PHAN_HOI_TREO_S``: TCP 8080 nối được mà nhịp tim im → tắt /
+  ``treo``; TCP không nối được → tắt / ``mat_mang``; nhịp tim còn sống (APK còn sống
+  nghĩa là chưa đủ «mọi tín hiệu ứng dụng im») → giữ trạng thái cũ.
+* Chưa từng get_info thành công: tuổi = vô cùng, đi nhánh phân loại như trên.
+
+Log WARNING đúng MỘT LẦN mỗi lần đổi ``ly_do`` (vào treo / mất mạng / hồi phục),
+không spam mỗi nhịp. Đánh giá là hàm bất đồng bộ vì có thể phải thử TCP.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+import time
+from dataclasses import dataclass, field
+from typing import Any, Awaitable, Callable
+
+from .const import PHAN_HOI_BINH_THUONG_S, PHAN_HOI_TCP_TIMEOUT_S, PHAN_HOI_TREO_S
+
+_LOGGER = logging.getLogger(__name__)
+
+
+@dataclass(frozen=True)
+class TinHieu:
+    """Một lần đọc các tín hiệu. ``get_info_tuoi_s=None`` = chưa từng thành công."""
+
+    get_info_tuoi_s: float | None
+    heartbeat_song: bool
+    adb_noi: bool | None
+    get_info_luc: str | None = None
+    nhip_tim_luc: str | None = None
+
+
+@dataclass(frozen=True)
+class TrangThaiPhanHoi:
+    is_on: bool
+    ly_do: str                                   # binh_thuong | treo | mat_mang
+    thuoc_tinh: dict = field(default_factory=dict)
+
+
+class PhanHoi:
+    """Bộ đánh giá «Loa phản hồi». Không giữ trạng thái HA, chỉ giữ trạng thái cũ để
+    chống dao động + thời điểm bắt đầu treo (phục vụ tự phục hồi của NV288)."""
+
+    def __init__(self, lay_tin_hieu: Callable[[], TinHieu],
+                 tcp_kiem_tra: Callable[[], Awaitable[bool | None]] | None = None,
+                 monotonic: Callable[[], float] | None = None) -> None:
+        self._lay = lay_tin_hieu
+        self._tcp = tcp_kiem_tra
+        self._mono = monotonic or time.monotonic
+        self._truoc: TrangThaiPhanHoi | None = None
+        self._treo_tu: float | None = None
+
+    @property
+    def trang_thai(self) -> TrangThaiPhanHoi | None:
+        """Kết quả lần đánh giá gần nhất (None = chưa đánh giá lần nào)."""
+        return self._truoc
+
+    @property
+    def treo_tuoi_s(self) -> float | None:
+        """Số giây đã treo liên tục (None = hiện không treo)."""
+        return None if self._treo_tu is None else self._mono() - self._treo_tu
+
+    def dat_lai_treo(self) -> None:
+        """Quên mốc bắt đầu treo (gọi sau một lần tự phục hồi)."""
+        self._treo_tu = None
+
+    async def _thu_tcp(self) -> bool | None:
+        if self._tcp is None:
+            return None
+        try:
+            return await self._tcp()
+        except (OSError, asyncio.TimeoutError):
+            return False
+
+    async def danh_gia(self) -> TrangThaiPhanHoi:
+        th = self._lay()
+        tuoi = th.get_info_tuoi_s
+        attrs: dict[str, Any] = {
+            "lan_cuoi_get_info": th.get_info_luc, "lan_cuoi_nhip_tim": th.nhip_tim_luc,
+            "adb_noi": th.adb_noi, "nguong_treo_s": PHAN_HOI_TREO_S,
+        }
+        if tuoi is not None and tuoi <= PHAN_HOI_BINH_THUONG_S:
+            tt = TrangThaiPhanHoi(True, "binh_thuong", attrs)
+        elif tuoi is not None and tuoi <= PHAN_HOI_TREO_S:
+            tt = self._truoc or TrangThaiPhanHoi(True, "binh_thuong", attrs)
+        else:
+            tcp = await self._thu_tcp()
+            attrs["tcp_8080"] = ("ket_noi" if tcp is True else
+                                 ("khong_noi" if tcp is False else "chua_thu"))
+            if tcp is True and not th.heartbeat_song:
+                tt = TrangThaiPhanHoi(False, "treo", attrs)
+            elif tcp is False:
+                tt = TrangThaiPhanHoi(False, "mat_mang", attrs)
+            else:
+                tt = self._truoc or TrangThaiPhanHoi(True, "binh_thuong", attrs)
+        if tt.ly_do == "treo":
+            if self._treo_tu is None:
+                self._treo_tu = self._mono()
+        else:
+            self._treo_tu = None
+        if self._truoc is not None and self._truoc.ly_do != tt.ly_do:
+            if tt.ly_do == "binh_thuong":
+                _LOGGER.warning("Loa R1 đã phản hồi trở lại (trước đó: %s)", self._truoc.ly_do)
+            else:
