+Một nguồn duy nhất với options flow: giá trị nằm trong tuỳ chọn (``"HH:MM"``),
+thực thể chỉ đọc/ghi qua đó. Thực thể là cài đặt phía HA nên luôn khả dụng kể
+cả khi loa mất kết nối.
+"""
+
+from __future__ import annotations
+
+import datetime
+
+from homeassistant.components.time import TimeEntity
+from homeassistant.const import EntityCategory
+from homeassistant.core import HomeAssistant
+from homeassistant.helpers.entity_platform import AddConfigEntryEntitiesCallback
+
+from .const import CONF_LICH_GIO, DEFAULT_LICH_GIO
